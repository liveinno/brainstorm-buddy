# Ignore build outputs
[Bb]in/
[Oo]bj/
[Ll]og/
*.user
*.suo
.vs/
publish/

__pycache__/
*.pyc

# Generated manual outputs (rebuild via docs/manuals/build_manuals_bb.py)
docs/manuals/*.docx
docs/manuals/*.pdf
# Test results
TestResults/
coverage/
*.coverage
report.html
report_output.txt

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log

antigravity-proxy/

# Большие ML-артефакты (модели ONNX и т.п.) — не в git
artifacts/
*.onnx
installer/
installer-inno/
installer-full/
# Скриншоты UI-тестера и пост-инсталляционного smoke — регенерируются каждым прогоном
**/shots/
tools/verify-shots/
BrainstormBuddy.UITests/report.html

# Локальные медиафайлы пользователя (личное, крупное) — не в git
videos/
*.mp4
*.webm
*.mkv

# Бандл ffmpeg для инсталлятора (крупный бинарь, качается отдельно)
packaging/inno/ffmpeg/

# Отчёты UI-тестера установки (тестовый мусор)
report_install.html
report_install_keep.html
report_uninstall.html
