<Window x:Class="BrainstormBuddy.AttachmentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BrainstormBuddy"
        Title="{DynamicResource L_Att_Title}"
        Width="640" Height="520" MinWidth="520" MinHeight="400"
        AutomationProperties.AutomationId="AttachmentPickerDialog"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="14"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <!-- Отступы/типографика — FEATURE-SPEC §4: 24 по краям, 16 между секциями,
         8 между подписью и содержимым; заголовок 20/26 SemiBold, текст 14/21,
         подписи 12/18; кнопки 36. На малом экране прокручивается середина,
         нижние кнопки всегда доступны; высота окна ограничена рабочей областью
         (MaxHeight задаётся в code-behind). -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1-2. Заголовок + подпись форматов/лимитов -->
        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="20" FontWeight="SemiBold"
                   TextBlock.LineHeight="26" TextBlock.LineStackingStrategy="BlockLineHeight"
                   Text="{DynamicResource L_Att_Title}"/>
        <TextBlock x:Name="FormatsCaption" Grid.Row="1" Margin="0,8,0,0"
                   FontSize="12" TextBlock.LineHeight="18"
                   Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>

        <!-- 3-7. Прокручиваемое содержимое -->
        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Button x:Name="ChooseBtn" Height="36" Padding="14,0" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="ChooseAttachmentFilesButton"
                        Click="OnChooseFiles">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource BuddyAttachment.Icon.Default}"
                               Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource L_Att_ChooseFiles}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Выбор режима чтения PDF (аудит §3.1): фиксируется на каждый
                     импорт; «Быстро» — только текстовый слой, «OCR» — + распознавание
                     страниц без текста. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_Att_PdfMode}"
                               Foreground="{DynamicResource TextDimBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PdfModeCombo" MinWidth="220" Height="30"
                              VerticalContentAlignment="Center"
                              AutomationProperties.AutomationId="PdfReadModeCombo"
                              SelectionChanged="OnPdfModeChanged">
                        <ComboBoxItem Tag="fast" Content="{DynamicResource L_Att_PdfModeFast}"/>
                        <ComboBoxItem Tag="full" Content="{DynamicResource L_Att_PdfModeFull}"/>
                    </ComboBox>
                    <!-- Параллельность OCR страниц (Audio.AttachmentsOcrParallelism):
                         auto — по ядрам (≤4), 1 — последовательно, 2/4 — явно. -->
                    <TextBlock x:Name="OcrParallelCaption" Margin="16,0,8,0"
                               Foreground="{DynamicResource TextDimBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="OcrParallelCombo" MinWidth="110" Height="30"
                              VerticalContentAlignment="Center"
                              AutomationProperties.AutomationId="OcrParallelismCombo"
                              SelectionChanged="OnOcrParallelChanged">
                        <ComboBoxItem Tag="auto" x:Name="OcrParAuto"/>
                        <ComboBoxItem Tag="1" Content="1"/>
                        <ComboBoxItem Tag="2" Content="2"/>
                        <ComboBoxItem Tag="4" Content="4"/>
                    </ComboBox>
                </StackPanel>

                <!-- 4. Список документов: строка ≥64, padding 12, шаг 8 -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="4" Margin="0,16,0,0"
                        MinHeight="132"
                        Background="{DynamicResource BgDarkerBrush}">
                    <Grid>
                        <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="OnFileListKeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="64" Padding="12,8" Margin="0,0,0,8"
                                            AutomationProperties.AutomationId="{Binding AutomationId}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{DynamicResource BuddyAttachment.Icon.Default}"
                                                   Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                           FontWeight="Medium" TextBlock.LineHeight="21"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding Meta}" FontSize="12"
                                                           TextBlock.LineHeight="18"
                                                           Foreground="{DynamicResource TextDimBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12"
                                                       TextBlock.LineHeight="18"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       TextWrapping="Wrap" MaxWidth="180"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Content="⏹" Tag="{Binding Key}" Click="OnStopRow"
                                                        Style="{StaticResource CompactButton}"
                                                        Width="24" Height="24" MinHeight="24" Padding="4,1"
                                                        FontSize="11" VerticalAlignment="Center"
                                                        Visibility="{Binding ShowStop, Converter={StaticResource BoolVis}}"
                                                        ToolTip="Остановить (обработанные страницы сохранятся)"
                                                        AutomationProperties.AutomationId="StopAttachmentRowButton"/>
                                                <Button Content="↻" Tag="{Binding Key}" Click="OnRetryRow"
                                                        Style="{StaticResource CompactButton}"
                                                        Width="24" Height="24" MinHeight="24" Padding="4,1"
                                                        Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                        Visibility="{Binding ShowRetry, Converter={StaticResource BoolVis}}"
                                                        ToolTip="Повторить с текущими настройками"
                                                        AutomationProperties.AutomationId="RetryAttachmentRowButton"/>
                                            </StackPanel>
                                            <Button Grid.Column="4" Content="✕" Tag="{Binding Key}"
                                                    Click="OnRemoveRow" Style="{StaticResource CompactButton}"
                                                    Width="24" Height="24" MinHeight="24" Padding="4,1"
                                                    Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                    ToolTip="{DynamicResource L_Att_RemoveTip}"
                                                    AutomationProperties.Name="{DynamicResource L_Att_RemoveTip}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyText" Text="{DynamicResource L_Att_Empty}"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Счётчик «Готово N из M» / «остальные не будут прикреплены» -->
                <TextBlock x:Name="ReadyCounter" Margin="0,8,0,0" FontSize="12"
                           TextBlock.LineHeight="18"
                           Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed"/>

                <!-- 5-6. Галочка фактов (18×18, отступ 8 — стиль CheckBox),
                     под ней пояснение и область сохранения фактов -->
                <StackPanel Margin="0,16,0,0">
                    <CheckBox x:Name="FactsCheck" IsChecked="False" MinHeight="32"
                              VerticalContentAlignment="Center"
                              AutomationProperties.AutomationId="ExtractAttachmentFactsCheckBox"
                              Content="{DynamicResource L_Att_ExtractFacts}"/>
                    <TextBlock x:Name="FactsNote" Margin="26,2,0,0" FontSize="12"
                               TextBlock.LineHeight="18" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed"/>
                    <TextBlock x:Name="FactsScopeNote" Margin="26,2,0,0" FontSize="12"
                               TextBlock.LineHeight="18" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDimBrush}"/>
                </StackPanel>

                <!-- 7. Постоянное пояснение: оригиналы локально, текст уходит выбранной модели -->
                <TextBlock x:Name="ModelNote" Margin="0,16,0,0" FontSize="12"
                           TextBlock.LineHeight="18" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextDimBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 8. Нижние кнопки: «Остановить обработку» (слева), «Закрыть» —
             закрывает окно, обработка идёт фоном — и «Прикрепить (N)», gap 8 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="StopAllBtn" HorizontalAlignment="Left" Height="36" Padding="14,0"
                    AutomationProperties.AutomationId="StopAttachmentsButton"
                    Click="OnStopAll">
                <TextBlock x:Name="StopAllBtnText" Text="{DynamicResource L_Att_StopAll}"/>
            </Button>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" IsCancel="True" Margin="0,0,8,0" Height="36"
                        Padding="14,0"
                        AutomationProperties.AutomationId="CancelAttachmentsButton"
                        Click="OnCancel">
                    <TextBlock Text="{DynamicResource L_Att_Cancel}"/>
                </Button>
                <Button x:Name="ApplyBtn" IsDefault="True" Style="{StaticResource PrimaryActionButton}"
                        AutomationProperties.AutomationId="CommitAttachmentsButton"
                        Click="OnApply">
                    <TextBlock x:Name="ApplyBtnText" Text="{DynamicResource L_Att_Apply}"/>
                </Button>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
