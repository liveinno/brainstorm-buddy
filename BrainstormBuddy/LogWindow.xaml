<Window x:Class="BrainstormBuddy.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_Log_Title}"
        Width="640" Height="320"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="13"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource L_Log_Level}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="LevelFilter" Width="100" SelectionChanged="OnLevelFilterChanged">
                <ComboBoxItem Content="{DynamicResource L_Log_FilterAll}" Tag="All" IsSelected="True"/>
                <ComboBoxItem Content="Info+" Tag="InfoPlus"/>
                <ComboBoxItem Content="Warn+" Tag="WarnPlus"/>
                <ComboBoxItem Content="{DynamicResource L_Log_FilterError}" Tag="Error"/>
            </ComboBox>
            <CheckBox x:Name="AutoScrollCheck" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M15 16L11 20L7 16H10V8H7L11 4L15 8H12V16H15ZM22 5H18V19H22V5ZM2 5H6V19H2V5Z" Fill="{DynamicResource SuccessIconBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0"/>
                    <TextBlock Text="{DynamicResource L_Log_AutoScroll}" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="PauseCheck" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M6 19H10V5H6V19ZM14 5V19H18V5H14Z" Fill="{DynamicResource SuccessIconBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0"/>
                    <TextBlock Text="{DynamicResource L_Log_Pause}" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgDarkerBrush}" Padding="12,10">
            <ListBox x:Name="LogList"
                     Background="Transparent"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="{DynamicResource MonoFont}"
                     FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="TextBlock.LineHeight" Value="18"/>
                        <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="ClearBtn" Click="OnClear" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource BuddySettings.Icon.Delete.Default}" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource L_Log_Clear}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CopyBtn" Click="OnCopy" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource BuddySettings.Icon.Copy.Default}" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource L_Log_Copy}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="OpenFolderBtn" Click="OnOpenFolder" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource L_OpenFolder}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextDimBrush}"/>
        </StackPanel>
    </Grid>
</Window>

