<Window x:Class="BrainstormBuddy.McpWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCP"
        Width="640" MinWidth="520" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="WizardTitle" Style="{DynamicResource DialogTitleText}"
                   Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel>
                <StackPanel x:Name="StepHost"/>

                <!-- Облачный шаг-заглушка: логику дописывает partial
                     McpWizardWindow.Cloud.cs (агент McpHttp). Имена
                     контролов зафиксированы контрактом — не переименовывать. -->
                <Border x:Name="CloudStepPanel" Style="{StaticResource CardBorder}"
                        Visibility="Collapsed" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="CloudStatusText" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{DynamicResource L_McpW_CloudStatusOff}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CloudInstructionsText" Style="{StaticResource MetaText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{DynamicResource L_McpW_CloudInstructions}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <Border Style="{StaticResource JsonPanel}" Margin="0,8,0,0">
                            <TextBlock x:Name="CloudUrlText" Style="{StaticResource CodeText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <Button x:Name="CloudFunnelButton" Content="{DynamicResource L_McpW_CloudEnable}"
                                Padding="12,0" Height="36" Margin="0,12,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackBtn" Content="{DynamicResource L_Wiz_Back}" Padding="12,0" Height="36"
                    Margin="0,0,8,0" Click="OnBack"/>
            <TextBlock Grid.Column="1" x:Name="WizardStatus" VerticalAlignment="Center"
                       Style="{DynamicResource MetaText}" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="8,0"/>
            <Button Grid.Column="2" x:Name="CancelBtn" Content="{DynamicResource L_Wiz_Cancel}"
                    Padding="12,0" Height="36" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Grid.Column="3" x:Name="NextBtn" Padding="12,0" Height="36" MinWidth="120"
                    Style="{StaticResource PrimaryButton}" Click="OnNext"/>
        </Grid>
    </Grid>
</Window>
