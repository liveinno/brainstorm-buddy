<Window x:Class="BrainstormBuddy.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        MinWidth="360" MinHeight="280"
        Title="BrainstormBuddy Image Viewer" Opacity="0"
        Loaded="OnLoaded" KeyDown="OnKeyDown">

    <Window.Resources>
        <!-- Иконочные кнопки панелей просмотрщика (32x32 / 36x36, в духе окна). -->
        <Style x:Key="ViewerIconBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource BgLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerTextBtn" TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource BgLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Корень — полностью непрозрачный тематический фон: AllowsTransparency оставляет
         «дыры» только за пределами скруглённых углов этого Border. -->
    <Border x:Name="Chrome" CornerRadius="10" SnapsToDevicePixels="True"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель: имя файла слева, счётчик по центру, крестик справа.
                 Перетаскивание окна — за эту полосу. -->
            <Grid Grid.Row="0" Margin="14,0,6,0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock x:Name="FileNameText" VerticalAlignment="Center"
                           FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextBrightBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,120,0"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                <TextBlock x:Name="CounterText" VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                <Button x:Name="CloseBtn" Style="{StaticResource ViewerIconBtn}"
                        Width="36" Height="36"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnCloseClick" ToolTip="Esc">
                    <ContentControl Content="{DynamicResource IconClose}" Width="14" Height="14"/>
                </Button>
            </Grid>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource BorderBrush}" Opacity="0.6"/>

            <!-- Вьюпорт (только средняя строка): зум колесом к курсору, пан левой
                 кнопкой, двойной клик — Fit. Картинка не заходит под панели. -->
            <Grid Grid.Row="1" x:Name="Viewport" ClipToBounds="True"
                  Background="{DynamicResource BgDarkerBrush}"
                  MouseLeftButtonDown="OnViewportMouseDown" MouseLeftButtonUp="OnViewportMouseUp"
                  MouseMove="OnViewportMouseMove" MouseWheel="OnViewportMouseWheel"
                  SizeChanged="OnViewportSizeChanged"
                  Cursor="SizeAll">
                <Image x:Name="Picture" Stretch="Uniform" RenderTransformOrigin="0,0"
                       Visibility="Collapsed">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScaleT" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TransT" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <!-- Плейсхолдер отсутствующего оригинала (ТЗ §4). -->
                <StackPanel x:Name="UnavailablePanel" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource L_ImgUnavailable}" FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Нижняя панель: вписать / 100% / - / % / + -->
            <Border Grid.Row="2" Background="{DynamicResource BgMediumBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="FitBtn" Style="{StaticResource ViewerTextBtn}"
                            Content="{DynamicResource L_ImgFit}" Click="OnFitClick"/>
                    <Button x:Name="OneToOneBtn" Style="{StaticResource ViewerTextBtn}"
                            Content="100%" Click="OnOneToOneClick" Margin="6,0,0,0"/>
                    <Button x:Name="ZoomOutBtn" Style="{StaticResource ViewerIconBtn}"
                            Width="32" Height="32"
                            Click="OnZoomOutClick" Margin="14,0,0,0">
                        <Path Data="{DynamicResource GeoImgMinus}" Stroke="{DynamicResource TextBrightBrush}"
                              StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Width="52"
                               TextAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}" Text="100%"/>
                    <Button x:Name="ZoomInBtn" Style="{StaticResource ViewerIconBtn}"
                            Width="32" Height="32"
                            Click="OnZoomInClick">
                        <Path Data="{DynamicResource GeoImgPlus}" Stroke="{DynamicResource TextBrightBrush}"
                              StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
