<Window x:Class="BrainstormBuddy.TranscriptExtractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_Extr_Title}" Height="560" Width="640" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Кнопка — глобальный шаблон волны 02 (r8, HoverBrush-hover, BgBrush-press,
             фокус-рамка 2px); тут только размер текста. PrimaryActionButton — глобальный. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BgMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ListBox (тёмный, свой шаблон — иначе пустой список рисуется белым) -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource L_Extr_Title}" Style="{StaticResource DialogTitleText}"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{DynamicResource L_Extr_Subtitle}"
                       Style="{StaticResource MetaText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <!-- Свои правила извлечения + чекбокс «запомнить» -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource L_Extr_RulesHeader}" Style="{StaticResource LabelText}"
                           Foreground="{DynamicResource TextDimBrush}" Margin="2,0,0,6"/>
                <Grid>
                    <TextBox x:Name="RulesBox" Style="{StaticResource MultilineInputText}" MinHeight="56" MaxHeight="110"
                             TextChanged="OnRulesTextChanged"/>
                    <!-- Подсказка-плейсхолдер: видна только при пустом поле -->
                    <TextBlock x:Name="RulesHint" IsHitTestVisible="False" Margin="16,12"
                               TextWrapping="Wrap" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextMutedBrush}"
                               Text="{DynamicResource L_Extr_RulesPlaceholder}"/>
                </Grid>
                <CheckBox x:Name="RememberRulesCheck" Content="{DynamicResource L_Extr_RememberRules}"
                          Margin="2,8,0,0"
                          ToolTip="{DynamicResource L_Tex_RememberRulesHint}"/>
                <!-- Серый hint под галкой: куда и зачем сохраняются правила (бэклог №63) -->
                <TextBlock Text="{DynamicResource L_Tex_RememberRulesHint}" Margin="2,6,0,0"
                           Style="{StaticResource MetaText}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- Результаты: список фактов с чекбоксами / прогресс / память выключена -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="FactsHeader" Text="{DynamicResource L_Extr_FactsHeader}"
                       Style="{StaticResource LabelText}" Foreground="{DynamicResource TextDimBrush}"
                       Margin="2,0,0,6" Visibility="Collapsed"/>

            <Grid Grid.Row="1">
                <ListBox x:Name="FactsList" Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0">
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- «Память выключена» — вместо запуска -->
                <StackPanel x:Name="MemoryOffPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" Margin="20,0">
                    <TextBlock Text="{DynamicResource L_Extr_MemoryOff}"
                               FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{DynamicResource WarnBrush}"/>
                    <TextBlock Text="{DynamicResource L_Extr_MemoryOffHint}"
                               Style="{StaticResource MetaText}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Индикатор «думаю…» -->
                <StackPanel x:Name="BusyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="140" Height="6"/>
                    <TextBlock x:Name="BusyText" Text="{DynamicResource L_Extr_Busy}"
                               Style="{StaticResource MetaText}" Margin="0,8,0,0" TextAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Статус + кнопки -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveFactsBtn" Content="{DynamicResource L_Extr_SaveBtn}" Style="{StaticResource PrimaryActionButton}"
                        Click="OnSaveFacts" Visibility="Collapsed"/>
                <Button x:Name="ExtractBtn" Content="{DynamicResource L_Extr_ExtractBtn}" Style="{StaticResource PrimaryActionButton}"
                        Click="OnExtract" IsDefault="True" Margin="8,0,0,0"/>
                <Button x:Name="CancelBtn" Content="{DynamicResource L_Extr_CancelBtn}" Click="OnCancel" IsCancel="True" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="2,0,10,0"
                       Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>