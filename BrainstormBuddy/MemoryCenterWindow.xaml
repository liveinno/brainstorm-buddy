<Window x:Class="BrainstormBuddy.MemoryCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:BrainstormBuddy"
        xmlns:conv="clr-namespace:BrainstormBuddy"
        xmlns:ctrl="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="{DynamicResource L_MC_Title}"
        Icon="pack://application:,,,/Resources/Icons/app.ico"
        Width="1040" Height="640" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <mc:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
        <mc:MemoryTypeBrushConverter x:Key="TypeBrush"/>
        <mc:MemoryJobStatusBrushConverter x:Key="JobStatusBrush"/>

        <!-- Волна 05: адаптивные конвертеры центра памяти (MemoryCenterConverters.cs).
             ActionsOrient — действия факта под текстом при FactsList.ActualWidth < 900
             (используется и как детектор порога в DataTrigger). ProjectsColWidth —
             левая колонка проектов 280/240 по ширине содержимого (порог 1000). -->
        <conv:WidthToOrientationConverter x:Key="ActionsOrient" Threshold="900"/>
        <conv:WidthToGridLengthConverter x:Key="ProjectsColWidth" Threshold="1000"
                                         WideValue="280" NarrowValue="240"/>

        <!-- TabItem: горизонтальные вкладки сверху, выбранная — акцентная линия 2px снизу.
             Волна 05: Inter 14/20, Padding 16,10. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextBlock.LineHeight" Value="20"/>
            <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <Border x:Name="HitArea" Background="Transparent" Margin="-16,-10">
                                <ContentPresenter ContentSource="Header"
                                                  Margin="16,10"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox: тёмный шаблон — дефолтный рисует белую область. -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Волна 05: ритм строк списков — Padding 12. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <!-- Волна 08: левая полоса AccentBrush 3px у выбранной строки. -->
                            <Border x:Name="SelBar" Width="3" HorizontalAlignment="Left"
                                    Margin="3,6,0,7" CornerRadius="1.5"
                                    Background="{DynamicResource AccentBrush}"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMediumBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                                <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Компактная кнопка действия в строке списка — глобальный шаблон
             волны 02 через CompactButton (MinHeight 30, padding 10,5, r8, общий hover). -->
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Background" Value="{DynamicResource BgMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <!-- Pin/unpin: арт BuddyExtra.Icon.Pin — Default откреплён, Pressed — закреплён
             (IsChecked-триггер в шаблоне; состояние pinned = pressed-арт, волна 07). -->
        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{DynamicResource L_MC_TT_Pin}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Image x:Name="Glyph" Source="{DynamicResource BuddyExtra.Icon.Pin.Default}"
                                   Width="14" Height="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Source"
                                        Value="{DynamicResource BuddyExtra.Icon.Pin.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Чип типа факта: цветная плашка 11/16, Padding 6,2 (волна 05). -->
        <Style x:Key="TypeChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="{Binding Item.Type, Converter={StaticResource TypeBrush}, ConverterParameter=bg}"/>
            <Setter Property="BorderBrush" Value="{Binding Item.Type, Converter={StaticResource TypeBrush}}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DimLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Expander списка встреч (волна 05, B22): локальный шаблон без белого
             системного круга. Шеврон BuddySettings.Icon.ChevronDown.Default 12x12,
             область клика ≥28x28; при IsExpanded рисунок поворачивается на 180°.
             Заголовок — весь ToggleButton (клик по подписи сохранён). -->
        <Style x:Key="MeetingExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                          Foreground="{TemplateBinding Foreground}"
                                          AutomationProperties.Name="{DynamicResource L_MC_ExpandSummary}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="28" MinHeight="28"
                                                    Background="Transparent" VerticalAlignment="Top">
                                                <Image x:Name="Chevron" Width="12" Height="12"
                                                       Source="{DynamicResource BuddySettings.Icon.ChevronDown.Default}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Border>
                                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Margin="28,4,0,0"
                                              Visibility="Collapsed" Focusable="False"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Внешний отступ содержимого 20 — на корневом контейнере (у Window нет Padding). -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок 24/30, пояснение 14/21 через 6, путь к memory.db —
             служебный 12/18 под пояснением через 4 (переносится при нехватке ширины). -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource L_MC_Title}" Style="{StaticResource PageTitleText}"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{DynamicResource L_MC_Subtitle}" Style="{StaticResource BodyText}"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
            <TextBlock x:Name="DbPathText" Style="{StaticResource DimLabel}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                    SelectionChanged="OnTabChanged">

            <!-- ===================== ФАКТЫ ===================== -->
            <TabItem Header="{DynamicResource L_MC_Tab_Facts}" x:Name="FactsTab">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Панель в две строки (волна 05, B20): поиск + «Создать факт»;
                         ниже одна переносимая строка действий и фильтров. -->
                    <StackPanel Grid.Row="0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SearchFactsLabel" Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource LabelText}"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       Text="{DynamicResource L_MC_SearchFactsLabel}"/>
                            <TextBox x:Name="SearchBox" Grid.Row="1" Grid.Column="0" Margin="0,6,0,0"
                                     MinWidth="240" Style="{StaticResource InputText}"
                                     TextChanged="OnFactFilterChanged"
                                     AutomationProperties.LabeledBy="{Binding ElementName=SearchFactsLabel}">
                                <TextBox.ToolTip>
                                    <ToolTip Content="{DynamicResource L_MC_Search}"/>
                                </TextBox.ToolTip>
                            </TextBox>
                            <Button Grid.Row="1" Grid.Column="1" Margin="12,6,0,0" VerticalAlignment="Center"
                                    Content="{DynamicResource L_MC_NewFact}" Click="OnFactNew"/>
                        </Grid>

                        <!-- Строка действий/фильтров: одна WrapPanel; между группами 16,
                             внутри групп 8, межстрочный зазор 8 (нижние отступы детей).
                             При ActualWidth < 600 code-behind растягивает каждую
                             колонку фильтра на всю ширину (своя строка). -->
                        <WrapPanel x:Name="FiltersPanel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource MiniButton}" Margin="0"
                                        Content="{DynamicResource L_Hist_SelectAll}" Click="OnFactSelectAll"
                                        ToolTip="{DynamicResource L_Mem_SelectAllTip}"/>
                                <Button x:Name="FactDeleteSelectedBtn" Style="{StaticResource MiniButton}"
                                        Margin="8,0,0,0" IsEnabled="False"
                                        Content="{DynamicResource L_Hist_DeleteSelected}" Click="OnFactDeleteSelected"/>
                            </StackPanel>
                            <StackPanel x:Name="ScopeFilterCol" Margin="0,0,16,8">
                                <TextBlock Style="{StaticResource LabelText}"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           Text="{DynamicResource L_MC_Filter_Scope}"/>
                                <ComboBox x:Name="ScopeFilter" Margin="0,6,0,0"
                                          SelectionChanged="OnFactFilterChanged"
                                          ToolTip="{Binding Path=SelectedItem.Content, RelativeSource={RelativeSource Self}}">
                                    <ComboBoxItem Content="{DynamicResource L_MC_Filter_All}" Tag="" IsSelected="True"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Scope_Global}" Tag="Global"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Scope_Project}" Tag="Project"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Scope_Person}" Tag="Person"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Scope_Meeting}" Tag="Meeting"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="TypeFilterCol" Margin="0,0,16,8">
                                <TextBlock Style="{StaticResource LabelText}"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           Text="{DynamicResource L_MC_Filter_Type}"/>
                                <ComboBox x:Name="TypeFilter" Margin="0,6,0,0"
                                          SelectionChanged="OnFactFilterChanged"
                                          ToolTip="{Binding Path=SelectedItem.Content, RelativeSource={RelativeSource Self}}">
                                    <ComboBoxItem Content="{DynamicResource L_MC_Filter_All}" Tag="" IsSelected="True"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_Decision}" Tag="Decision"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_ActionItem}" Tag="ActionItem"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_Fact}" Tag="Fact"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_Preference}" Tag="Preference"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_Constraint}" Tag="Constraint"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_Deadline}" Tag="Deadline"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_OpenQuestion}" Tag="OpenQuestion"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_Risk}" Tag="Risk"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_Idea}" Tag="Idea"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_Correction}" Tag="Correction"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_PersonFact}" Tag="PersonFact"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Type_ProjectFact}" Tag="ProjectFact"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="StatusFilterCol" Margin="0,0,16,8">
                                <TextBlock Style="{StaticResource LabelText}"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           Text="{DynamicResource L_MC_Filter_Status}"/>
                                <ComboBox x:Name="StatusFilter" Margin="0,6,0,0"
                                          SelectionChanged="OnFactFilterChanged"
                                          ToolTip="{Binding Path=SelectedItem.Content, RelativeSource={RelativeSource Self}}">
                                    <ComboBoxItem Content="{DynamicResource L_MC_Status_Active}" Tag="Active" IsSelected="True"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Status_Pending}" Tag="Pending"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Status_Superseded}" Tag="Superseded"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Status_Invalidated}" Tag="Invalidated"/>
                                    <ComboBoxItem Content="{DynamicResource L_MC_Filter_All}" Tag=""/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource MiniButton}" Margin="0"
                                        Content="{DynamicResource L_MX_Export}" Click="OnExport"/>
                                <Button Style="{StaticResource MiniButton}" Margin="8,0,0,0"
                                        Content="{DynamicResource L_MX_Import}" Click="OnImport"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Список фактов -->
                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <ListBox x:Name="FactsList" BorderThickness="0" SelectionMode="Extended"
                                     SelectionChanged="OnFactsSelectionChanged" KeyDown="OnFactsListKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ContextMenuOpening="OnFactMenuOpening">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="124"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Левая колонка метаданных 124: pin + тип + скоуп -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ToggleButton Style="{StaticResource PinToggle}"
                                                                  IsChecked="{Binding Item.Pinned, Mode=OneWay}"
                                                                  Click="OnPinToggle" VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource TypeChip}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeName}" Style="{StaticResource BadgeText}"
                                                                   Foreground="{Binding Item.Type, Converter={StaticResource TypeBrush}, ConverterParameter=fg}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ScopeBadge}" Style="{StaticResource DimLabel}"
                                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Правая часть: текст + действия.
                                                 ≥900 — действия справа (Auto-колонка по содержимому),
                                                 <900 — под текстом второй строкой через 8
                                                 (переключение DataTrigger по conv:WidthToOrientation). -->
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Text="{Binding Item.Content}" TextWrapping="Wrap"
                                                               FontSize="14" LineHeight="21" LineStackingStrategy="BlockLineHeight"
                                                               Foreground="{DynamicResource TextBrightBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Item.Status}" Value="Superseded">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter Property="Opacity" Value="0.55"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Item.Status}" Value="Invalidated">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter Property="Opacity" Value="0.45"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Редактор: ширина текстовой колонки, Inter 14,
                                                         MultilineInputText (Padding 12,10 из стиля),
                                                         MinHeight 80, Height Auto. -->
                                                    <TextBox Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource MultilineInputText}"
                                                             FontSize="14" MinHeight="80"
                                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">
                                                        <Button Style="{StaticResource MiniButton}" Margin="0,0,8,0"
                                                                Content="{DynamicResource L_MC_Btn_Save}" Click="OnFactSave"/>
                                                        <Button Style="{StaticResource MiniButton}" Margin="0"
                                                                Content="{DynamicResource L_MC_Btn_Cancel}" Click="OnFactCancelEdit"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource DimLabel}" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding Tags}" Style="{StaticResource DimLabel}"
                                                               Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasTags, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>

                                                <!-- Действия «⋯»/«Изменить»/«История»/«Удалить»: зазор 6,
                                                     перенос целиком с межстрочным 8; скрыты в режиме
                                                     редактирования (IsEditing — существующий контракт). -->
                                                <WrapPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolVis}}">
                                                    <WrapPanel.Style>
                                                        <Style TargetType="WrapPanel">
                                                            <Setter Property="Orientation" Value="Horizontal"/>
                                                            <Setter Property="Grid.Row" Value="0"/>
                                                            <Setter Property="Grid.Column" Value="1"/>
                                                            <Setter Property="Margin" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="{x:Static ctrl:Orientation.Vertical}">
                                                                    <DataTrigger.Binding>
                                                                        <Binding Path="ActualWidth"
                                                                                 RelativeSource="{RelativeSource AncestorType=ListBox}"
                                                                                 Converter="{StaticResource ActionsOrient}"/>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Grid.Row" Value="1"/>
                                                                    <Setter Property="Grid.Column" Value="0"/>
                                                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                                    <Setter Property="Margin" Value="0,8,0,-8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </WrapPanel.Style>
                                                    <Button Style="{StaticResource MiniButton}" Margin="0,0,6,8"
                                                            Click="OnFactActions">
                                                        <Image Source="{DynamicResource BuddyExtra.Icon.MoreHorizontal.Default}"
                                                               Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MiniButton}" Margin="0,0,6,8"
                                                            Content="{DynamicResource L_MC_Btn_Edit}" Click="OnFactEdit"/>
                                                    <Button Style="{StaticResource MiniButton}" Margin="0,0,6,8"
                                                            Content="{DynamicResource L_MC_Btn_History}" Click="OnFactHistory"/>
                                                    <Button Style="{StaticResource MiniButton}" Margin="0,0,6,8"
                                                            Content="{DynamicResource L_MC_Btn_Delete}" Click="OnFactDelete"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="FactsEmpty" Text="{DynamicResource L_MC_Empty}"
                                       Style="{StaticResource BodyText}" Foreground="{DynamicResource TextDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Панель истории версий -->
                    <Border Grid.Row="2" x:Name="HistoryPanel" Visibility="Collapsed" Margin="0,8,0,0"
                            Background="{DynamicResource BgMediumBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10" MaxHeight="220">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}"
                                        Content="{DynamicResource L_MC_Close}" Click="OnHistoryClose"/>
                                <TextBlock x:Name="HistoryTitle" FontWeight="SemiBold" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource TextBrightBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ListBox Grid.Row="1" x:Name="HistoryList" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Item.Content}" TextWrapping="Wrap"
                                                       FontSize="14" LineHeight="21" LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{DynamicResource TextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Item.Status}" Value="Superseded">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource DimLabel}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== ВСТРЕЧИ ===================== -->
            <TabItem Header="{DynamicResource L_MC_Tab_Meetings}" x:Name="MeetingsTab">
                <Border Margin="0,16,0,0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <ListBox x:Name="MeetingsList" BorderThickness="0" MouseDoubleClick="OnMeetingOpen">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Meeting.Title}" FontSize="14" FontWeight="Medium"
                                                   LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{DynamicResource TextBrightBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource DimLabel}" Margin="0,4,0,0"/>
                                        <Expander Header="{DynamicResource L_MC_Summary}" Margin="0,8,0,0"
                                                  Style="{StaticResource MeetingExpander}"
                                                  Foreground="{DynamicResource TextMutedBrush}"
                                                  AutomationProperties.Name="{DynamicResource L_MC_ExpandSummary}"
                                                  Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Meeting.Summary}" TextWrapping="Wrap"
                                                       Style="{StaticResource BodyText}"
                                                       Foreground="{DynamicResource TextBrush}" MaxWidth="860"/>
                                        </Expander>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="MeetingsEmpty" Text="{DynamicResource L_MC_Empty}"
                                   Style="{StaticResource BodyText}" Foreground="{DynamicResource TextDimBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ===================== ПРОЕКТЫ ===================== -->
            <TabItem Header="{DynamicResource L_MC_Tab_Projects}" x:Name="ProjectsTab">
                <!-- Левая колонка 280/240 по ширине содержимого (порог 1000, волна 05). -->
                <Grid x:Name="ProjectsContent" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ActualWidth, ElementName=ProjectsContent,
                                                Converter={StaticResource ProjectsColWidth}}"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                                <Button Style="{StaticResource MiniButton}" Margin="0" Content="{DynamicResource L_MC_New}" Click="OnProjectNew"/>
                                <CheckBox x:Name="ShowArchivedCheck" Content="{DynamicResource L_MC_ShowArchived}"
                                          Margin="12,0,0,0" VerticalAlignment="Center" Checked="OnProjectFilter" Unchecked="OnProjectFilter"/>
                            </StackPanel>
                            <ListBox x:Name="ProjectsList" BorderThickness="0" SelectionChanged="OnProjectSelect">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Project.Name}" FontSize="14" FontWeight="Medium"
                                                           LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                           Foreground="{DynamicResource TextBrightBrush}" TextTrimming="CharacterEllipsis"/>
                                                <Border CornerRadius="5" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentDimBrush}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{DynamicResource L_MC_ActiveBadge}" Style="{StaticResource BadgeText}"
                                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                                </Border>
                                                <Border CornerRadius="5" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource BgLightBrush}"
                                                        Visibility="{Binding Project.Archived, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{DynamicResource L_MC_ArchivedBadge}" Style="{StaticResource BadgeText}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Project.Description}" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextDimBrush}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Правая панель: редактор ИЛИ пустое состояние (переключает
                         code-behind UpdateProjectPanelState: «Новый» показывает редактор
                         и при SelectedItem=null; в базу ничего не пишет до «Сохранить»). -->
                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16">
                        <Grid>
                            <StackPanel x:Name="ProjectEditor" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource L_MC_Field_Name}" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextDimBrush}"/>
                                <TextBox x:Name="ProjectNameBox" Margin="0,6,0,20" Style="{StaticResource InputText}"/>
                                <TextBlock Text="{DynamicResource L_MC_Field_Desc}" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextDimBrush}"/>
                                <TextBox x:Name="ProjectDescBox" Margin="0,6,0,0" Style="{StaticResource MultilineInputText}"
                                         MinHeight="112"/>
                                <WrapPanel Margin="0,8,0,-8">
                                    <Button Style="{StaticResource MiniButton}" Margin="0,0,8,8"
                                            Content="{DynamicResource L_MC_Btn_Save}" Click="OnProjectSave"/>
                                    <Button x:Name="ProjectActiveBtn" Style="{StaticResource MiniButton}" Margin="0,0,8,8"
                                            Content="{DynamicResource L_MC_SetActive}" Click="OnProjectSetActive"/>
                                    <Button x:Name="ProjectArchiveBtn" Style="{StaticResource MiniButton}" Margin="0,0,8,8"
                                            Content="{DynamicResource L_MC_Archive}" Click="OnProjectArchive"/>
                                    <Button x:Name="ProjectDeleteBtn" Style="{StaticResource MiniButton}" Margin="0,0,8,8"
                                            Content="{DynamicResource L_MC_Btn_Delete}" Click="OnProjectDelete"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel x:Name="ProjectEmptyPanel" Visibility="Collapsed"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_MC_SelectProjectTitle}"
                                           Style="{StaticResource SectionTitleText}"
                                           Foreground="{DynamicResource TextBrightBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource L_MC_SelectProjectHint}"
                                           Style="{StaticResource BodyText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== ЛЮДИ ===================== -->
            <TabItem Header="{DynamicResource L_MC_Tab_People}" x:Name="PeopleTab">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                                <Button Style="{StaticResource MiniButton}" Margin="0" Content="{DynamicResource L_MC_New}" Click="OnPersonNew"/>
                            </StackPanel>
                            <ListBox x:Name="PeopleList" BorderThickness="0" SelectionChanged="OnPersonSelect">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{DynamicResource TextBrightBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextDimBrush}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L_MC_Field_Name}" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBox x:Name="PersonNameBox" Margin="0,6,0,20" Style="{StaticResource InputText}"/>
                            <TextBlock Text="{DynamicResource L_MC_Field_Notes}" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBox x:Name="PersonNotesBox" Margin="0,6,0,0" Style="{StaticResource MultilineInputText}"
                                     MinHeight="80"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource MiniButton}" Margin="0,0,8,0"
                                        Content="{DynamicResource L_MC_Btn_Save}" Click="OnPersonSave"/>
                                <Button x:Name="PersonDeleteBtn" Style="{StaticResource MiniButton}" Margin="0"
                                        Content="{DynamicResource L_MC_Btn_Delete}" Click="OnPersonDelete"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== ЗАДАЧИ (фоновые джобы) ===================== -->
            <TabItem Header="{DynamicResource L_MC_Tab_Jobs}" x:Name="JobsTab">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Style="{StaticResource MiniButton}" Margin="0,0,8,0"
                                    Content="{DynamicResource L_MC_Job_ClearFailed}" Click="OnJobsClearFailed"/>
                            <Button Style="{StaticResource MiniButton}" Margin="0"
                                    Content="{DynamicResource L_MC_Job_Refresh}" Click="OnJobsRefresh"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <ListBox x:Name="JobsList" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Width="150">
                                                <Border CornerRadius="5" Padding="7,2"
                                                        Background="{Binding Status, Converter={StaticResource JobStatusBrush}, ConverterParameter=bg}"
                                                        BorderBrush="{Binding Status, Converter={StaticResource JobStatusBrush}}"
                                                        BorderThickness="1" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}"
                                                               Foreground="{Binding Status, Converter={StaticResource JobStatusBrush}, ConverterParameter=fg}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Kind}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding MetaText}" Style="{StaticResource DimLabel}"/>
                                                <TextBlock Text="{Binding Error}" Style="{StaticResource DimLabel}"
                                                           Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource MiniButton}"
                                                    Content="{DynamicResource L_MC_Job_Retry}" Click="OnJobRetry"
                                                    IsEnabled="{Binding CanRetry}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="JobsEmpty" Text="{DynamicResource L_MC_Empty}"
                                       Style="{StaticResource BodyText}" Foreground="{DynamicResource TextDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Статус-бар -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="StatusBar" Style="{StaticResource DimLabel}"/>
        </DockPanel>
    </Grid>
</Window>
