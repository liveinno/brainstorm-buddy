<Window x:Class="BrainstormBuddy.MeetingHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BrainstormBuddy"
        Title="{DynamicResource L_Meet_Title}" Height="700" Width="1020" MinHeight="520" MinWidth="820"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Адаптивные пороги волны 04 (конвертеры переиспользованы из
             FileTranscriptionWindow.xaml.cs): FtThreshold — ActualWidth ≥ param
             (580 — перенос панелей кнопок под заголовок); FtHistoryWidth —
             колонка истории 256/224 по ширине окна (порог 1000, param=40). -->
        <local:FtWidthThresholdConverter x:Key="FtThreshold"/>
        <local:FtHistoryColumnWidthConverter x:Key="FtHistoryWidth"/>

        <!-- Кнопка — глобальный шаблон волны 02 (r8, HoverBrush-hover, BgBrush-press,
             фокус-рамка 2px); тут только размер текста. PrimaryButton — глобальный. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BgMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ListBox (тёмный, свой шаблон — иначе ПУСТОЙ список рисуется белым дефолтным шаблоном) -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem (hover/selected как в Settings/FileTranscription).
             Элемент истории (волна 04): Padding 12,10; текст 14/20, мета 12/18, зазор 4 —
             в ItemTemplate ниже. Полное имя — в Tooltip и доступном имени. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding ListTitle}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ListTitle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <!-- Волна 08: левая полоса AccentBrush 3px у выбранной строки. -->
                            <Border x:Name="SelBar" Width="3" HorizontalAlignment="Left"
                                    Margin="3,6,0,6" CornerRadius="1.5"
                                    Background="{DynamicResource AccentBrush}"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMediumBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                                <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Ширина колонки истории 256/224 по клиентской ширине окна
                 (ActualWidth + Margin 20+20 ≥ 1000, волна 04). -->
            <ColumnDefinition Width="{Binding ActualWidth, ElementName=RootGrid,
                                    Converter={StaticResource FtHistoryWidth}, ConverterParameter=40}"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Сайдбар: список встреч ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource L_Meet_SidebarHeader}" Style="{StaticResource LabelText}"
                       Foreground="{DynamicResource TextDimBrush}" Margin="2,0,0,8"/>
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="4">
                <ListBox x:Name="MeetingList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnMeetingSelect">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding ListTitle}" FontSize="14" FontWeight="Medium"
                                           LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Margin="0,4,0,0"
                                           Text="{Binding ListSubtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource L_Meet_DeleteMenu}" Click="OnDeleteMeeting"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>
        </Grid>

        <!-- ===== ГЛАВНАЯ ЗОНА ===== -->
        <Grid x:Name="WorkArea" Grid.Column="2" SizeChanged="OnWorkAreaSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок + удаление -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" x:Name="DeleteBtn" Content="{DynamicResource L_Meet_DeleteBtn}"
                        Click="OnDeleteMeeting" IsEnabled="False" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L_Meet_Title}" Style="{StaticResource PageTitleText}"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource L_Meet_Subtitle}" Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Статус/прогресс (саммари) -->
            <StackPanel Grid.Row="1" x:Name="ProgressPanel" Margin="0,0,0,12" Visibility="Collapsed">
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="8"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="2,6,0,0" Text=""/>
            </StackPanel>

            <!-- Документы: транскрипт над саммари, между ними сплиттер.
                 Волна 04: текстовые области min 140 не влезают в минимум окна (520) —
                 поэтому общая прокрутка правой области; DocGrid держит конечную высоту
                 (Height=ViewportHeight с MinHeight), чтобы *-строки и GridSplitter работали. -->
            <ScrollViewer x:Name="DocScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid x:Name="DocGrid" MinHeight="382" Height="{Binding ViewportHeight, ElementName=DocScroll}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="184" x:Name="TranscriptRow"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*" MinHeight="186" x:Name="SummaryRow"/>
                    </Grid.RowDefinitions>

                    <!-- Транскрипт -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Шапка: заголовок слева, кнопки справа в той же строке.
                             При ширине правой области <580 кнопки переходят под заголовок
                             (вторая строка, зазор 8) — переключение стилем по ActualWidth,
                             как у FileTranscriptionWindow (пороги 760/680). -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource L_Meet_TranscriptHeader}"
                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                                        <Style.Triggers>
                                            <DataTrigger Value="False">
                                                <DataTrigger.Binding>
                                                    <Binding Path="ActualWidth" ElementName="WorkArea"
                                                             Converter="{StaticResource FtThreshold}" ConverterParameter="580"/>
                                                </DataTrigger.Binding>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel>
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Setter Property="Margin" Value="0,0,0,-8"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="False">
                                                <DataTrigger.Binding>
                                                    <Binding Path="ActualWidth" ElementName="WorkArea"
                                                             Converter="{StaticResource FtThreshold}" ConverterParameter="580"/>
                                                </DataTrigger.Binding>
                                                <Setter Property="Grid.Row" Value="1"/>
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                <Setter Property="Margin" Value="0,8,0,-8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <Button Margin="0,0,8,8" Click="OnCopyTranscript">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddySettings.Icon.Copy.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_Meet_CopyAllBtn}"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,8" Click="OnDownloadTranscript">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_Meet_DownloadBtn}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExtractBtn" Margin="0,0,0,8"
                                        ToolTip="{DynamicResource L_Meet_ExtractToMemoryToolTip}"
                                        Click="OnExtractToMemory" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddyExtra.Icon.Brain.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_Meet_ExtractToMemory}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                        <TextBox x:Name="TranscriptBox" Grid.Row="1" Margin="0,8,0,0" MinHeight="140"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" IsInactiveSelectionHighlightEnabled="True"
                                 Background="{DynamicResource BgDarkerBrush}" Foreground="{DynamicResource TextBrush}"
                                 FontSize="15" Padding="{StaticResource TranscriptBoxPadding}"
                                 Text="{DynamicResource L_Meet_Empty}">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource L_Meet_SelectAllMenu}" Command="SelectAll"/>
                                    <MenuItem Header="{DynamicResource L_Meet_CopyMenu}" Command="Copy"/>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Margin="0,4" Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext"/>

                    <!-- Саммари -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource L_Meet_SummaryHeader}"
                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                                        <Style.Triggers>
                                            <DataTrigger Value="False">
                                                <DataTrigger.Binding>
                                                    <Binding Path="ActualWidth" ElementName="WorkArea"
                                                             Converter="{StaticResource FtThreshold}" ConverterParameter="580"/>
                                                </DataTrigger.Binding>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel>
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Setter Property="Margin" Value="0,0,0,-8"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="False">
                                                <DataTrigger.Binding>
                                                    <Binding Path="ActualWidth" ElementName="WorkArea"
                                                             Converter="{StaticResource FtThreshold}" ConverterParameter="580"/>
                                                </DataTrigger.Binding>
                                                <Setter Property="Grid.Row" Value="1"/>
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                <Setter Property="Margin" Value="0,8,0,-8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <Button x:Name="SummaryBtn" Content="{DynamicResource L_Meet_SummaryBtn}" Style="{StaticResource PrimaryButton}"
                                        Click="OnGenerateSummary" IsEnabled="False" Margin="0,0,8,8"/>
                                <Button Click="OnCopySummary" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddySettings.Icon.Copy.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_Meet_CopyAllBtn}"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnDownloadSummary" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_Meet_DownloadBtn}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                        <TextBox x:Name="SummaryBox" Grid.Row="1" Margin="0,8,0,0" MinHeight="140"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" IsInactiveSelectionHighlightEnabled="True"
                                 Background="{DynamicResource BgDarkerBrush}" Foreground="{DynamicResource TextBrush}"
                                 FontSize="15" Padding="{StaticResource TranscriptBoxPadding}">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource L_Meet_SelectAllMenu}" Command="SelectAll"/>
                                    <MenuItem Header="{DynamicResource L_Meet_CopyMenu}" Command="Copy"/>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Пустое состояние: встреча не выбрана (волна 04).
                 Путь хранения — отдельной строкой 12/18 под описанием, не в центре. -->
            <Grid x:Name="EmptyPanel" Grid.Row="2" Background="{DynamicResource BgBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="{DynamicResource L_Hist_SelectMeeting}" Style="{StaticResource SectionTitleText}"
                               Foreground="{DynamicResource TextBrightBrush}"/>
                    <TextBlock Text="{DynamicResource L_Hist_SelectMeetingDesc}" Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StoragePath" Style="{StaticResource MetaText}"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
