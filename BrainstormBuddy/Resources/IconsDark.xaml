<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Иконки ТЁМНОЙ темы. Основной набор — BuddyV2 (предокрашенные DrawingImage из
         Resources/BuddyV2Icons.xaml, мержится на уровне приложения): Icon*-ключ — это
         Viewbox x:Shared="False" с <Image Source="{DynamicResource BuddyV2.Icon.*.Default}"/>.
         DynamicResource обязателен: StaticResource внутри мержёного словаря не видит
         ресурсы уровня App. Ключи без BuddyV2-аналога (ExportDone, спидометры, Home/Info/
         Help/Calendar, Stop, ChevronRight) — старая Canvas-геометрия ниже, без изменений. -->

    <!-- Логотип: BuddyV2 Waveform (3 бара голосовой волны) -->
    <Viewbox x:Key="IconAppLogo" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Waveform.Default}"/>
    </Viewbox>

    <!-- Шеврон вниз (селектор промпта) -->
    <Viewbox x:Key="IconChevronDown" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.ChevronDown.Default}"/>
    </Viewbox>

    <!-- Робот (LLM включён; выкл-вариант — IconLlmOff, переключает RefreshLlmOffButton) -->
    <Viewbox x:Key="IconLlm" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Llm.Default}"/>
    </Viewbox>

    <!-- Пауза аудио -->
    <Viewbox x:Key="IconPause" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Pause.Default}"/>
    </Viewbox>

    <!-- Продолжить (пауза активна) -->
    <Viewbox x:Key="IconPlay" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Play.Default}"/>
    </Viewbox>

    <!-- Автоскролл -->
    <Viewbox x:Key="IconAutoScroll" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.AutoScroll.Default}"/>
    </Viewbox>

    <!-- Настройки -->
    <Viewbox x:Key="IconSettings" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Settings.Default}"/>
    </Viewbox>

    <!-- Свернуть окно -->
    <Viewbox x:Key="IconMinimize" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Minimize.Default}"/>
    </Viewbox>

    <!-- Развернуть окно -->
    <Viewbox x:Key="IconMaximize" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Maximize.Default}"/>
    </Viewbox>

    <!-- Восстановить окно (задел; BuddyV2 Restore) -->
    <Viewbox x:Key="IconRestore" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Restore.Default}"/>
    </Viewbox>

    <!-- Закрыть/скрыть -->
    <Viewbox x:Key="IconClose" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Close.Default}"/>
    </Viewbox>

    <!-- Молния (отправить) -->
    <Viewbox x:Key="IconSendNow" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.SendNow.Default}"/>
    </Viewbox>

    <!-- Экспорт -->
    <Viewbox x:Key="IconExport" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Export.Default}"/>
    </Viewbox>

    <!-- Экспорт выполнен: галочка #7fe0ae (нет BuddyV2-аналога — старая геометрия) -->
    <Viewbox x:Key="IconExportDone" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="M5 12.5l4.5 4.5L19 7.5" Stroke="{DynamicResource SuccessIconBrush}" StrokeThickness="2.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Canvas>
    </Viewbox>

    <!-- AI-протокол -->
    <Viewbox x:Key="IconAiProtocol" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.AiProtocol.Default}"/>
    </Viewbox>

    <!-- Камера -->
    <Viewbox x:Key="IconScreenshot" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Screenshot.Default}"/>
    </Viewbox>

    <!-- Медленнее: спидометр 6.5, стрелка влево-вниз, центр r1.4 (нет BuddyV2-аналога) -->
    <Viewbox x:Key="IconSlowSpeech" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="M5.5 15.5a6.5 6.5 0 0 1 13 0" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round"/>
            <Path Data="M12 15.5l-3.4-2.9" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round"/>
            <Ellipse Canvas.Left="10.6" Canvas.Top="14.1" Width="2.8" Height="2.8" Fill="{DynamicResource IconBrush}"/>
        </Canvas>
    </Viewbox>

    <!-- Сброс темпа: спидометр, стрелка вверх, метка сверху (нет BuddyV2-аналога) -->
    <Viewbox x:Key="IconResetSpeed" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="M5.5 15.5a6.5 6.5 0 0 1 13 0" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round"/>
            <Path Data="M12 15.5v-4.4" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round"/>
            <Ellipse Canvas.Left="10.6" Canvas.Top="14.1" Width="2.8" Height="2.8" Fill="{DynamicResource IconBrush}"/>
            <Path Data="M10.2 5.6L12 4l1.8 1.6" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.1"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Canvas>
    </Viewbox>

    <!-- Быстрее: спидометр, стрелка вправо-вниз (нет BuddyV2-аналога) -->
    <Viewbox x:Key="IconFastSpeech" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="M5.5 15.5a6.5 6.5 0 0 1 13 0" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round"/>
            <Path Data="M12 15.5l3.4-2.9" Stroke="{DynamicResource IconBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round"/>
            <Ellipse Canvas.Left="10.6" Canvas.Top="14.1" Width="2.8" Height="2.8" Fill="{DynamicResource IconBrush}"/>
        </Canvas>
    </Viewbox>

    <!-- Глаз «призрак» (сквозной режим) -->
    <Viewbox x:Key="IconCloak" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Cloak.Default}"/>
    </Viewbox>

    <!-- Корзина (очистка) -->
    <Viewbox x:Key="IconErase" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Erase.Default}"/>
    </Viewbox>

    <!-- Микрофон вкл (нижняя пилюля; выкл-вариант IconMicOff переключает RefreshMicMuteButton) -->
    <Viewbox x:Key="IconMic" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Mic.Default}"/>
    </Viewbox>

    <!-- Микрофон выкл (перечёркнутый) -->
    <Viewbox x:Key="IconMicOff" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.MicOff.Default}"/>
    </Viewbox>

    <!-- «LLM выкл» (чистый транскрибатор): перечёркнутый робот; ставится RefreshLlmOffButton
         вместе с золотым IconBrush. -->
    <Viewbox x:Key="IconLlmOff" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.LlmOff.Default}"/>
    </Viewbox>

    <!-- Динамик вкл (нижняя пилюля; выкл-вариант IconSpeakerOff переключает RefreshSpeakerMuteButton) -->
    <Viewbox x:Key="IconSpeaker" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Speaker.Default}"/>
    </Viewbox>

    <!-- «Динамик выкл»: перечёркнутый динамик -->
    <Viewbox x:Key="IconSpeakerOff" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.SpeakerOff.Default}"/>
    </Viewbox>

    <!-- «Память» (нижняя пилюля): цвет IconBrush по-прежнему меняет RefreshMemoryButton
         (0 off / 1 read / 2 write / 3 read+write); BuddyV2-арт предокрашен и тинт игнорирует. -->
    <Viewbox x:Key="IconMemory" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Memory.Default}"/>
    </Viewbox>

    <!-- Отправка секретного (самолётик на градиенте) -->
    <Viewbox x:Key="IconChatSend" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.ChatSend.Default}"/>
    </Viewbox>

    <!-- Дополнительные (задел; BuddyV2-аналогов нет — старая геометрия) -->
    <Viewbox x:Key="IconHome" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="M12 3.5l8.5 7.8h-2v8.2a1 1 0 0 1-1 1h-4v-5.5h-3v5.5h-4a1 1 0 0 1-1-1v-8.2h-2z" Fill="{DynamicResource IconBrush}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="IconInfo" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Fill="{DynamicResource IconBrush}"/>
            <Rectangle Canvas.Left="11" Canvas.Top="10.5" Width="2" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource BgBrush}"/>
            <Ellipse Canvas.Left="10.7" Canvas.Top="6.5" Width="2.6" Height="2.6" Fill="{DynamicResource BgBrush}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="IconHelp" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Fill="{DynamicResource IconBrush}"/>
            <Rectangle Canvas.Left="11" Canvas.Top="10.5" Width="2" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource BgBrush}"/>
            <Ellipse Canvas.Left="10.7" Canvas.Top="6.5" Width="2.6" Height="2.6" Fill="{DynamicResource BgBrush}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="IconCalendar" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="M6 4.5h12A2.5 2.5 0 0 1 20.5 7v11A2.5 2.5 0 0 1 18 20.5H6A2.5 2.5 0 0 1 3.5 18V7A2.5 2.5 0 0 1 6 4.5z" Fill="{DynamicResource IconBrush}"/>
            <Rectangle Canvas.Left="7" Canvas.Top="2.6" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource IconBrush}"/>
            <Rectangle Canvas.Left="15" Canvas.Top="2.6" Width="2" Height="4" RadiusX="1" RadiusY="1" Fill="{DynamicResource IconBrush}"/>
            <Rectangle Canvas.Left="3.5" Canvas.Top="9.2" Width="17" Height="1.6" Fill="{DynamicResource BgBrush}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="IconStop" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Rectangle Canvas.Left="6" Canvas.Top="6" Width="12" Height="12" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource ErrorBrush}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="IconChevronRight" x:Shared="False" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="M10 7l5 5-5 5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Canvas>
    </Viewbox>

    <!-- Pressed-варианты BuddyV2-алиасов: PressedIconSwap подставляет Icon*Pressed
         пока кнопка зажата (baseKey + "Pressed"). Только для имён с BuddyV2-парой. -->
    <Viewbox x:Key="IconAppLogoPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Waveform.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconChevronDownPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.ChevronDown.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconLlmPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Llm.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconPausePressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Pause.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconPlayPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Play.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconAutoScrollPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.AutoScroll.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconSettingsPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Settings.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconMinimizePressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Minimize.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconMaximizePressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Maximize.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconRestorePressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Restore.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconClosePressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Close.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconSendNowPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.SendNow.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconExportPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Export.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconAiProtocolPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.AiProtocol.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconScreenshotPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Screenshot.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconCloakPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Cloak.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconErasePressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Erase.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconMicPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Mic.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconMicOffPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.MicOff.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconLlmOffPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.LlmOff.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconSpeakerPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Speaker.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconSpeakerOffPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.SpeakerOff.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconMemoryPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.Memory.Pressed}"/>
    </Viewbox>
    <Viewbox x:Key="IconChatSendPressed" x:Shared="False" Stretch="Uniform">
        <Image Source="{DynamicResource BuddyV2.Icon.ChatSend.Pressed}"/>
    </Viewbox>

</ResourceDictionary>
