    <sys:String x:Key="L_SetAudio_SpeakerLabel">Динамик (loopback):</sys:String>
    <sys:String x:Key="L_SetAudio_Vad0">0 — Консервативный (минимум ложных срабатываний)</sys:String>
    <sys:String x:Key="L_SetAudio_Vad1">1 — Умеренный</sys:String>
    <sys:String x:Key="L_SetAudio_Vad2">2 — Стандарт</sys:String>
