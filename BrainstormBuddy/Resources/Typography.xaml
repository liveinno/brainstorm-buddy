<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =====================================================================
         Типографика — дизайн-волна 01.
         Основной шрифт: Inter 4.1 (Resources/Fonts/Inter, статические TTF).
         Моноширинный: JetBrains Mono (Resources/Fonts, ключ MonoFont в теме).
         Все кисти — DynamicResource (AGENTS.md §16), шрифтовые ресурсы —
         статические (не меняются с темой).
         Веса OpenType: Regular 400 / Medium 500 / SemiBold 600.
         ===================================================================== -->

    <!-- Семейства -->
    <FontFamily x:Key="UiFontFamily">pack://application:,,,/Resources/Fonts/Inter/#Inter</FontFamily>

    <!-- Отступы полей ввода (горизонталь, вертикаль) -->
    <Thickness x:Key="InputPadding">12,8</Thickness>
    <Thickness x:Key="MultilineInputPadding">12,10</Thickness>
    <Thickness x:Key="TranscriptBoxPadding">14,12</Thickness>

    <!-- ===== Заголовки ===== -->

    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="30"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="DialogTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- ===== Основной текст ===== -->

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="DocumentText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="23"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="HelperText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="MetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- ===== Управляющие элементы ===== -->

    <Style x:Key="ButtonText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="CompactButtonText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="NavText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="NavTextSelected" TargetType="TextBlock" BasedOn="{StaticResource NavText}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===== Поля ввода: InputText / MultilineInputText / MonoInputText
         перенесены в Resources/Styles.xaml (волна 03A §4.1) — там они
         наследуют TextBoxBaseStyle с тематическим шаблоном. Дублировать
         ключи здесь нельзя. ===== -->

    <!-- ===== Моноширинный ===== -->

    <Style x:Key="CodeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="LogText" TargetType="TextBlock" BasedOn="{StaticResource CodeText}"/>

    <!-- MonoInputText — в Resources/Styles.xaml (см. комментарий выше). -->

</ResourceDictionary>
