<UserControl x:Class="BrainstormBuddy.Controls.MarkdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <!-- Ответ модели с markdown-разметкой.

         Исходный текст с разметкой лежит в Text и хранится как есть: форматирование применяется
         только здесь, при отрисовке, поэтому сохранённые ранее ответы открываются без миграции.

         Абзацы, заголовки, пункты списков и цитаты собираются в FlowDocument как Paragraph:
         у них есть Inlines (жирный/курсив/зачёркивание, Hyperlink, подсветка фрагмента) и
         штатное выделение мышью с копированием (Ctrl+C / контекстное меню) — как у прежнего
         TextBox с ответом. Блоки кода и таблицы остаются виджетами (BlockUIContainer): им нужна
         горизонтальная прокрутка внутри блока, а текст кода выделяется в собственном TextBox.

         Внутренней вертикальной прокрутки нет — она у родительского ScrollViewer, его вертикальное
         смещение компонент сохраняет при перерисовке (стриминг не «уводит» страницу). -->
    <RichTextBox x:Name="Doc"
                 IsReadOnly="True"
                 IsDocumentEnabled="True"
                 IsTabStop="False"
                 BorderThickness="0"
                 Padding="0"
                 Margin="0"
                 Background="Transparent"
                 VerticalScrollBarVisibility="Disabled"
                 HorizontalScrollBarVisibility="Disabled"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch" />
</UserControl>