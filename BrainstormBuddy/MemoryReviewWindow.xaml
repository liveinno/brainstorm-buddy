<Window x:Class="BrainstormBuddy.MemoryReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_MR_Title}" Height="480" Width="540" MinHeight="320" MinWidth="420"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- Кнопка — глобальный шаблон волны 02 (r8, HoverBrush-hover, BgBrush-press,
             фокус-рамка 2px); тут только размер текста. PrimaryActionButton — глобальный. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BgMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Чип с типом memory item -->
        <Style x:Key="ChipBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgLightBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + источник -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource L_MR_Title}" Style="{StaticResource DialogTitleText}"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="SubTitle" Style="{StaticResource MetaText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <!-- Pending-факты встречи (☑ по умолчанию) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                      Margin="0,0,0,8" VerticalAlignment="Top">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource ChipBadge}">
                                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource BadgeText}"
                                                   Foreground="{DynamicResource AccentSoftBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Content}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </DockPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource L_MR_Empty}"
                           Style="{StaticResource MetaText}" Margin="2,0,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Авто-закрытие: по таймеру сохраняется выбранное -->
        <TextBlock x:Name="CountdownText" Grid.Row="2" Style="{StaticResource MetaText}" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>

        <!-- Действия -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <WrapPanel DockPanel.Dock="Right">
                <Button x:Name="DiscardAllBtn" Content="{DynamicResource L_MR_DiscardAll}"
                        Click="OnDiscardAll" Margin="0,0,8,0"/>
                <Button x:Name="SaveAllBtn" Content="{DynamicResource L_MR_SaveAll}"
                        Click="OnSaveAll" Margin="0,0,8,0"/>
                <Button x:Name="SaveSelectedBtn" Content="{DynamicResource L_MR_SaveSelected}"
                        Style="{StaticResource PrimaryActionButton}" Click="OnSaveSelected"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextDimBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>