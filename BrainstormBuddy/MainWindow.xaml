<Window x:Class="BrainstormBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrainstormBuddy"
        Width="320" Height="200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        ShowInTaskbar="False">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <TextBlock Text="BrainstormBuddy" Style="{StaticResource PageTitleText}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" Text="{DynamicResource L_Main_StatusStart}" Margin="0,8,0,16" HorizontalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
        <Button Content="{DynamicResource L_Main_OpenOverlay}" Width="160" Click="OnOpenOverlay" HorizontalAlignment="Center"/>
        <Button Content="{DynamicResource L_Main_Settings}" Width="160" Margin="0,8,0,0" Click="OnOpenSettings" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>