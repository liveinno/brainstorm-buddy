<Window x:Class="BrainstormBuddy.StyledMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False" ResizeMode="NoResize" MinWidth="300" MaxWidth="480"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Кнопка — глобальный шаблон волны 02 (r8, HoverBrush-hover, BgBrush-press,
             фокус-рамка 2px); тут только размер текста. PrimaryActionButton — глобальный. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BgMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Глиф иконки (⚠/ℹ/?/✕), цвет — тематическая кисть; без иконки скрыт -->
            <TextBlock x:Name="IconGlyph" Grid.Column="0" FontSize="22" Margin="0,0,12,0"
                       VerticalAlignment="Top" Visibility="Collapsed"/>
            <ScrollViewer Grid.Column="1" MaxHeight="380" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Style="{StaticResource BodyText}"
                           Foreground="{DynamicResource TextBrush}"/>
            </ScrollViewer>
        </Grid>

        <StackPanel x:Name="ButtonsPanel" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </Grid>
</Window>
