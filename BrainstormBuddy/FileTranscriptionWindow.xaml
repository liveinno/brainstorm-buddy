<Window x:Class="BrainstormBuddy.FileTranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BrainstormBuddy"
        xmlns:controls="clr-namespace:BrainstormBuddy.Controls"
        Title="{DynamicResource L_FileTr_Title}" Height="700" Width="1020" MinHeight="520" MinWidth="820"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ListBox (тёмный, свой шаблон — иначе ПУСТОЙ список рисуется белым дефолтным шаблоном) -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem (hover/selected как в Settings) -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <!-- Волна 08: левая полоса AccentBrush 3px у выбранной строки. -->
                            <Border x:Name="SelBar" Width="3" HorizontalAlignment="Left"
                                    Margin="3,6,0,6" CornerRadius="1.5"
                                    Background="{DynamicResource AccentBrush}"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMediumBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                                <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- bool → Visibility (кнопки саммари, блок текста саммари на карточке) -->
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <!-- InverseBoolVis — примечание «саммари ещё нет» (видно, когда HasSummary=false);
             FtThreshold — адаптивные пороги ActualWidth (760 панель движка, 680 строка команд);
             FtHistoryWidth — колонка истории 256/224 по ширине окна (порог 1000). -->
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
        <local:FtWidthThresholdConverter x:Key="FtThreshold"/>
        <local:FtHistoryColumnWidthConverter x:Key="FtHistoryWidth"/>

        <!-- ComboBox/ComboBoxItem: локальные копии из Settings удалены — теперь
             применяется глобальный шаблон из Styles.xaml (r10 поле и popup). -->

    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Сайдбар: история ===== (колонка 256 при ширине окна ≥1000, иначе 224) -->
        <Grid Grid.Column="0"
              Width="{Binding ActualWidth, ElementName=RootGrid, Converter={StaticResource FtHistoryWidth}, ConverterParameter=40}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource L_FileTr_HistoryHeader}" Style="{StaticResource LabelText}"
                       Foreground="{DynamicResource TextDimBrush}" Margin="2,0,0,8"/>
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="4">
                <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnHistorySelect">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                           LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"
                                           AutomationProperties.Name="{Binding FileName}"/>
                                <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource TextBrightBrush}" Margin="0,4,0,0"
                                           Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm', Mode=OneWay}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource L_FileTr_DeleteFromHistory}" Click="OnDeleteHistory"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>
        </Grid>

        <!-- ===== ГЛАВНАЯ ЗОНА ===== -->
        <Grid Grid.Column="2" x:Name="MainArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок + панель движка/оборудования.
                 При ширине правой колонки ≥760 панель справа от заголовка (Width 256),
                 иначе — под заголовком на всю ширину (переключение — стилем по ActualWidth). -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{DynamicResource L_FileTr_Header}" Style="{StaticResource PageTitleText}"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource L_FileTr_Subtitle}" Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel x:Name="EnginePanel" VerticalAlignment="Top">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <!-- Узко: панель под заголовком, на всю ширину правой колонки. -->
                            <Setter Property="Grid.Row" Value="1"/>
                            <Setter Property="Grid.Column" Value="0"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="Margin" Value="0,12,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="ActualWidth" ElementName="MainArea"
                                                 Converter="{StaticResource FtThreshold}" ConverterParameter="760"/>
                                    </DataTrigger.Binding>
                                    <!-- Широко: справа от заголовка, фиксированная 256. -->
                                    <Setter Property="Grid.Row" Value="0"/>
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                                    <Setter Property="Width" Value="256"/>
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{DynamicResource L_FileTr_EngineLabel}" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="EngineCombo" SelectedValuePath="Tag" SelectionChanged="OnEngineChanged">
                        <ComboBoxItem x:Name="GigaamItem" Content="{DynamicResource L_FileTr_GigaamItem}" Tag="gigaam"/>
                        <ComboBoxItem Content="{DynamicResource L_FileTr_WhisperItem}" Tag="whisper"/>
                    </ComboBox>
                    <!-- Оборудование именно ФАЙЛОВОЙ транскрибации (живой STT не трогает):
                         Авто / CPU / конкретный GPU. Заполняется из GpuEnumerator в code-behind. -->
                    <TextBlock Text="{DynamicResource L_FileTr_HardwareLabel}" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextDimBrush}" Margin="0,12,0,3"/>
                    <ComboBox x:Name="HardwareCombo" SelectedValuePath="Tag" SelectionChanged="OnHardwareChanged"
                              ToolTip="{DynamicResource L_FileTr_HardwareToolTip}"/>
                    <TextBlock x:Name="EngineText" Style="{StaticResource MetaText}" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0" TextWrapping="Wrap" Text=""/>
                </StackPanel>
            </Grid>

            <!-- Карточка выбора файлов (мульти-выбор → очередь, по одному файлу за раз) -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                <Grid x:Name="PickRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Column="0" x:Name="SelectFileBtn" Content="{DynamicResource L_FileTr_SelectFiles}" Style="{StaticResource PrimaryActionButton}"
                            Click="OnSelectFile" ToolTip="{DynamicResource L_FileTr_SelectFilesToolTip}"/>
                    <TextBlock Grid.Column="1" x:Name="FileNameText" Text="{DynamicResource L_FileTr_NoFiles}"
                               Style="{StaticResource BodyText}"
                               VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <!-- Команды справа; при ширине области <680 переносятся второй строкой (зазор 8). -->
                    <StackPanel x:Name="CommandsPanel" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.Column" Value="2"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                                <Setter Property="Margin" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Value="False">
                                        <DataTrigger.Binding>
                                            <Binding Path="ActualWidth" ElementName="PickRowGrid"
                                                     Converter="{StaticResource FtThreshold}" ConverterParameter="680"/>
                                        </DataTrigger.Binding>
                                        <Setter Property="Grid.Row" Value="1"/>
                                        <Setter Property="Grid.Column" Value="0"/>
                                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                                        <Setter Property="Margin" Value="0,8,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button x:Name="TranscribeBtn" Content="{DynamicResource L_FileTr_TranscribeBtn}" Style="{StaticResource PrimaryButton}"
                                Click="OnTranscribe" IsEnabled="False"/>
                        <Button x:Name="CancelBtn" Content="{DynamicResource L_FileTr_CancelBtn}" Click="OnCancel" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <Button x:Name="ResetBtn" Content="{DynamicResource L_FileTr_NewFileBtn}" Click="OnReset" Margin="8,0,0,0"
                                ToolTip="{DynamicResource L_FileTr_NewFileToolTip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ffmpeg-баннер: показывается, если для webm/mkv нет ffmpeg -->
            <Border Grid.Row="2" x:Name="FfmpegBanner" Visibility="Collapsed" Margin="0,0,0,12"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource WarnBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="FfmpegDownloadBtn" Content="{DynamicResource L_FileTr_FfmpegDownloadBtn}"
                            Style="{StaticResource PrimaryButton}" Click="OnDownloadFfmpeg" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource L_FileTr_FfmpegWarn}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                        <TextBlock x:Name="FfmpegHint" TextWrapping="Wrap" Style="{StaticResource MetaText}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{DynamicResource L_FileTr_FfmpegHint}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Прогресс -->
            <StackPanel Grid.Row="3" x:Name="ProgressPanel" Margin="0,0,0,12" Visibility="Collapsed">
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="8"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="2,6,0,0" Text=""/>
            </StackPanel>

            <!-- Результаты: список карточек — по одной на файл очереди / запись истории -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid>
                    <TextBlock x:Name="ResultsHint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                               Style="{StaticResource BodyText}" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"
                               TextWrapping="Wrap" Text="{DynamicResource L_FileTr_ResultsHint}"/>
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:QueueFileItem}">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Шапка карточки: имя файла + бейдж статуса -->
                                        <DockPanel Grid.Row="0">
                                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1.5" Margin="10,0,0,0"
                                                    VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BgLightBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueFileStatus.Active}">
                                                                <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueFileStatus.Done}">
                                                                <Setter Property="Background" Value="#1d4034"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueFileStatus.Error}">
                                                                <Setter Property="Background" Value="#40222b"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="Medium"
                                                           LineHeight="16" LineStackingStrategy="BlockLineHeight">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueFileStatus.Active}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueFileStatus.Done}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueFileStatus.Error}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource SectionTitleText}"
                                                       Foreground="{DynamicResource TextBrightBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FileName}"
                                                       AutomationProperties.Name="{Binding FileName}"/>
                                        </DockPanel>

                                        <!-- Строка состояния: прогресс распознавания / итог / ошибка -->
                                        <TextBlock Grid.Row="1" Text="{Binding ProgressText}" FontSize="12"
                                                   LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueFileStatus.Error}">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueFileStatus.Done}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Тело результата (только у успешно обработанного файла):
                                             метаданные → действия 12 → транскрипт 12 → саммари/пустое состояние 16. -->
                                        <Grid Grid.Row="2">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueFileStatus.Done}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Кнопки действий именно ЭТОГО файла (перенос строк — WrapPanel, зазоры 8/8) -->
                                            <WrapPanel Grid.Row="0" Margin="0,12,0,4">
                                                <Button Style="{StaticResource CompactButton}" Click="OnItemCopyTranscript" Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{DynamicResource BuddySettings.Icon.Copy.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource L_FileTr_CopyTranscript}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource CompactButton}" Click="OnItemSaveTranscript" Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource L_FileTr_DownloadTxt}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource CompactButton}" Click="OnItemExtractToMemory" Margin="0,0,8,8"
                                                        ToolTip="{DynamicResource L_FileTr_ExtractToMemoryToolTip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{DynamicResource BuddyExtra.Icon.Brain.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource L_FileTr_ExtractToMemory}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource CompactButton}" Content="{DynamicResource L_FileTr_GenerateSummary}" Click="OnItemSummary" Margin="0,0,8,8"
                                                        IsEnabled="{Binding CanGenerateSummary, Mode=OneWay}"
                                                        Visibility="{Binding HasTranscript, Converter={StaticResource BoolVis}}"/>
                                                <Button Style="{StaticResource CompactButton}" Content="{DynamicResource L_FileTr_StopSummary}" Click="OnItemSummaryCancel" Margin="0,0,8,8"
                                                        Visibility="{Binding SummaryBusy, Converter={StaticResource BoolVis}}"/>
                                                <Button Style="{StaticResource CompactButton}" Click="OnItemCopySummary" Margin="0,0,8,8"
                                                        Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{DynamicResource BuddySettings.Icon.Copy.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource L_FileTr_CopySummary}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource CompactButton}" Click="OnItemSaveSummary" Margin="0,0,8,8"
                                                        Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource L_FileTr_SummaryTxt}"/>
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>

                                            <!-- Транскрипт этого файла: MinHeight 180 / MaxHeight 420, свой верт. скролл -->
                                            <TextBox Grid.Row="1" Style="{StaticResource MultilineInputText}"
                                                     Text="{Binding TranscriptText, Mode=OneWay}" IsReadOnly="True"
                                                     IsInactiveSelectionHighlightEnabled="True"
                                                     MinHeight="180" MaxHeight="420"
                                                     Background="{DynamicResource BgDarkerBrush}" Foreground="{DynamicResource TextBrush}"
                                                     FontSize="15" Padding="{StaticResource TranscriptBoxPadding}">
                                                <TextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource L_FileTr_SelectAll}" Command="SelectAll"/>
                                                        <MenuItem Header="{DynamicResource L_FileTr_Copy}" Command="Copy"/>
                                                    </ContextMenu>
                                                </TextBox.ContextMenu>
                                            </TextBox>

                                            <!-- Пустое состояние саммари (кнопка генерации остаётся в панели действий выше) -->
                                            <TextBlock Grid.Row="2" Text="{DynamicResource L_Ft_SummaryEmpty}"
                                                       Style="{StaticResource BodyText}" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,16,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasSummary, Converter={StaticResource InverseBoolVis}}"/>

                                            <!-- Саммари этого файла — под транскриптом через 16 -->
                                            <StackPanel Grid.Row="2" Margin="0,16,0,0"
                                                        Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{DynamicResource L_FileTr_AiSummaryHeader}" Style="{StaticResource LabelText}"
                                                           Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4"/>
                                                <!-- Сводка/анализ модели — markdown-компонент (форматирование при отрисовке).
                                                     Дословная транскрипция файла выше остаётся обычным текстом. -->
                                                <Border Background="{DynamicResource BgDarkerBrush}" CornerRadius="6"
                                                        MaxHeight="200" MinHeight="60"
                                                        Padding="{StaticResource TranscriptBoxPadding}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  Focusable="False">
                                                        <controls:MarkdownView
                                                                              Text="{Binding SummaryText, Mode=OneWay}"
                                                                              BaseFontSize="15"
                                                                              Foreground="{DynamicResource TextBrush}"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
