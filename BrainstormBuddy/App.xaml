<Application x:Class="BrainstormBuddy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Иконки BuddyV2 (предокрашенные, тема-независимые DrawingImage) — на уровне
                     приложения; Icon*-вьюбоксы внутри темы (IconsDark/IconsLight) ссылаются на них. -->
                <ResourceDictionary Source="Resources/BuddyV2Icons.xaml"/>
                <!-- Иконки настроек (BuddySettings.Icon.*, Default/Pressed-пары) — кнопки
                     SettingsWindow; PressedIconSwap свопает арт по Button.IsPressed. -->
                <ResourceDictionary Source="Resources/BuddySettingsIcons.xaml"/>
                <!-- Иконки BuddyExtra (Speech*/Pin/More/StatusWarning) + Brain — тема-независимые
                     DrawingImage из пака brainstorm-buddy-extra-icons. -->
                <ResourceDictionary Source="Resources/BuddyExtraIcons.xaml"/>
                <ResourceDictionary Source="Resources/BrainIcon.xaml"/>
                <ResourceDictionary Source="Resources/AttachmentIcons.xaml"/>
                <ResourceDictionary Source="Themes/HackerTheme.xaml"/>
                <!-- Типографика (волна 01): Inter 4.1 + шкала стилей *Text.
                     После темы (MonoFont определён там), до Styles/окон-потребителей. -->
                <ResourceDictionary Source="Resources/Typography.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/Strings.ru.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Размер шрифта контента оверлея — управляется настройкой Ui.FontSize.
                 Обновляется в OverlayWindow.ApplyContentFontSize(); DynamicResource-биндинги
                 текста вопроса/ответа подхватывают изменение вживую. -->
            <sys:Double x:Key="OverlayAnswerFontSize">15</sys:Double>
            <sys:Double x:Key="OverlayQuestionFontSize">13.5</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
