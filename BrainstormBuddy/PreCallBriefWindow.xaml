<Window x:Class="BrainstormBuddy.PreCallBriefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_PB_Title}" Height="560" Width="520" MinHeight="400" MinWidth="420"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- Кнопка — глобальный шаблон волны 02 (r8, HoverBrush-hover, BgBrush-press,
             фокус-рамка 2px); тут только размер текста. PrimaryActionButton — глобальный. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BgMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Чип с типом memory item: не шире 96, длинная подпись переносится внутри
             (спека 05 §B01). Отступ до текста задаёт OnBriefRowSizeChanged. -->
        <Style x:Key="ChipBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgLightBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MaxWidth" Value="96"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="Margin" Value="2,0,0,12"/>
        </Style>

        <!-- Строка брифа: чип типа + текст. Адаптив (порог 440 по ширине строки)
             переключает OnBriefRowSizeChanged: широко — бейдж слева (Auto|*),
             узко — бейдж над текстом (колонка 0 = *, колонка 1 сплющена, строка 2).
             Строка RowDef(1) в широком режиме пустая Auto → 0 высоты. -->
        <DataTemplate x:Key="BriefRowTemplate">
            <Grid Margin="0,0,0,10" SizeChanged="OnBriefRowSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource ChipBadge}" Margin="0,0,10,0">
                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource BadgeText}"
                               TextWrapping="Wrap" Foreground="{Binding BadgeForeground}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Content}" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок: проект + последний созвон -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource L_PB_Title}" Style="{StaticResource DialogTitleText}"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="SubTitle" Style="{StaticResource MetaText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <!-- Секции брифа (прокручиваемая область: факты, открытые вопросы, повестка) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Актуальные факты (top recall) -->
                <TextBlock Style="{StaticResource SectionHeader}"
                           Text="{DynamicResource L_PB_Facts}"/>
                <ItemsControl x:Name="FactsList" ItemTemplate="{StaticResource BriefRowTemplate}"/>
                <TextBlock x:Name="FactsEmpty" Text="{DynamicResource L_PB_EmptySection}"
                           Style="{StaticResource MetaText}" Margin="2,0,0,10" TextWrapping="Wrap"
                           Visibility="Collapsed" Foreground="{DynamicResource TextMutedBrush}"/>

                <!-- Открытые вопросы / дедлайны (28 до раздела = 10 строки + 18) -->
                <TextBlock Style="{StaticResource SectionHeader}" Margin="2,18,0,12"
                           Text="{DynamicResource L_PB_OpenItems}"/>
                <ItemsControl x:Name="OpenList" ItemTemplate="{StaticResource BriefRowTemplate}"/>
                <TextBlock x:Name="OpenEmpty" Text="{DynamicResource L_PB_EmptySection}"
                           Style="{StaticResource MetaText}" Margin="2,0,0,10" TextWrapping="Wrap"
                           Visibility="Collapsed" Foreground="{DynamicResource TextMutedBrush}"/>

                <!-- Повестка (editable, уходит наружу через AgendaText) -->
                <TextBlock Style="{StaticResource SectionHeader}" Margin="2,18,0,12"
                           Text="{DynamicResource L_PB_Agenda}"/>
                <TextBox x:Name="AgendaBox" MinHeight="64" Style="{StaticResource MultilineInputText}"
                         ToolTip="{DynamicResource L_PB_TT_Agenda}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Пер-встречные тоглы памяти: ≥540 в одну строку (Auto|*),
             уже — столбиком через 8 без левого отступа у второго. -->
        <Grid x:Name="OptionsPanel" Grid.Row="2" Margin="0,16,0,0"
              SizeChanged="OnOptionsSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="UseMemoryCheck" Content="{DynamicResource L_PB_UseMemory}"
                      Margin="0,4"/>
            <CheckBox x:Name="WriteMemoryCheck" Grid.Column="1" Content="{DynamicResource L_PB_WriteMemory}"
                      Margin="16,4,0,4"/>
        </Grid>

        <!-- Действия: статус всегда над кнопками (не вытесняет их за край окна) -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextDimBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipBtn" Content="{DynamicResource L_PB_Skip}"
                        Click="OnSkip" Margin="0,0,8,0"/>
                <Button x:Name="StartBtn" Content="{DynamicResource L_PB_Start}"
                        Style="{StaticResource PrimaryActionButton}" Click="OnStart"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
