<Window x:Class="BrainstormBuddy.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BrainstormBuddy"
        xmlns:controls="clr-namespace:BrainstormBuddy.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="620" Height="560"
        MinWidth="440" MinHeight="300"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource UiFontFamily}"
        Title="BrainstormBuddy Overlay">

    <Window.Resources>
        <!-- Стиль ToolTip берётся из общего Styles.xaml (тёмная скруглённая подсказка).
             Локальный сломанный (белый на белом) удалён — подсказки были невидимы. -->

        <!-- Крестик чипа прикреплённого документа прячется, пока импорт идёт (Pending). -->
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ComboBox/ComboBoxItem: локальные копии шаблона удалены — теперь берутся
             из глобального Styles.xaml (r10, клик по всему полю, тёмный popup).
             PresetSelector ниже переопределяет только Background/Foreground. -->

        <!-- Кнопка-иконка по Button States: r8, hover-подложка HoverBrush, нажатие scale(0.9) -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Крестик закрытия баннеров/тостов. Дефолтный WPF-хром кнопки на янтарном/золотом
             фоне рисовал серый квадрат при hover, а сама зона 20px была меньше пальца/курсора.
             Явный шаблон: прозрачный фон r6, hover — полупрозрачная янтарная подложка,
             зона клика 24px, нажатие scale(0.9) как у остальных иконок. -->
        <Style x:Key="BannerCloseButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33F0A860"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стековый тост (несколько одновременно): левая цветная полоса + иконка по
             ToastKind (Accent/Success/Error через Binding Accent — без хардкода цветов).
             Крестик — единственная интерактивная часть: весь остальной визуал лежит в
             IsHitTestVisible=False-контейнере, клики по телу тоста проходят сквозь него
             к окну. Автоскрытие (Info/Success 3.5c, Error 5c, Progress — до Dismiss) —
             в code-behind. -->
        <DataTemplate x:Key="ToastItemTemplate">
            <Border Margin="18,0,18,8" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" SnapsToDevicePixels="True">
                <Grid>
                    <Grid IsHitTestVisible="False">
                        <Border Width="4" HorizontalAlignment="Left" CornerRadius="12,0,0,12"
                                Background="{Binding Accent}"/>
                        <DockPanel LastChildFill="True" Margin="4,0,0,0">
                            <Viewbox DockPanel.Dock="Left" Width="18" Height="18"
                                     VerticalAlignment="Top" Margin="8,10,10,0">
                                <Grid>
                                    <Canvas x:Name="IcInfo" Width="24" Height="24">
                                        <Ellipse Width="16" Height="16" Canvas.Left="4" Canvas.Top="4"
                                                 Stroke="{Binding Accent}" StrokeThickness="2" Fill="Transparent"/>
                                        <Path Data="M12 10.5v5 M12 8v.2" Stroke="{Binding Accent}"
                                              StrokeThickness="2.4" StrokeStartLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                    <Canvas x:Name="IcProgress" Width="24" Height="24" Visibility="Collapsed">
                                        <Ellipse Width="3" Height="3" Canvas.Left="4.5"  Canvas.Top="10.5" Fill="{Binding Accent}"/>
                                        <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="10.5" Fill="{Binding Accent}"/>
                                        <Ellipse Width="3" Height="3" Canvas.Left="16.5" Canvas.Top="10.5" Fill="{Binding Accent}"/>
                                    </Canvas>
                                    <Canvas x:Name="IcSuccess" Width="24" Height="24" Visibility="Collapsed">
                                        <Path Stroke="{Binding Accent}" StrokeThickness="2.6" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M4.5 12.5L10 18L19.5 6.5"/>
                                    </Canvas>
                                    <Canvas x:Name="IcError" Width="24" Height="24" Visibility="Collapsed">
                                        <Ellipse Width="16" Height="16" Canvas.Left="4" Canvas.Top="4"
                                                 Stroke="{Binding Accent}" StrokeThickness="2" Fill="Transparent"/>
                                        <Path Data="M9 9l6 6 M15 9l-6 6" Stroke="{Binding Accent}"
                                              StrokeThickness="2.4" StrokeStartLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center" Margin="0,9,12,9">
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontSize="14"
                                           FontWeight="SemiBold" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                                <TextBlock Text="{Binding Body}" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60"
                                           Margin="0,6,0,0"/>
                                <Button Tag="{Binding Id}" Click="OnStackToastAction"
                                        AutomationProperties.AutomationId="StackToastActionButton"
                                        Content="{Binding ActionText}" FontSize="12" Padding="10,4"
                                        Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <Button Tag="{Binding Id}" Click="OnStackToastClose"
                            AutomationProperties.AutomationId="StackToastCloseButton"
                            Style="{StaticResource BannerCloseButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="8,9,8,0"
                            ToolTip="{DynamicResource L_CloseBtn}">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{Binding Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M6.5 6.5L17.5 17.5M17.5 6.5L6.5 17.5"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ToastKind.Progress}">
                    <Setter TargetName="IcInfo" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="IcProgress" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ToastKind.Success}">
                    <Setter TargetName="IcInfo" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="IcSuccess" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ToastKind.Error}">
                    <Setter TargetName="IcInfo" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="IcError" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Круглые кнопки отправки оверлея (волна 03A): круг 32×32 r16, глиф 18×18
             по центру. Жёсткие Min/Max — глобальный неявный стиль Button (MinHeight=36)
             не может вытянуть круг в эллипс ни в одном состоянии; нажатие — только
             RenderTransform, геометрия раскладки не меняется. ContentPresenter x:Name="Cp"
             обязателен: PressedIconSwap подменяет глиф на Icon*Pressed через
             Template.FindName("Cp"). -->
        <Style x:Key="OverlaySendButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxWidth" Value="32"/>
            <Setter Property="MaxHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource ActionPrimaryBrush}"
                                CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter x:Name="Cp" Width="18" Height="18"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActionPrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActionPrimaryPressedBrush}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Группа-пилюля для рядов иконок (#141b2c, рамка #26314a, r10) -->
        <Style x:Key="ToolGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- Пара Q/A — чат-схема из Overlay Final 6a:
             вопрос — бабл справа (78%, r 16/16/4/16), ответ — карточка слева (88%, r 4/16/16/16) -->
        <DataTemplate x:Key="QaPairTemplate">
            <!-- Вертикальный зазор между сообщениями: 3→1.8 (−40% по просьбе владельца). -->
            <Border Padding="0,1.8,0,1.8" Tag="{Binding}" Background="Transparent">
                <Border.ContextMenu>
                    <ContextMenu Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <MenuItem Header="{DynamicResource L_CM_CopyAll}" Tag="{Binding}" Click="OnCopyAllClick"/>
                        <MenuItem Header="{DynamicResource L_CM_CopyHistory}" Tag="{Binding}" Click="OnCopyFullHistoryClick"/>
                        <MenuItem Header="{DynamicResource L_CM_CopyQuestion}" Tag="{Binding}" Click="OnCopyQuestionClick"/>
                        <MenuItem Header="{DynamicResource L_CM_CopyAnswer}" Tag="{Binding}" Click="OnCopyAnswerClick"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource L_CM_Expand}" Tag="{Binding}" Click="OnExpandAnswerClick"/>
                        <MenuItem Header="{DynamicResource L_CM_ClearExpanded}" Tag="{Binding}" Click="OnClearExpandedClick"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource L_CM_Focus}" Tag="{Binding}" Click="OnFocusPairClick"/>
                        <MenuItem Header="{DynamicResource L_CM_ClearFocus}" Click="OnClearAllFocusClick"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <!-- Фокус-рамка (в 6b фокус зелёный) -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1.5"
                            CornerRadius="16" Margin="-3,-3,-3,3"
                            Visibility="{Binding FocusBorderVisibility}"/>

                    <StackPanel>
                        <!-- ВОПРОС: бабл справа, 78% ширины -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22*"/>
                                <ColumnDefinition Width="78*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" HorizontalAlignment="Right"
                                    Background="{DynamicResource QuestionBubbleBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="16,16,4,16" Padding="{DynamicResource OverlayBubblePadding}">
                                <StackPanel>
                                    <!-- TextBox IsReadOnly вместо TextBlock: юзер может выделять
                                         и копировать текст вопроса курсором (прозрачный, без рамки). -->
                                    <TextBox Text="{Binding Question}" Foreground="{DynamicResource TextBrush}"
                                             FontSize="{DynamicResource OverlayQuestionFontSize}" TextWrapping="Wrap"
                                             TextBlock.LineHeight="{DynamicResource OverlayQuestionLineHeight}" TextBlock.LineStackingStrategy="BlockLineHeight"
                                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                                             MinHeight="0" CaretBrush="{DynamicResource TextBrush}"
                                             Visibility="{Binding QuestionVisibility}"
                                             VerticalScrollBarVisibility="Disabled"/>
                                    <!-- Картинки вопроса (ТЗ §4): 1 — до 320×240; 2–4 — сетка 2 колонки,
                                         ячейка ≤156×120; <240px ширины — 1 колонка (ImageGridColumns). -->
                                    <ItemsControl ItemsSource="{Binding ImageTiles}"
                                                  Visibility="{Binding ImageTilesVisibility}"
                                                  Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding ImageGridColumns}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ImgCell" AutomationProperties.AutomationId="SentImageCell" Background="Transparent"
                                                        Cursor="Hand" Margin="0,0,8,8"
                                                        MouseLeftButtonUp="OnImageTileClick" Tag="{Binding}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{DynamicResource L_ImgMenu_Open}" Tag="{Binding}" Click="OnImageMenuOpen"/>
                                                            <MenuItem Header="{DynamicResource L_ImgMenu_SaveAs}" Tag="{Binding}" Click="OnImageMenuSaveAs"/>
                                                            <MenuItem Header="{DynamicResource L_ImgMenu_Copy}" Tag="{Binding}" Click="OnImageMenuCopy"/>
                                                            <Separator/>
                                                            <MenuItem Header="{DynamicResource L_ImgMenu_AddToMsg}" Tag="{Binding}" Click="OnImageMenuAddToMsg"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="MaxWidth" Value="156"/>
                                                            <Setter Property="MaxHeight" Value="120"/>
                                                            <Style.Triggers>
                                                                <!-- Одна картинка — крупно, до 320×240. -->
                                                                <DataTrigger Binding="{Binding DataContext.ImageTiles.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="1">
                                                                    <Setter Property="MaxWidth" Value="320"/>
                                                                    <Setter Property="MaxHeight" Value="240"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Image Source="{Binding Thumb}" Stretch="Uniform"
                                                           MaxWidth="{Binding Width}" MaxHeight="{Binding Height}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Speaker chips (диаризация): чип на каждого спикера, встретившегося
                                             в пузыре («[S1] … [S2] …») плюс доминантный; цвет стабилен в сессии;
                                             вся строка скрыта при выкл/"S?". ContextMenu не наследует DataContext —
                                             мост через Tag на Border + PlacementTarget.Tag. -->
                                        <ItemsControl ItemsSource="{Binding SpeakerChips}"
                                                      Visibility="{Binding SpeakerChipsVisibility}"
                                                      Margin="0,7,0,0" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{Binding Brush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="6,2" Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding}" Cursor="Hand">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{DynamicResource L_MemAssignName}"
                                                                          Click="OnAssignSpeakerNameClick"
                                                                          DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <TextBlock Text="{Binding Text}"
                                                                   Foreground="{Binding Brush}"
                                                                   FontSize="12" FontWeight="Medium"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel x:Name="QuestionTimingLine" Orientation="Horizontal"
                                                    Margin="0,7,0,0"
                                                    Visibility="{DynamicResource QuestionTimingLineVisibility}">
                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SttReceivedText}" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="12" Margin="7,0,0,0" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SttLatencyText}" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="12" Margin="6,0,0,0" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OcrLatencyText}" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="12" Margin="6,0,0,0" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AudioDurationText}" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="12" Margin="6,0,0,0" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ОТВЕТ: слева, 88% ширины. Отступ от блока «Динамик» сокращён (было 13→5).
                             В режиме «LLM выкл» (чистый транскрибатор) блок прячется целиком:
                             ни «ожидания», ни пустой карточки (AnswerSectionVisibility). -->
                        <Grid Margin="0,5,0,0" Visibility="{Binding AnswerSectionVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88*"/>
                                <ColumnDefinition Width="12*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
                                <!-- Шапка «ОТВЕТ Σ…» слева, тех-метка rec/STT/LLM — СПРАВА на той же строке (скрываемая) -->
                                <DockPanel Margin="0,0,0,4" LastChildFill="False">
                                    <!-- Одна TextBlock-строка с Runs: в горизонтальном StackPanel дети
                                         меряются с бесконечной шириной и TextTrimming не срабатывает —
                                         при переполнении ClipToBounds резал строку посреди глифа
                                         (артефакт вида «2,?rec» у края). TextBlock + CharacterEllipsis
                                         обрезает хвост многоточием вместо среза глифов. -->
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                               FontFamily="{DynamicResource MonoFont}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{DynamicResource TimingLineVisibility}">
                                        <Run Text="{Binding ChunkReadyText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding SttSentText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding LlmSentText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                                        <TextBlock Text="{DynamicResource L_Answer}" Foreground="{DynamicResource TextDimBrush}"
                                                   FontSize="11" FontWeight="Medium"
                                                   LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
                                        <TextBlock Text="{Binding TotalLatencyText}" Foreground="{Binding LatencyBrush}"
                                                   FontSize="12" Margin="8,0,0,0" FontFamily="{DynamicResource MonoFont}" FontWeight="Medium"/>
                                        <!-- «Остановить» (Sending) / «Повторить» (ручной Failed|Cancelled):
                                             компактные мини-кнопки на строке «ОТВЕТ». Текст — RU-литерал,
                                             ключи L_Btn_StopAnswer/L_Btn_RetryAnswer пойдут в Strings у lead. -->
                                        <Button Content="Остановить" Style="{StaticResource CompactButton}"
                                                Height="20" MinHeight="20" Padding="8,1" FontSize="11"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Tag="{Binding}" Click="OnStopAnswerClick"
                                                ToolTip="{DynamicResource L_TT_StopAnswer}"
                                                Visibility="{Binding StopButtonVisibility}"/>
                                        <Button Content="Повторить" Style="{StaticResource CompactButton}"
                                                Height="20" MinHeight="20" Padding="8,1" FontSize="11"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Tag="{Binding}" Click="OnRetryAnswerClick"
                                                ToolTip="{DynamicResource L_TT_RetryAnswer}"
                                                Visibility="{Binding RetryButtonVisibility}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Background="{DynamicResource AnswerCardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4,16,16,16" Padding="{DynamicResource OverlayBubblePadding}">
                                    <StackPanel>
                                        <!-- MarkdownView — ответ LLM с разметкой (жирный/курсив/списки/таблицы/код).
                                             Исходный текст с разметкой лежит в QaPair.Answer как есть: схлопывание
                                             пустых строк и форматирование делает компонент при отрисовке, поэтому
                                             при стриминге незавершённая разметка не теряет текст.
                                             Кегль и интерлиньяж — те же App-ресурсы, что у прежнего TextBox
                                             (OverlayAnswerFontSize / OverlayAnswerLineHeight): размер ответа не меняется.
                                             Mode=OneWay — компонент не пишет текст обратно в модель (иначе
                                             AppendAnswerDelta сбрасывал бы признак стриминга). -->
                                        <controls:MarkdownView Text="{Binding Answer, Mode=OneWay}"
                                                             Foreground="{DynamicResource TextBrightBrush}"
                                                             BaseFontSize="{DynamicResource OverlayAnswerFontSize}"
                                                             LineHeight="{DynamicResource OverlayAnswerLineHeight}"
                                                             Loaded="OnMarkdownViewLoaded"/>
                                        <!-- Сработал лимит Ui.MaxAnswerChars: строка-ссылка ведёт в настройки
                                             на вкладку «Оверлей» (золотая подсветка поля лимита). Видна только
                                             при реальной обрезке (AnswerTruncatedVisibility). Ссылка без
                                             подчёркивания — оно появляется при hover (триггер ниже). -->
                                        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                                   LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                                   Visibility="{Binding AnswerTruncatedVisibility}">
                                            <Hyperlink Click="OnTruncatedHintClick"
                                                       Foreground="{DynamicResource AccentBrush}" Cursor="Hand">
                                                <Hyperlink.Style>
                                                    <Style TargetType="Hyperlink">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="TextDecorations" Value="Underline"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Hyperlink.Style>
                                                <Run Text="{DynamicResource L_Answer_Truncated}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                        <!-- §7: «Источник: дата встречи» под ответом, когда в промпт подмешаны
                                             фрагменты журналов прошлых встреч (MeetingSearchService). Клик —
                                             история встреч на той строке с золотой подсветкой.
                                             Одна компактная строка: подпись + до трёх кликабельных ссылок
                                             в ряд. Ссылки делят доступную ширину поровну и обрезаются
                                             многоточием без переноса; полный сниппет остаётся в тултипе.
                                             Даже на узком окне каждая ссылка доступна для перехода. -->
                                        <Grid Margin="0,6,0,0" ClipToBounds="True"
                                              Visibility="{Binding PastMeetingsVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource L_Src_Label}"
                                                       FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                                       TextWrapping="NoWrap" VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding PastMeetingSources}"
                                                          VerticalAlignment="Center" ClipToBounds="True">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="11" TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="130"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   ToolTip="{Binding Snippet}">
                                                            <Hyperlink Click="OnPastMeetingSourceClick" DataContext="{Binding}"
                                                                       Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                                                                       ToolTip="{Binding Snippet}">
                                                                <Run Text="{Binding SourceLabel, Mode=OneWay}"/>
                                                            </Hyperlink>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- HRD совет + Защита: две карточки в ряд (макет: gap 10, r14) -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#176F8CFF" BorderBrush="#476F8CFF" BorderThickness="1"
                                    CornerRadius="14" Padding="13,11"
                                    Visibility="{Binding HrdAdviceVisibility}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L_HrdAdvice}" FontSize="11" FontWeight="Medium"
                                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                               Foreground="#9db2ff" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding HrdAdvice}" Foreground="#c4d0ea" FontSize="13"
                                             TextWrapping="Wrap" IsReadOnly="True" Background="Transparent"
                                             BorderThickness="0" Padding="0" MinHeight="0" CaretBrush="#c4d0ea"
                                             VerticalScrollBarVisibility="Disabled"/>
                                </StackPanel>
                            </Border>
                            <Rectangle Grid.Column="1" Width="10" Visibility="{Binding StressDefenseVisibility}"/>
                            <Border Grid.Column="2" Background="#14FBBF24" BorderBrush="#47FBBF24" BorderThickness="1"
                                    CornerRadius="14" Padding="13,11"
                                    Visibility="{Binding StressDefenseVisibility}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L_Defense}" FontSize="11" FontWeight="Medium"
                                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                               Foreground="#f0c65f" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding StressDefense}" Foreground="#e2d6b4" FontSize="13"
                                             TextWrapping="Wrap" IsReadOnly="True" Background="Transparent"
                                             BorderThickness="0" Padding="0" MinHeight="0" CaretBrush="#e2d6b4"
                                             VerticalScrollBarVisibility="Disabled"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Расширенный ответ (в стиле карточек макета, янтарный) -->
                        <Border Background="#14FBBF24" BorderBrush="#47FBBF24" BorderThickness="1"
                                CornerRadius="14" Padding="13,11" Margin="0,10,0,0"
                                Visibility="{Binding ExpandedVisibility}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Expanded}" FontSize="11" FontWeight="Medium"
                                           LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                           Foreground="#f0c65f" Margin="0,0,0,5"/>
                                <!-- Развёрнутый ответ — тот же MarkdownView (кэгль 13, как у прежнего TextBox;
                                     отдельного ресурса размера у этого блока нет). -->
                                <controls:MarkdownView Text="{Binding ExpandedAnswer, Mode=OneWay}"
                                                     Foreground="#e2d6b4"
                                                     BaseFontSize="13"
                                                     Loaded="OnMarkdownViewLoaded"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- «Стекло»: полупрозрачен ТОЛЬКО фон-слой (BgLayer.Opacity = Ui.WindowOpacity),
         контент поверх — на полной непрозрачности, поэтому текст/баблы чёткие над любым фоном. -->
    <Border x:Name="RootBorder" Background="Transparent"
            BorderBrush="Transparent" BorderThickness="0" CornerRadius="26">
        <Grid>
            <Border x:Name="BgLayer" Background="{DynamicResource WindowBgBrush}" CornerRadius="26"/>
        <Grid>
        <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar / drag handle. Grid Auto/*/Auto/Auto: лого | селектор (сжимается) |
                 группы действий | панель чипов и кнопок окна. -->
            <!-- Grid надёжнее DockPanel держит правую панель в пределах окна. -->
            <Grid Grid.Row="0" x:Name="DragHandle" Background="Transparent"
                  MouseLeftButtonDown="OnDragHandleMouseDown" Cursor="SizeAll" Margin="16,14,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Лого-бейдж 28×28 r9, индиго-градиент, белая волна 1:1 (Overlay Final 6a, viewBox24) -->
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="9"
                        Background="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#6078ff" BlurRadius="14" ShadowDepth="4" Opacity="0.6"/>
                    </Border.Effect>
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="7" Canvas.Top="8" Width="2.4" Height="8" RadiusX="1.2" RadiusY="1.2" Fill="#ffffff"/>
                            <Rectangle Canvas.Left="10.8" Canvas.Top="5" Width="2.4" Height="14" RadiusX="1.2" RadiusY="1.2" Fill="#ffffff"/>
                            <Rectangle Canvas.Left="14.6" Canvas.Top="9" Width="2.4" Height="6" RadiusX="1.2" RadiusY="1.2" Fill="#ffffff"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <!-- Правая панель: чипы + кнопки. Auto-колонка → всегда полная ширина, кнопки не режутся. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Чипы-статусы 6a: точка 7px + mono-подпись, без рамки -->
                    <Border x:Name="RecChip" BorderThickness="0" Background="Transparent" Margin="0,0,8,0"
                            ToolTip="{DynamicResource L_TT_Rec}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecIndicator" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RecChipText" Text="REC" FontSize="13"
                                       LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="LlmChip" BorderThickness="0" Background="Transparent" Margin="0,0,6,0"
                            ToolTip="{DynamicResource L_TT_Llm}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LlmIndicator" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LlmChipText" Text="LLM" FontSize="13"
                                       LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Робот (LLM-пауза) и пауза-аудио убраны из шапки:
                         пауза аудио теперь на микрофоне в нижней панели; LLM-пауза — по хоткею Ctrl+Shift+Y -->
                    <Button x:Name="AutoScrollButton" Style="{StaticResource TitleBarButton}" Width="27" Height="27" Click="OnAutoScrollClick" ToolTip="{DynamicResource L_TT_AutoScroll}">
                        <ContentPresenter Content="{DynamicResource IconAutoScroll}" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource TitleBarButton}" Width="27" Height="27" Click="OnSettingsClick" ToolTip="{DynamicResource L_TT_Settings}"
                            AutomationProperties.AutomationId="SettingsButton">
                        <ContentPresenter Content="{DynamicResource IconSettings}" Width="15" Height="15"/>
                    </Button>
                    <!-- Кнопки окна: свернуть / развернуть / скрыть. Слегка крупнее прежнего (24→28). -->
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Width="28" Height="28" Click="OnMinimizeClick" ToolTip="{DynamicResource L_TT_Minimize}">
                        <ContentPresenter Content="{DynamicResource IconMinimize}" Width="15" Height="15"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Width="28" Height="28" Click="OnMaximizeClick" ToolTip="{DynamicResource L_TT_Maximize}">
                        <ContentPresenter Content="{DynamicResource IconMaximize}" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="HideButton" Style="{StaticResource TitleBarButton}" Width="28" Height="28" Click="OnHideClick" ToolTip="{DynamicResource L_TT_Hide}">
                        <ContentPresenter Content="{DynamicResource IconClose}" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
                <!-- Селектор промпта: пилюля #141b2c r10. Средняя *-колонка — сжимается при нехватке места
                     (MaxWidth=200 как прежний Width, MinWidth держит читаемость на узком окне). -->
                <ComboBox Grid.Column="1" x:Name="PresetSelector" MinWidth="110" MaxWidth="200" MinHeight="30"
                          FontSize="13"
                          Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrightBrush}"
                          SelectionChanged="OnPresetSelectorChanged" ToolTip="{DynamicResource L_TT_Preset}"/>
                <!-- Ряд действий (экспорт/протокол/скриншот/клоак/стереть) — одна пилюля
                     в шапке между селектором и статусами. Те же кнопки/хендлеры/тултипы.
                     Hit-test: все кнопки — ButtonBase → IsOverInteractive → клики доходят, а не HTCAPTION. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ExportTransBtn" Style="{StaticResource TitleBarButton}" Width="28" Height="26" Margin="0,0,4,0" Click="OnExportTranscript" ToolTip="{DynamicResource L_TT_Export}">
                                <ContentPresenter Content="{DynamicResource IconExport}" Width="16" Height="16"/>
                            </Button>
                            <Button x:Name="ExportSummaryBtn" Style="{StaticResource TitleBarButton}" Width="28" Height="26" Margin="0,0,4,0" Click="OnExportAiSummary" ToolTip="{DynamicResource L_TT_Protocol}">
                                <ContentPresenter Content="{DynamicResource IconAiProtocol}" Width="16" Height="16"/>
                            </Button>
                            <Button x:Name="ScreenShotButton" Style="{StaticResource TitleBarButton}" Width="28" Height="26" Margin="0,0,4,0" Click="OnScreenShotClick" ToolTip="{DynamicResource L_TT_Screenshot}">
                                <ContentPresenter Content="{DynamicResource IconScreenshot}" Width="14" Height="14"/>
                            </Button>
                            <!-- Cloak (сквозной режим) временно скрыт: вешал главное окно. Вернуть после фикса. -->
                            <Button x:Name="CloakButton" Visibility="Collapsed" Style="{StaticResource TitleBarButton}" Width="28" Height="26" Margin="0,0,4,0" Click="OnCloakClick" ToolTip="{DynamicResource L_TT_Cloak}">
                                <ContentPresenter Content="{DynamicResource IconCloak}" Width="15" Height="15"/>
                            </Button>
                            <Button x:Name="EraseButton" Style="{StaticResource TitleBarButton}" Width="28" Height="26" Click="OnEraseClick" ToolTip="{DynamicResource L_TT_Erase}">
                                <ContentPresenter Content="{DynamicResource IconErase}" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Row 1: слайдеры (макет: padding 2 18 12, gap 26; label слева, значение справа #8fa8ff).
                 Видны только в Инженерном режиме (Config.Ui.EngineerMode). -->
            <Grid x:Name="SlidersRow" Grid.Row="1" Margin="18,2,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <DockPanel Margin="0,0,0,7" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource L_Silence}" Foreground="{DynamicResource TextDimBrush}"
                                   FontSize="11" FontWeight="Medium"
                                   LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentSoftBrush}"
                                   FontSize="12" FontFamily="{DynamicResource MonoFont}" FontWeight="Medium"
                                   Text="{Binding Value, ElementName=SilenceSlider, StringFormat={}{0:0.0}s}"/>
                    </DockPanel>
                    <Slider x:Name="SilenceSlider" Style="{StaticResource GreenSlider}"
                            Minimum="0.4" Maximum="10" Value="1.8"
                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                            ToolTip="{DynamicResource L_TT_SilenceSlider}"
                            ValueChanged="OnSilenceSliderChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <DockPanel Margin="0,0,0,7" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource L_ChunkMax}" Foreground="{DynamicResource TextDimBrush}"
                                   FontSize="11" FontWeight="Medium"
                                   LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentSoftBrush}"
                                   FontSize="12" FontFamily="{DynamicResource MonoFont}" FontWeight="Medium"
                                   Text="{Binding Value, ElementName=ChunkSlider, StringFormat={}{0:0}s}"/>
                    </DockPanel>
                    <Slider x:Name="ChunkSlider" Style="{StaticResource GreenSlider}"
                            Minimum="8" Maximum="120" Value="60"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ToolTip="{DynamicResource L_TT_ChunkSlider}"
                            ValueChanged="OnChunkSliderChanged"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: статус «Слушаю…» справа + пресеты скорости речи (только Инженерный режим).
                 Ряд действий (экспорт/протокол/скриншот/стереть) переехал в шапку между селектором
                 промпта и индикаторами. Margin.Left=52 выравнивает SpeedPresetGroup под левый край
                 селектора: 16 (margin шапки) + 28 (лого) + 8 (его margin). -->
            <StackPanel Grid.Row="2" x:Name="StatusRow">
                <DockPanel LastChildFill="False" Margin="52,0,18,10">
                    <!-- Пресеты скорости речи — только в Инженерном режиме. -->
                    <Border x:Name="SpeedPresetGroup" Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SlowSpeechBtn" Style="{StaticResource TitleBarButton}" Width="28" Height="26" Margin="0,0,4,0" Click="OnSilenceSpeedDown" ToolTip="{DynamicResource L_TT_SlowSpeech}">
                                <Image Source="{DynamicResource BuddyExtra.Icon.SpeechSlow.Default}" Width="15" Height="15"/>
                            </Button>
                            <Button x:Name="ResetSpeedBtn" Style="{StaticResource TitleBarButton}" Width="28" Height="26" Margin="0,0,4,0" Click="OnResetSpeed" ToolTip="{DynamicResource L_TT_ResetSpeed}">
                                <Image Source="{DynamicResource BuddyExtra.Icon.SpeechReset.Default}" Width="15" Height="15"/>
                            </Button>
                            <Button x:Name="FastSpeechBtn" Style="{StaticResource TitleBarButton}" Width="28" Height="26" Click="OnSilenceSpeedUp" ToolTip="{DynamicResource L_TT_FastSpeech}">
                                <Image Source="{DynamicResource BuddyExtra.Icon.SpeechFast.Default}" Width="15" Height="15"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- Волна 08: статус читается на любом фоне — локальная непрозрачная
                         подложка PanelBrush только под статус (окно остаётся стеклом). -->
                    <Border DockPanel.Dock="Right" Background="{DynamicResource PanelBrush}"
                            CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#68d6a4" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                       LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                       Margin="9,0,0,0" VerticalAlignment="Center" Text="{DynamicResource L_Listening}"/>
                            <!-- Инженерный индикатор: чанков в очереди STT + секунд аудио в буферах
                                 (ещё не отправлено). Виден только в Config.Ui.EngineerMode,
                                 обновляется в OnBlinkTick вместе с остальными индикаторами. -->
                            <TextBlock x:Name="SttQueueText" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                       FontFamily="{DynamicResource MonoFont}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed" ToolTip="{DynamicResource L_TT_SttQueue}" Text=""/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <!-- Баннер-уведомление о проблемах (STT/LLM недоступны). Скрыт, пока всё ок. -->
                <Border x:Name="NoticeBanner" Visibility="Collapsed" Margin="18,0,18,12"
                        Background="{DynamicResource PanelBrush}" BorderBrush="#66F0A860" BorderThickness="1" CornerRadius="12" Padding="12,9">
                    <DockPanel LastChildFill="True">
                        <!-- Треугольник-предупреждение слева: иконка из пака BuddyExtra -->
                        <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
                            <Image Source="{DynamicResource BuddyExtra.Icon.StatusWarning.Default}"/>
                        </Viewbox>
                        <!-- Кнопка «скрыть» справа: штрихи ярче/толще прежних (#E1B85A/2.6 терялись
                             на янтарном фоне), hover — по стилю BannerCloseButton -->
                        <Button DockPanel.Dock="Right" x:Name="NoticeCloseBtn" Click="OnNoticeClose"
                                Style="{StaticResource BannerCloseButton}" Margin="8,0,0,0" VerticalAlignment="Top"
                                ToolTip="{DynamicResource L_TT_NoticeHide}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="#FFF0C070" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M6.5 6.5L17.5 17.5M17.5 6.5L6.5 17.5"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NoticeTitle" Text="" Foreground="#FFE1B85A" FontSize="14" FontWeight="SemiBold"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="NoticeBody" Text="" Foreground="#F0DBBB" FontSize="13"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <!-- Ссылка «Открыть настройки» — видна, когда для баннера задан раздел-цель -->
                            <Button x:Name="NoticeActionBtn" Click="OnNoticeAction" Visibility="Collapsed"
                                    Cursor="Hand" HorizontalAlignment="Left" Margin="0,6,0,0" MinHeight="0"
                                    Background="Transparent" BorderThickness="0" Padding="0">
                                <TextBlock Text="{DynamicResource L_Ovl_OpenSettingsHint}" Foreground="#FFE1B85A"
                                           TextDecorations="Underline" FontSize="13" FontWeight="Medium"
                                           LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Индикатор сквозного режима: клики мыши проходят насквозь, поэтому
                     баннер текстовый, без кнопок — снять плащ можно хоткеем или
                     через иконку в трее. Виден только при включённом cloak. -->
                <Border x:Name="CloakBanner" Visibility="Collapsed" Margin="18,0,18,12"
                        Background="{DynamicResource PanelBrush}" BorderBrush="#66F0A860" BorderThickness="1" CornerRadius="12" Padding="12,9">
                    <DockPanel LastChildFill="True">
                        <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
                            <Image Source="{DynamicResource BuddyExtra.Icon.StatusWarning.Default}"/>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_Ovl_CloakBannerTitle}" Foreground="#FFE1B85A" FontSize="14" FontWeight="SemiBold"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="CloakBannerBody" Foreground="#F0DBBB" FontSize="13"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- MCP-аппрувал: карточка подтверждения опасного tool-вызова (спека MCP §491:
                     не модалка, не скриншот-видимая — живёт внутри оверлея, который исключён из
                     захвата). Видна только пока tool-loop ждёт решения; click-through выключается
                     автоматически за счёт кнопок (IsOverInteractive → не cloakable участок). -->
                <Border x:Name="McpApprovalCard" Visibility="Collapsed" Margin="18,0,18,12"
                        Background="{DynamicResource PanelBrush}" BorderBrush="#66F0A860" BorderThickness="1"
                        CornerRadius="12" Padding="12,9">
                    <DockPanel LastChildFill="True">
                        <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
                            <Image Source="{DynamicResource BuddyExtra.Icon.StatusWarning.Default}"/>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_McpApproveTitle}" Foreground="#FFE1B85A"
                                       FontSize="14" FontWeight="SemiBold"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="McpApprovalText" Foreground="#F0DBBB" FontSize="13"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="McpApprovalArgs" Foreground="{DynamicResource TextDimBrush}"
                                       FontSize="12" FontFamily="{DynamicResource MonoFont}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60"
                                       Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="McpApproveAllowBtn" Content="{DynamicResource L_McpApproveAllow}"
                                        AutomationProperties.AutomationId="McpApproveAllowBtn"
                                        Click="OnMcpApproveAllow" Padding="16,0" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button x:Name="McpApproveDenyBtn" Content="{DynamicResource L_McpApproveDeny}"
                                        AutomationProperties.AutomationId="McpApproveDenyBtn"
                                        Click="OnMcpApproveDeny" Padding="16,0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Золотистый тост аудио-устройств: новое устройство / смена вывода.
                     Цвет = CoachGold #F4C542 (как золотые рамки обучения — фирменный акцент).
                     Показывается 25 секунд, потом исчезает; кнопка закрытия — сразу. -->
                <Border x:Name="DeviceToast" Visibility="Collapsed" Margin="18,0,18,12"
                        Background="{DynamicResource PanelBrush}" BorderBrush="#99F4C542" BorderThickness="1.5" CornerRadius="12" Padding="12,9">
                    <DockPanel LastChildFill="True">
                        <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
                            <Canvas Width="24" Height="24">
                                <!-- Наушники -->
                                <Path Stroke="#F4C542" StrokeThickness="2" Fill="Transparent"
                                      Data="M4 14v-2a8 8 0 0 1 16 0v2"/>
                                <Rectangle Canvas.Left="3" Canvas.Top="13" Width="4.5" Height="7" RadiusX="2" RadiusY="2" Fill="#F4C542"/>
                                <Rectangle Canvas.Left="16.5" Canvas.Top="13" Width="4.5" Height="7" RadiusX="2" RadiusY="2" Fill="#F4C542"/>
                            </Canvas>
                        </Viewbox>
                        <Button DockPanel.Dock="Right" Click="OnDeviceToastClose"
                                Style="{StaticResource BannerCloseButton}" Margin="8,0,0,0" VerticalAlignment="Top"
                ToolTip="{DynamicResource L_CloseBtn}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="#FFF4C542" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M6.5 6.5L17.5 17.5M17.5 6.5L6.5 17.5"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceToastTitle" Text="" Foreground="#FFF4C542" FontSize="14" FontWeight="SemiBold"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="DeviceToastBody" Text="" Foreground="#F5E7C0" FontSize="13"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Зелёный тост памяти: LLM записал/обновил/забыл факт в памяти.
                     Палитра — зелёная (#4ADE80 заголовок, #D1FAE5 тело), layout тот же,
                     что у DeviceToast. Показывается 5 секунд, крестик — сразу. -->
                <Border x:Name="MemoryToast" Visibility="Collapsed" Margin="18,0,18,12"
                        Background="{DynamicResource PanelBrush}" BorderBrush="#994ADE80" BorderThickness="1.5" CornerRadius="12" Padding="12,9">
                    <DockPanel LastChildFill="True">
                        <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
                            <Canvas Width="24" Height="24">
                                <!-- Галочка «в память добавлено» -->
                                <Path Stroke="#4ADE80" StrokeThickness="2.6" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4.5 12.5L10 18L19.5 6.5"/>
                            </Canvas>
                        </Viewbox>
                        <Button DockPanel.Dock="Right" Click="OnMemoryToastClose"
                                Style="{StaticResource BannerCloseButton}" Margin="8,0,0,0" VerticalAlignment="Top"
                                ToolTip="{DynamicResource L_CloseBtn}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="#FF4ADE80" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M6.5 6.5L17.5 17.5M17.5 6.5L6.5 17.5"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="MemoryToastTitle" Text="" Foreground="#FF4ADE80" FontSize="14" FontWeight="SemiBold"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="MemoryToastBody" Text="" Foreground="#D1FAE5" FontSize="13"
                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Стек общих тостов (PushToast): до 4 одновременно, новый сверху,
                     шаблон — ToastItemTemplate. Мышь сквозь тело тоста проходит
                     (визуал в IsHitTestVisible=False), крестик остаётся кликабельным. -->
                <ItemsControl x:Name="ToastStack" ItemTemplate="{StaticResource ToastItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- History: scrollable list of Q/A pairs (макет: padding 4 18) -->
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="HistoryScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="18,4">
                    <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource QaPairTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Плашка холодного старта: видна пока история пуста (прогрев STT/ожидание
                     первой реплики), скрывается автоматически с появлением первого ответа. -->
                <StackPanel x:Name="ColdStartHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="360" Margin="24,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=HistoryList}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Пульсирующий значок-волна (мотив логотипа) -->
                    <Border Width="52" Height="52" CornerRadius="16" HorizontalAlignment="Center"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="7" Canvas.Top="8" Width="2.4" Height="8" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Canvas.Left="10.8" Canvas.Top="5" Width="2.4" Height="14" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Canvas.Left="14.6" Canvas.Top="9" Width="2.4" Height="6" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource AccentBrush}"/>
                            </Canvas>
                        </Viewbox>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="1.0" Duration="0:0:1.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <TextBlock x:Name="ColdStartTitle" Text="{DynamicResource L_ColdStartTitle}" Foreground="{DynamicResource TextBrightBrush}"
                               Style="{StaticResource SectionTitleText}" TextAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="ColdStartBody" Text="{DynamicResource L_ColdStartBody}" Foreground="{DynamicResource TextMutedBrush}"
                               Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Эквалайзер (заголовок по 6b: шеврон + АУДИО + «последние 2 мин» справа).
                 Клик по заголовку сворачивает, состояние в Config.Ui.TimelineCollapsed.
                 Вся секция видна только в Инженерном режиме (Config.Ui.EngineerMode). -->
            <Grid x:Name="EqualizerSection" Grid.Row="4" Margin="18,4,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonDown="OnTimelineHeaderClick"
                        ToolTip="{DynamicResource L_TT_TimelineHeader}">
                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" x:Name="TimelineChevron" Text="▸" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="28" Margin="0,-6,8,-6" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Left" x:Name="TimelineHeaderText" Text="{DynamicResource L_Audio}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Medium"
                                   LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource L_Last2Min}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                   FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" x:Name="TimelineBody">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>
                    <Image x:Name="TimelineImage" Grid.Row="0" Height="38"
                           HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                           Stretch="Fill" ToolTip="{DynamicResource L_TT_Timeline}"/>
                    <!-- Time ruler: ticks + labels -->
                    <Canvas x:Name="TimelineRuler" Grid.Row="1" Height="18"
                            HorizontalAlignment="Stretch" ClipToBounds="True"/>
                </Grid>
            </Grid>

            <!-- Футер по 6a: mono-строка «Токены … / часы», ниже поле-пилюля r999
                 с плейсхолдером и круглой градиентной кнопкой-самолётиком -->
            <StackPanel Grid.Row="5" x:Name="FooterRow">
                <DockPanel x:Name="SessionStatsRow" Margin="18,12,18,0" LastChildFill="False">
                    <!-- «Токены за встречу» — суммарный расход за сессию, НЕ размер контекста
                         (размер контекста показывает ContextInfoText). -->
                    <TextBlock DockPanel.Dock="Left" x:Name="TokenText"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Text=""
                               TextTrimming="CharacterEllipsis" Margin="0,0,14,0"
                               ToolTip="{DynamicResource L_TT_TokensMeeting}"/>
                    <!-- §8.1: фоновый расход «Документы и память» — ОТДЕЛЬНО от
                         «Потрачено за встречу». Скрыт, пока фон ничего не потратил. -->
                    <TextBlock DockPanel.Dock="Left" x:Name="BgTokensText"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Text=""
                               TextTrimming="CharacterEllipsis" Margin="0,0,14,0"
                               ToolTip="{DynamicResource L_TT_TokensBackground}" Visibility="Collapsed"/>
                    <!-- «Контекст: ≈X/Y» от фоновой сводки (SetContextInfo); скрыта до первых данных.
                         Margin справа + Ellipsis — чтобы не слипалась с часами (баг 2.29.2). -->
                    <TextBlock DockPanel.Dock="Left" x:Name="ContextInfoText"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"
                               Margin="0,0,14,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               ToolTip="{DynamicResource L_TT_ContextInfo}"/>
                    <TextBlock DockPanel.Dock="Right" x:Name="ClockText"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Text="00:00:00"/>
                </DockPanel>
                <!-- Чипы прикреплённых документов: до двух строк WrapPanel (MaxHeight=62),
                     остальные под кнопкой «Ещё N» → диалог выбора. Наполняет SetAttachmentChips
                     (App перечитывает AttachmentStore после импорта/линковки/фактов). -->
                <DockPanel x:Name="AttachmentChipsRow" Margin="18,0,18,0"
                           Visibility="Collapsed" LastChildFill="True">
                    <Button DockPanel.Dock="Right" x:Name="MoreAttachmentsBtn" Click="OnAttachFilesClick"
                            Style="{StaticResource CompactButton}" Margin="4,2,0,2"
                            VerticalAlignment="Top" Visibility="Collapsed"/>
                    <!-- ScrollViewer с выключенными полосами: обрезает чипы после двух строк;
                         ItemsControl сама не клипует содержимое. -->
                    <ScrollViewer x:Name="AttachmentChipsScroll" MaxHeight="62" VerticalAlignment="Top"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AttachmentChipsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="7,3" Margin="0,2,6,2"
                                        ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding DisplayName}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{DynamicResource BuddyAttachment.Icon.Default}" Width="14" Height="14" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}"
                                                   FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        <Button Content="✕" Click="OnAttachmentRemoveClick" Tag="{Binding DocumentId}"
                                                Style="{StaticResource CompactButton}" Margin="6,-2,-4,-2" Padding="4,1"
                                                MinHeight="18" Height="18" FontSize="10"
                                                Visibility="{Binding Pending, Converter={StaticResource InverseBoolVis}}"
                                                ToolTip="{DynamicResource L_Att_RemoveTip}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Полоса черновика изображений (ТЗ §3): тайлы 116×92, превью+подпись,
                     крестик 24×24 в правом верхнем углу. Пусто → Collapsed. -->
                <ScrollViewer x:Name="ImageDraftRow" Margin="18,0,18,8" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ImageDraftList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TileBd" AutomationProperties.AutomationId="DraftTile" Width="116" Height="92" Margin="0,0,8,0"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Cursor="Hand"
                                        SnapsToDevicePixels="True"
                                        MouseLeftButtonUp="OnImageTileClick" Tag="{Binding}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource L_ImgMenu_Open}" Tag="{Binding}" Click="OnImageMenuOpen"/>
                                            <MenuItem Header="{DynamicResource L_ImgMenu_SaveAs}" Tag="{Binding}" Click="OnImageMenuSaveAs"/>
                                            <MenuItem Header="{DynamicResource L_ImgMenu_Copy}" Tag="{Binding}" Click="OnImageMenuCopy"/>
                                            <Separator/>
                                            <MenuItem Header="{DynamicResource L_ImgMenu_Remove}" Tag="{Binding}" Click="OnImageMenuRemoveDraft"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static local:ChatImageTileState.Error}">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                                    <Setter Property="ToolTip" Value="{Binding ErrorText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>
                                        <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                        <!-- Preparing: полупрозрачный оверлей «Подготовка...» поверх тайла. -->
                                        <Border x:Name="PrepOverlay" Grid.RowSpan="2" Background="#99000000"
                                                CornerRadius="8" Visibility="Collapsed">
                                            <TextBlock Text="{DynamicResource L_ImagePreparing}"
                                                       Foreground="#E6FFFFFF" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Caption}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                   Margin="6,0" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <!-- Крестик удаления из черновика (ТЗ §3.8), поверх угла тайла. -->
<Button x:Name="DraftRemoveBtn" AutomationProperties.AutomationId="DraftRemoveBtn" Width="24" Height="24" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,3,3,0" Cursor="Hand" Tag="{Binding}"
                                                Click="OnImageDraftRemoveClick"
                                                ToolTip="{DynamicResource L_TT_ImageDraftRemove}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bb" Background="#99000000" CornerRadius="12">
                                                        <TextBlock Text="✕" Foreground="#E6FFFFFF" FontSize="10"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bb" Property="Background" Value="#CC444444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static local:ChatImageTileState.Preparing}">
                                        <Setter TargetName="PrepOverlay" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Строка-уведомление черновика (поддержка не подтверждена, исключения из
                     контекста — текст отдаёт ChatImageFlow.DraftNotice). -->
                <TextBlock x:Name="ImageDraftNotice" Margin="18,0,18,8" Visibility="Collapsed"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                           TextWrapping="Wrap"/>
                <!-- Поле секретного сообщения: скруглённый прямоугольник r14, высота строки 44
                     (рамка 1 + внутренние 12,5,5,5 + контент 32); кнопка-круг 32×32 справа. -->
                <Border Margin="18,8,18,0" Height="44" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,5,5,5">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" x:Name="ChatSendBtn" Click="OnChatSend"
                                Style="{StaticResource OverlaySendButton}"
                                Margin="6,0,0,0"
                                AutomationProperties.AutomationId="ChatSendBtn"
                                AutomationProperties.Name="{DynamicResource L_TT_ChatSend}"
                                ToolTip="{DynamicResource L_TT_ChatSend}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#ffffff" Data="M2.8 20.6L22 12 2.8 3.4l.6 6.8L16 12 3.4 13.8z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- Скрепка 36×36 (рисунок 20×20, зазор 6 до кнопки отправки — DockPanel
                             рисует правые элементы в обратном порядке объявления). Pressed-арт
                             подменяет PressedIconSwap (BuddyAttachment.Icon.Pressed). -->
                        <Button DockPanel.Dock="Right" x:Name="AttachFilesButton" Click="OnAttachFilesClick"
                                Width="36" Height="36" MinWidth="36" MinHeight="36" Padding="0" Cursor="Hand"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource L_TT_AttachFiles}"
                                ToolTip="{DynamicResource L_TT_AttachFiles}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="18" RenderTransformOrigin="0.5,0.5">
                                        <Image x:Name="Cp" Source="{DynamicResource BuddyAttachment.Icon.Default}"
                                               Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMediumBrush}"/>
                                            <Setter TargetName="Bd" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Grid VerticalAlignment="Center">
                            <!-- Высота текстового контрола 32 (MinHeight=0 — иначе неявный
                                 стиль TextBox вернул бы 36), Padding=0: отступ уже задал
                                 контейнер. PART_ContentHost не должен повторно брать Padding
                                 в Margin — двойной отступ. -->
                            <TextBox x:Name="ChatInputBox"
                                     Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                     BorderThickness="0" Padding="0" FontSize="14" FontWeight="Normal"
                                     Height="32" MinHeight="0"
                                     AutomationProperties.AutomationId="ChatInputBox"
                                     AutomationProperties.Name="{DynamicResource L_TT_ChatInput}"
                                     ToolTip="{DynamicResource L_TT_ChatInput}"
                                     KeyDown="OnChatInputKeyDown">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <!-- Подсказка-плейсхолдер: видна ТОЛЬКО в пустом нефокусном поле
                                 (MultiDataTrigger: Text="" И IsKeyboardFocusWithin=False).
                                 При фокусе прячется сразу — каретка больше не пересекает текст.
                                 IsHitTestVisible=False: клики проходят сквозь неё в TextBox. -->
                            <TextBlock x:Name="ChatInputHint" IsHitTestVisible="False" Text="{DynamicResource L_SecretHint}"
                                       Foreground="{DynamicResource TextDimBrush}" FontSize="14" Padding="0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=ChatInputBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ChatInputBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Нижняя панель: микрофон (=пауза аудио) + живая волна (RMS) + молния «Отправить».
                     Волна 03A: высота панели 44 (рамка 1 + внутренние 5 + контент), кнопки 24×24
                     по центру, круг отправки 32×32. MinHeight/MinWidth 24 на кнопках нужны:
                     глобальный неявный стиль Button тащит MinHeight=36 и растягивал их до 24×36. -->
                <Border Margin="18,8,18,12" Height="44" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Микрофон = «Мик выкл»: глушит ТОЛЬКО mic-канал, захват динамика живёт
                             (иконка/цвет меняется в RefreshMicMuteButton). Полная пауза — хоткей Ctrl+Shift+P. -->
                        <Button Grid.Column="0" x:Name="MicMuteButton" Click="OnMicMuteClick"
                                Width="24" Height="24" MinWidth="24" MinHeight="24" Cursor="Hand" ToolTip="{DynamicResource L_TT_MicMute}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Width="24" Height="24" CornerRadius="12"
                                            Background="{DynamicResource HoverBrush}" RenderTransformOrigin="0.5,0.5">
                                        <ContentPresenter x:Name="Cp" Content="{DynamicResource IconMic}" Width="16" Height="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- «LLM выкл» = чистый транскрибатор (золотая подсветка в RefreshLlmOffButton,
                             как у микрофона) -->
                        <Button Grid.Column="1" x:Name="LlmOffButton" Click="OnLlmOffClick"
                                Width="24" Height="24" MinWidth="24" MinHeight="24" Margin="4,0,0,0" Cursor="Hand" ToolTip="{DynamicResource L_TT_LlmOff}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Width="24" Height="24" CornerRadius="12"
                                            Background="{DynamicResource HoverBrush}" RenderTransformOrigin="0.5,0.5">
                                        <ContentPresenter x:Name="Cp" Content="{DynamicResource IconLlm}" Width="16" Height="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- «Динамик выкл» = глушить приём loopback (иконка Speaker/SpeakerOff
                             и подсветка меняются в RefreshSpeakerMuteButton) -->
                        <Button Grid.Column="2" x:Name="SpeakerMuteButton" Click="OnSpeakerMuteClick"
                                Width="24" Height="24" MinWidth="24" MinHeight="24" Margin="4,0,0,0" Cursor="Hand" ToolTip="{DynamicResource L_TT_SpeakerMute}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Width="24" Height="24" CornerRadius="12"
                                            Background="{DynamicResource HoverBrush}" RenderTransformOrigin="0.5,0.5">
                                        <ContentPresenter x:Name="Cp" Content="{DynamicResource IconSpeaker}" Width="16" Height="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Память: чип-индикатор состояния (иконка-чип; цвет = RefreshMemoryButton) -->
                        <Button Grid.Column="3" x:Name="MemoryButton" Click="OnMemoryClick"
                                Width="24" Height="24" MinWidth="24" MinHeight="24" Margin="4,0,0,0" Cursor="Hand" ToolTip="{DynamicResource L_MemToggle_Off}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Width="24" Height="24" CornerRadius="12"
                                            Background="{DynamicResource HoverBrush}" RenderTransformOrigin="0.5,0.5">
                                        <ContentPresenter x:Name="Cp" Content="{DynamicResource IconMemory}" Width="16" Height="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Живая волна: 24 бара, высоты обновляются из RMS в OnBlinkTick -->
                        <StackPanel Grid.Column="4" x:Name="LiveWave" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Height="24"/>
                        <!-- Молния = Отправить (перенесена из ряда действий) -->
                        <Button Grid.Column="5" x:Name="LiveSendBtn" Click="OnSendNow"
                                Style="{StaticResource OverlaySendButton}"
                                AutomationProperties.Name="{DynamicResource L_TT_SendNow}"
                                ToolTip="{DynamicResource L_TT_SendNow}"
                                Content="{DynamicResource IconSendNow}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</Window>

