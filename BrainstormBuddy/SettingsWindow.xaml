<Window x:Class="BrainstormBuddy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:BrainstormBuddy.Controls"
    Title="{DynamicResource L_Set_Title}"
        Icon="pack://application:,,,/Resources/Icons/app.ico"
        Width="720" Height="600"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="14"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>

        <!-- ========================================================== -->
        <!-- GLOBAL STYLES — dark theme, видимый текст                  -->
        <!-- ========================================================== -->

        <!-- TabItem: пункт сайдбара (навигация слева, как в дизайн-референсе).
             Активный пункт: подсветка + зелёная полоса слева + зелёный текст. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="3,0,0,0"
                                CornerRadius="0,6,6,0" MinHeight="40"
                                Padding="{TemplateBinding Padding}" Width="224">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="14" LineHeight="20" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       LineStackingStrategy="BlockLineHeight"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMediumBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMediumBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox: локальные setters поверх глобального шаблона волны 02
             (шаблон r8 + рамка фокуса 2px + авто-выравнивание AcceptsReturn→Top).
             Волна 08: рамка редактируемого поля — InputBorderBrush #657391,
             декоративный BorderBrush только у не-полевых контейнеров. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- TextBox многострочный (для системного промпта) -->
        <Style x:Key="MultilineTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="{StaticResource MultilineInputPadding}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="120"/>
        </Style>

        <!-- ComboBox/ComboBoxItem: локальные копии удалены — глобальный шаблон
             r10 из Resources/Styles.xaml покрывает весь контракт (PART_EditableTextBox,
             клик в любом месте поля, тёмный popup). Дубль держал r6-углы и дрожал от
             глобального стиля (кейс 2.12: «острые углы у селектора»). -->

        <!-- Button: тёмный, видимый. Шаблон — глобальный волны 02 (r8, hover
             HoverBrush + рамка AccentBrush, pressed BgBrush, фокус-рамка 2px внутри). -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BgMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Иконочные кнопки (32×32, изображение 20×20): глобальный IconButton +
             местная заливка окна настроек. Стиль выставляется явно на кнопке —
             переключать Style триггером по типу Content нельзя (WPF бросает
             InvalidOperationException при срабатывании триггера). -->
        <Style x:Key="SettingsIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource BgMediumBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <!-- PrimaryButton — глобальный (Resources/Styles.xaml). -->

        <!-- CheckBox: шаблон — глобальный волны 02 (квадрат 18×18 r4, галочка,
             indeterminate-штрих); тут только размер подписи. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextBlock.FontSize" Value="14"/>
            <Setter Property="TextBlock.LineHeight" Value="20"/>
            <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>


        <!-- bool → Visibility (для скрытия ручных настроек в авто-режиме) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Slider: без локального стиля — глобальный implicit Slider уже BasedOn
             GreenSlider (трек 4, бегунок 16×16, область 28). -->

        <!-- Label-style TextBlock -->
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Margin" Value="0,8,0,6"/>
        </Style>

        <!-- TabControl: левая навигация с вертикальной прокруткой. Стандартный
             шаблон WPF не даёт ScrollViewer вокруг TabPanel — 15 пунктов
             (~40 DIP каждый, всего ~603) обрезались в окне 460 (H06/C04).
             Шаблон рассчитан только на TabStripPlacement=Left; контракт
             выбранного содержимого сохранён: PART_SelectedContentHost +
             ContentSource="SelectedContent", TabPanel IsItemsHost=True.
             Клавиатурный фокус пункта докручивается автоматически через
             RequestBringIntoView → ScrollViewer. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <TabPanel x:Name="HeaderPanel" Panel.ZIndex="1" IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                            <Border Grid.Column="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox: тёмный фон, светлый текст. Без x:Key — глобально. -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- ListBoxItem: светлый текст на тёмном; selected = спокойная синяя
             заливка SelectedRowBrush + левая полоса AccentBrush 3px (волна 08),
             был заливкой AccentBrush. ControlTemplate override нужен иначе
             Aero-style рисует серое на голубом (BUG #24). -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.LineHeight="20"
                                              TextBlock.LineStackingStrategy="BlockLineHeight"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMediumBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SettingsSearchBox" Grid.Row="0" Grid.Column="0"
                         MinHeight="34" Padding="10,6"
                         ToolTip="{DynamicResource L_SetSearch_Placeholder}"
                         AutomationProperties.Name="{DynamicResource L_SetSearch_Label}"
                         TextChanged="OnSettingsSearchTextChanged"
                         PreviewKeyDown="OnSettingsSearchBoxPreviewKeyDown"/>
                <Button x:Name="SettingsSearchCloseBtn" Grid.Row="0" Grid.Column="1"
                        Content="{DynamicResource L_SetSearch_Close}" Margin="8,0,0,0"
                        Padding="12,0" MinHeight="34" Click="OnSettingsSearchClose"/>
                <Grid x:Name="SettingsSearchResultsPanel" Grid.Row="1" Grid.ColumnSpan="2"
                      Visibility="Collapsed" Margin="0,8,0,0">
                    <ListBox x:Name="SettingsSearchResultsList" MaxHeight="210"
                             MouseLeftButtonUp="OnSettingsSearchResultClick"
                             KeyDown="OnSettingsSearchResultsKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,1,2,1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Section}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="SettingsSearchEmptyText"
                               Text="{DynamicResource L_SetSearch_NoResults}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Padding="8" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left"
                    Margin="0"
                    Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    SelectionChanged="OnSettingsTabChanged">

            <!-- ====================== API ====================== -->
            <TabItem Header="{DynamicResource L_Tab_Api}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Api}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource L_SetApi_ProviderLabel}" Style="{StaticResource Label}"/>
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LlmProviderCombo" Grid.Column="0"
                                      ItemsSource="{Binding LlmProviders}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding ProviderId}"
                                      SelectionChanged="OnLlmProviderChanged"/>
                            <WrapPanel Grid.Column="1">
                                <Button x:Name="LlmProviderAddBtn" Style="{StaticResource SettingsIconButton}"
                                        Margin="8,0,0,0"
                                        Click="OnAddProvider" ToolTip="{DynamicResource L_SetApi_AddProviderHint}">
                                    <Image Source="{DynamicResource BuddySettings.Icon.Add.Default}" Width="20" Height="20"/>
                                </Button>
                                <Button x:Name="LlmProviderDuplicateBtn" Style="{StaticResource SettingsIconButton}"
                                        Margin="8,0,0,0"
                                        Click="OnDuplicateProvider" ToolTip="{DynamicResource L_SetApi_DupProviderHint}">
                                    <Image Source="{DynamicResource BuddySettings.Icon.Copy.Default}" Width="20" Height="20"/>
                                </Button>
                                <Button x:Name="LlmProviderDeleteBtn" Style="{StaticResource SettingsIconButton}"
                                        Margin="8,0,0,0"
                                        Click="OnDeleteProvider" ToolTip="{DynamicResource L_SetApi_DelProviderHint}" Visibility="Collapsed">
                                    <Image Source="{DynamicResource BuddySettings.Icon.Remove.Default}" Width="20" Height="20"/>
                                </Button>
                            </WrapPanel>
                        </Grid>
                        <StackPanel x:Name="ReasoningEffortRow" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource L_SetApi_ReasoningLabel}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ReasoningEffortCombo" SelectedValuePath="Tag"
                                      Width="170" HorizontalAlignment="Left"
                                      SelectionChanged="OnReasoningEffortChanged"
                                      ToolTip="{DynamicResource L_SetApi_ReasoningHint}">
                                <ComboBoxItem Content="{DynamicResource L_SetApi_EffortInherit}" Tag="inherit"/>
                                <ComboBoxItem Content="{DynamicResource L_SetApi_EffortNone}" Tag=""/>
                                <ComboBoxItem Content="low" Tag="low"/>
                                <ComboBoxItem Content="medium" Tag="medium"/>
                                <ComboBoxItem Content="high" Tag="high"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="LlmProviderPrivacyNote" TextWrapping="Wrap" Style="{StaticResource HelperText}"
                                   Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,20"
                                   Text="{DynamicResource L_SetApi_PrivacyHint}"/>

                        <!-- Редактор своего провайдера (custom-профиль): показывается при выборе/создании -->
                        <Border x:Name="LlmProviderEditPanel" Visibility="Collapsed"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Padding="10" Margin="0,0,0,20" Background="{DynamicResource PanelBrush}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_SetApi_CustomTitle}" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource L_SetApi_NameLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ProviderNameBox" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource L_SetApi_BaseUrlLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ProviderBaseUrlBox" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource L_SetApi_ProtocolLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ProviderProtocolCombo" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="OpenAI chat/completions" Tag="openai-chat"/>
                                            <ComboBoxItem Content="OpenAI responses" Tag="openai-responses"/>
                                            <ComboBoxItem Content="Anthropic messages" Tag="anthropic"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource L_SetApi_AuthLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ProviderAuthCombo" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Bearer (Authorization)" Tag="bearer"/>
                                            <ComboBoxItem Content="x-api-key" Tag="x-api-key"/>
                                            <ComboBoxItem Content="{DynamicResource L_SetApi_AuthNone}" Tag="none"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{DynamicResource L_SetApi_HeadersLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="ProviderHeadersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Column="3" Style="{StaticResource SettingsIconButton}"
                                                        Click="OnRemoveProviderHeader" Loaded="OnProviderHeaderRemoveBtnLoaded"
                                                        ToolTip="{DynamicResource L_SetApi_RemoveHeaderHint}">
                                                    <Image Source="{DynamicResource BuddySettings.Icon.Remove.Default}" Width="20" Height="20"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddHeaderBtn" Width="110" HorizontalAlignment="Left" Margin="0,0,0,8"
                                        Click="OnAddProviderHeader">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddySettings.Icon.Add.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_SetApi_AddHeader}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{DynamicResource L_SetApi_PresetsLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ProviderPresetsBox" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource L_SetApi_PrivacyNoteLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ProviderPrivacyBox" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,8"
                                         Padding="{StaticResource MultilineInputPadding}" VerticalContentAlignment="Top"/>
                                <WrapPanel>
                                    <Button Content="{DynamicResource L_Save}" Width="130" Margin="0,0,8,0" Click="OnSaveProvider" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="{DynamicResource L_Msg_Cancel}" Width="110" Margin="0,0,8,0" Click="OnCancelProviderEdit"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource L_SetApi_BaseUrlLabel}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ActiveBaseUrlBox" AutomationProperties.AutomationId="ActiveBaseUrlBox" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"
                                   Text="{DynamicResource L_SetApi_BaseUrlExample}"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ApiKeyBox" Grid.Column="0" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                            <!-- Ключ скрыт по умолчанию: SetApiKeyVisible(false) показывает это поле
                                 вместо ApiKeyBox. Текст ключа переносится между полями без потерь. -->
                            <PasswordBox x:Name="ApiKeyPwdBox" Grid.Column="0" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                         PasswordChanged="OnApiKeyPwdChanged" Visibility="Collapsed"/>
                            <Button x:Name="ApiKeyVisibilityBtn" Grid.Column="1" Style="{StaticResource SettingsIconButton}"
                                    Margin="8,0,0,0"
                                    Click="OnToggleApiKeyVisibility" ToolTip="{DynamicResource L_TT_ShowKey}"
                                    AutomationProperties.Name="{DynamicResource L_TT_ShowKey}">
                                <Image Source="{DynamicResource BuddySettings.Icon.Visibility.Default}" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"
                                   Text="{DynamicResource L_SetApi_ApiKeyHint}"/>

                        <TextBlock Text="{DynamicResource L_SetApi_ChatModelLabel}" Style="{StaticResource Label}"/>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ChatModelCombo" Grid.Column="0" IsEditable="True" IsTextSearchEnabled="False"
                                      Text="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button x:Name="FetchModelsBtn" Grid.Column="1" Style="{StaticResource SettingsIconButton}"
                                    Margin="8,0,0,0"
                                    Click="OnFetchModels" ToolTip="{DynamicResource L_SetApi_FetchModelsHint}">
                                <Image Source="{DynamicResource BuddySettings.Icon.Refresh.Default}" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ModelsStatusText" TextWrapping="Wrap" Style="{StaticResource HelperText}"
                                   Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,2" Visibility="Collapsed"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"
                                   Text="{DynamicResource L_SetApi_ModelExample}"/>
                        <!-- Поддержка изображений выбранной моделью (image-chat, спека §8):
                             кэшированный статус + ручной probe. -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="ImageSupportText" TextWrapping="Wrap" Style="{StaticResource HelperText}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"
                                           Text="{DynamicResource L_ImgProbeNote}"/>
                            </StackPanel>
                            <Button x:Name="ProbeImageSupportBtn" Grid.Column="1" Height="32" VerticalAlignment="Top"
                                    Margin="8,0,0,0" Click="OnProbeImageSupport"
                                    Style="{StaticResource CompactButton}">
                                <TextBlock Text="{DynamicResource L_ImgProbeBtn}"/>
                            </Button>
                        </Grid>
                        <!-- Настройки распознавания речи (STT) переехали в раздел «Распознавание речи (STT)».
                             Здесь остаётся только LLM (чат), чтобы не путать два разных сервера. -->
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,20"
                                   Text="{DynamicResource L_SetApi_SttHint}"/>

                        <TextBlock Text="{DynamicResource L_SetApi_RateLimitLabel}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="RateLimitBox" Text="{Binding RateLimitSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,20"/>

                        <WrapPanel>
                            <Button x:Name="CheckConnectionBtn" Click="OnCheckConnection" MinWidth="180" Margin="0,0,8,8"
                                    Style="{StaticResource PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{DynamicResource BuddySettings.Icon.Refresh.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource L_CheckConnection}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="ConnectionStatusText" Margin="0,0,0,8" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </WrapPanel>

                        <!-- Обнаружение локальных провайдеров: сканирование типичных мест,
                             где на этой машине уже есть ключ (Codex/ChatGPT, opencode,
                             переменные окружения), и подключение в один клик. -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,20,0,0"
                                Background="{DynamicResource PanelBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Text="{DynamicResource L_SetApi_DiscoverTitle}"
                                               Style="{StaticResource SectionTitleText}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <Button Grid.Column="1" x:Name="DiscoveryScanBtn" MinWidth="170"
                                            Style="{StaticResource CompactButton}" Click="OnDiscoveryScan">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{DynamicResource BuddySettings.Icon.Refresh.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource L_SetApi_DiscoverScan}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,8"
                                           Text="{DynamicResource L_SetApi_DiscoverHint}"/>
                                <TextBlock x:Name="DiscoveryStatusText" TextWrapping="Wrap"
                                           Style="{StaticResource HelperText}" Visibility="Collapsed"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="DiscoveryItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1" Padding="0,8,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrightBrush}"/>
                                                        <TextBlock Text="{Binding StateLabel}" FontSize="12"
                                                                   TextWrapping="Wrap" Margin="0,1,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Found">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Unsupported">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11"
                                                                   Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                                    Visibility="{Binding ModelsVisibility}">
                                                            <ComboBox Width="260" ItemsSource="{Binding Models}"
                                                                      SelectedItem="{Binding SelectedModel}"
                                                                      AutomationProperties.Name="{DynamicResource L_SetApi_DiscoverModelsTitle}"/>
                                                            <Button Margin="8,0,0,0" Style="{StaticResource CompactButton}"
                                                                    Content="{DynamicResource L_SetApi_DiscoverApplyModel}"
                                                                    Click="OnDiscoveryApplyModel"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ModelsStatus}" FontSize="11" Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding ModelsStatusVisibility}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ModelsFailed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                                                        <Button MinWidth="120" Style="{StaticResource CompactButton}"
                                                        Content="{DynamicResource L_SetApi_DiscoverConnect}"
                                                        Click="OnDiscoveryConnect"
                                                        Visibility="{Binding CanApplyVisibility}"/>
                                                        <TextBlock Text="{DynamicResource L_SetApi_DiscoverConnected}"
                                                                   VerticalAlignment="Center" FontSize="12"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding ConnectedVisibility}"/>
                                                        <Button Margin="8,0,0,0" Style="{StaticResource CompactButton}"
                                                                Content="{DynamicResource L_SetApi_DiscoverModelsBtn}"
                                                                Click="OnDiscoveryLoadModels"
                                                                Visibility="{Binding ModelsButtonVisibility}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== LLM (промпты) ====================== -->
            <TabItem Header="{DynamicResource L_Tab_Llm}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Llm}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <b:TwoPanePanel Breakpoint="560" FirstFraction="0.4" Gap="16">
                            <!-- Список пресетов -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12" VerticalAlignment="Top">
                                <!-- Волна 03: список MinHeight=240 в двухпанельной (ширина ≥560),
                                     144 в стопке. Базовое значение в триггере на IsStackedMode. -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- MinHeight на Border, не на ListBox — иначе у списка
                                             MinHeight < высоты контента давал бы мёртвую зону. -->
                                        <Setter Property="MinHeight" Value="240"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(b:TwoPanePanel.IsStackedMode), RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="MinHeight" Value="144"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{DynamicResource L_SetLlm_PresetsTitle}" Style="{StaticResource SectionTitleText}"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                    <!-- Grid *-строка: список занимает ровно свой контент и не
                                         растягивается сверх меры (DockPanel/LastChildFill давал
                                         мёртвую зону под пунктами + обрезал последнюю строку). -->
                                    <ListBox Grid.Row="1" x:Name="PresetsList" ItemsSource="{Binding SystemPromptPresets}"
                                             SelectedItem="{Binding SelectedSystemPromptPreset}"
                                             DisplayMemberPath="Name"
                                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrightBrush}"
                                             BorderThickness="0" VerticalAlignment="Top"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Grid>
                            </Border>

                            <!-- Редактор промпта -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12" MinHeight="240">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{DynamicResource L_SetLlm_PresetNameLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <TextBox Grid.Row="1" x:Name="PresetNameBox" Margin="0,0,0,8"
                                             Text="{Binding SelectedSystemPromptPreset.Name, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"/>
                                    <TextBox Grid.Row="2" x:Name="PromptEditor" MaxHeight="360"
                                             Style="{StaticResource MultilineTextBox}"
                                             Text="{Binding CurrentSystemPrompt, UpdateSourceTrigger=PropertyChanged}"/>
                                    <!-- Кнопки управления пресетами -->
                                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                        <Button x:Name="SaveAsNewPromptBtn" Click="OnSaveAsNewPrompt" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{DynamicResource BuddySettings.Icon.Add.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource L_SetLlm_SaveAsNew}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DeletePresetBtn" Click="OnDeletePrompt" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{DynamicResource BuddySettings.Icon.Delete.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource L_SetLlm_DeletePreset}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="NewEmptyPromptBtn" Click="OnNewEmptyPrompt" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{DynamicResource BuddySettings.Icon.Add.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource L_SetLlm_NewEmpty}"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="PresetFlash" Text="{DynamicResource L_Set_PresetUpdated}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"
                                                   TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </b:TwoPanePanel>

                        <StackPanel Margin="0,28,0,0">
                            <CheckBox Content="{DynamicResource L_SetLlm_MergeMicLoop}"
                                      IsChecked="{Binding MergeMicLoopback}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="StreamLlmCheck" Content="{DynamicResource L_StreamLlm}"
                                      IsChecked="{Binding StreamLlmAnswersVm}" Margin="0,0,0,8"
                                      ToolTip="{DynamicResource L_StreamLlmHint}"/>
                            <TextBlock Text="{DynamicResource L_SetLlm_HistorySizeLabel}" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                            <Slider x:Name="HistorySizeSlider" Minimum="2" Maximum="20"
                                    Value="{Binding HistorySize, Mode=TwoWay}"
                                    TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8">
                                <Run Text="{DynamicResource L_Set_CurrentN}"/>
                                <Run Text="{Binding Value, ElementName=HistorySizeSlider, Mode=OneWay, StringFormat=F0}" Foreground="{DynamicResource AccentBrush}"/>
                                <Run Text="{DynamicResource L_SetLlm_HistorySizeNote}" Foreground="{DynamicResource TextMutedBrush}"/>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource L_SetLlm_MaxTokensLabel}" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                            <TextBox x:Name="MaxTokensBox" Width="120" HorizontalAlignment="Left"
                                     ToolTip="{DynamicResource L_SetLlm_MaxTokensHint}"
                                     LostFocus="OnMaxTokensCommit" KeyDown="OnMaxTokensKeyDown"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                                Text="{DynamicResource L_Llm_MaxTokens_Hint}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Аудио ====================== -->
            <TabItem Header="{DynamicResource L_Tab_Audio}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Audio}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource L_SetAudio_EndpointModeLabel}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="EndpointModeCombo" SelectedValue="{Binding SelectedEndpointModeId}" SelectedValuePath="Tag" Margin="0,2,0,2"
                                  ToolTip="{DynamicResource L_SetAudio_EndpointModeHint}">
                            <ComboBoxItem Content="{DynamicResource L_SetAudio_ModeManual}" Tag="manual"/>
                            <ComboBoxItem Content="{DynamicResource L_SetAudio_ModeAdaptive}" Tag="adaptive"/>
                            <ComboBoxItem Content="{DynamicResource L_SetAudio_ModeSemantic}" Tag="semantic"/>
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,20">
                            <Run Text="{DynamicResource L_SetAudio_ModeManualB}" FontWeight="Bold"/><Run Text="{DynamicResource L_SetAudio_ModeManualHint}"/><LineBreak/>
                            <Run Text="{DynamicResource L_SetAudio_ModeAdaptiveB}" FontWeight="Bold"/><Run Text="{DynamicResource L_SetAudio_ModeAdaptiveHint}"/><LineBreak/>
                            <Run Text="{DynamicResource L_SetAudio_ModeSemanticB}" FontWeight="Bold"/><Run Text="{DynamicResource L_SetAudio_ModeSemanticHint}"/><LineBreak/>
                            <Run Text="{DynamicResource L_SetAudio_ModeAutoNote}" Foreground="{DynamicResource TextMutedBrush}"/>
                        </TextBlock>

                        <!-- Живое значение авто-паузы (только в авто-режимах; обновляется таймером) -->
                        <TextBlock x:Name="AutoPauseLive" Visibility="Collapsed" Style="{StaticResource HelperText}" Margin="0,0,0,20">
                            <Run Text="{DynamicResource L_SetAudio_LivePauseLabel}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Run x:Name="AutoPauseLoopRun" Text="—" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                 FontFamily="{DynamicResource MonoFont}"/>
                            <Run Text="{DynamicResource L_SetAudio_LiveSpeaker}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Run x:Name="AutoPauseMicRun" Text="—" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                 FontFamily="{DynamicResource MonoFont}"/>
                            <Run Text="{DynamicResource L_SetAudio_LiveMic}" Foreground="{DynamicResource TextMutedBrush}"/>
                        </TextBlock>

                        <!-- Пресет аудио — только в ручном режиме (в авто ПО подбирает пороги само) -->
                        <StackPanel Visibility="{Binding IsManualEndpoint, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource L_SetAudio_PresetLabel}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="AudioPresetCombo" SelectedValue="{Binding SelectedAudioPresetId}" SelectedValuePath="Tag" Margin="0,2,0,20">
                                <ComboBoxItem Content="{DynamicResource L_SetAudio_PresetCustom}" Tag="custom"/>
                                <ComboBoxItem Content="{DynamicResource L_SetAudio_PresetStandard}" Tag="standard"/>
                                <ComboBoxItem Content="{DynamicResource L_SetAudio_PresetFast}" Tag="fast"/>
                                <ComboBoxItem Content="{DynamicResource L_SetAudio_PresetSlow}" Tag="slow"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource L_SetAudio_MicLabel}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="MicDeviceCombo" Margin="0,2,0,12"/>

                        <!-- Тест микрофона: кнопка + 6 вертикальных полосок-индикаторов уровня -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
                            <StackPanel>
                                <b:TwoPanePanel Breakpoint="360" Gap="12">
                                    <Button x:Name="MicTestButton" Content="{DynamicResource L_SetAudio_MicTestStart}"
                                            Click="OnMicTestToggle" HorizontalAlignment="Left"/>
                                    <!-- 6 полосок уровня -->
                                    <StackPanel x:Name="MicLevelBars" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                Height="34">
                                        <Border Width="7" Height="8"  CornerRadius="2" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                                        <Border Width="7" Height="13" CornerRadius="2" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                                        <Border Width="7" Height="19" CornerRadius="2" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                                        <Border Width="7" Height="24" CornerRadius="2" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                                        <Border Width="7" Height="29" CornerRadius="2" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                                        <Border Width="7" Height="34" CornerRadius="2" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </b:TwoPanePanel>
                                <TextBlock x:Name="MicTestHint" Text="{DynamicResource L_SetAudio_MicTestHint}"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <CheckBox IsChecked="{Binding CaptureMic, Mode=TwoWay}" Margin="0,10,0,0">
                                    <TextBlock Text="{DynamicResource L_SetAudio_ListenMic}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource L_SetAudio_SpeakerLabel}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="SpeakerDeviceCombo" Margin="0,2,0,20"/>

                        <!-- Порог тишины — только в ручном режиме (в авто его ведёт контроллер пауз).
                             Остальные параметры ниже НЕ управляются автоматикой и видны всегда. -->
                        <StackPanel Visibility="{Binding IsManualEndpoint, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource L_SetAudio_SilenceMsLabel}" Style="{StaticResource Label}"/>
                        <Slider Minimum="500" Maximum="2500"
                                Value="{Binding SilenceThresholdMs, Mode=TwoWay}"
                                TickFrequency="100" IsSnapToTickEnabled="True"
                                Margin="0,4,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                                <Run Text="{DynamicResource L_Set_CurrentN}"/>
                                <Run x:Name="SilenceMsRun" Text="1200" Foreground="{DynamicResource AccentBrush}"/>
                                <Run Text="{DynamicResource L_Set_UnitMs}"/>
                            </TextBlock>
                        </StackPanel>
                        </StackPanel>
                        <!-- /скрыто в авто -->

                        <TextBlock Text="{DynamicResource L_SetAudio_MinSpeechLabel}" Style="{StaticResource Label}"/>
                        <Slider Minimum="200" Maximum="1500"
                                Value="{Binding MinSpeechMsUi, Mode=TwoWay}"
                                TickFrequency="100" IsSnapToTickEnabled="True"
                                Margin="0,4,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                                <Run Text="{DynamicResource L_Set_CurrentN}"/>
                                <Run x:Name="MinSpeechMsRun" Text="1500" Foreground="{DynamicResource AccentBrush}"/>
                                <Run Text="{DynamicResource L_Set_UnitMs}"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource L_SetAudio_PreRollLabel}" Style="{StaticResource Label}"/>
                        <Slider Minimum="100" Maximum="500"
                                Value="{Binding PreRollMsUi, Mode=TwoWay}"
                                TickFrequency="50" IsSnapToTickEnabled="True"
                                Margin="0,4,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                                <Run Text="{DynamicResource L_Set_CurrentN}"/>
                                <Run x:Name="PreRollMsRun" Text="300" Foreground="{DynamicResource AccentBrush}"/>
                                <Run Text="{DynamicResource L_Set_UnitMs}"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource L_SetAudio_PostRollLabel}" Style="{StaticResource Label}"/>
                        <Slider Minimum="100" Maximum="500"
                                Value="{Binding PostRollMsUi, Mode=TwoWay}"
                                TickFrequency="50" IsSnapToTickEnabled="True"
                                Margin="0,4,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                                <Run Text="{DynamicResource L_Set_CurrentN}"/>
                                <Run x:Name="PostRollMsRun" Text="300" Foreground="{DynamicResource AccentBrush}"/>
                                <Run Text="{DynamicResource L_Set_UnitMs}"/>
                            </TextBlock>
                        </StackPanel>

                        <CheckBox Content="{DynamicResource L_SetAudio_AutoCalibrate}"
                                  IsChecked="{Binding AutoCalibrateThreshold, Mode=TwoWay}"
                                  Margin="0,8,0,0"
                                  ToolTip="{DynamicResource L_SetAudio_AutoCalibrateHint}"/>

                        <TextBlock Text="{DynamicResource L_SetAudio_RmsLabel}" Style="{StaticResource Label}"
                                   ToolTip="{DynamicResource L_SetAudio_RmsHint}"/>
                        <Slider x:Name="RmsSlider" Minimum="0.001" Maximum="0.1"
                                Value="{Binding RmsThreshold, Mode=TwoWay}"
                                IsEnabled="{Binding ManualThreshold}"
                                TickFrequency="0.005" IsSnapToTickEnabled="False"
                                Margin="0,4,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,20">
                            <Ellipse x:Name="RmsLiveIndicator" Width="10" Height="10" Margin="0,0,6,0"
                                     VerticalAlignment="Center" Fill="{DynamicResource TextMutedBrush}"/>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                                <Run Text="{DynamicResource L_SetAudio_RmsLiveLabel}"/>
                                <Run x:Name="CurrentRmsRun" Text="0.000" Foreground="{DynamicResource TextBrightBrush}" FontFamily="{DynamicResource MonoFont}"/>
                                <Run Text="{DynamicResource L_SetAudio_RmsThresholdLabel}"/>
                                <Run x:Name="RmsThresholdRun" Text="0.015" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource MonoFont}"/>
                                <Run Text="{DynamicResource L_SetAudio_RmsLiveNote}"/>
                            </TextBlock>
                        </StackPanel>

                        <CheckBox Content="{DynamicResource L_SetAudio_MicOnly}"
                                  IsChecked="{Binding MicOnly}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource L_SetAudio_VadLabel}" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="VadModeCombo" SelectedIndex="{Binding VadModeUi}" Margin="0,2,0,20"
                                  ToolTip="{DynamicResource L_SetAudio_VadHint}">
                            <ComboBoxItem Content="{DynamicResource L_SetAudio_Vad0}"/>
                            <ComboBoxItem Content="{DynamicResource L_SetAudio_Vad1}"/>
                            <ComboBoxItem Content="{DynamicResource L_SetAudio_Vad2}"/>
                            <ComboBoxItem Content="{DynamicResource L_SetAudio_Vad3}"/>
                        </ComboBox>
                        <CheckBox Content="{DynamicResource L_SetAudio_DebugLogs}"
                                  IsChecked="{Binding EnableDebugLogs}"
                                  Margin="0,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Транскрибация файла ====================== -->
            <TabItem x:Name="FileTranscriptionTab" Header="{DynamicResource L_Set_FileTranscribeTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_File}" Style="{StaticResource PageTitleText}"
                                   Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource BodyText}" Margin="0,0,0,20"
                                   Text="{DynamicResource L_SetFile_Desc}"/>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Style="{StaticResource BodyText}" Margin="0,0,0,12"
                                           Text="{DynamicResource L_SetFile_InnerNote}"/>
                                <Button x:Name="OpenFileTranscriptionBtn"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                        Click="OnOpenFileTranscription">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_SetFile_OpenBtn}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- No62: системный промпт AI-саммари (Advanced.SummaryPrompt); пусто = встроенный дефолт -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Sum_PromptLabel}" Style="{StaticResource SectionTitleText}"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="{DynamicResource L_Sum_PromptHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextDimBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                                <TextBox x:Name="SummaryPromptBox" MinHeight="90" AcceptsReturn="True" Style="{StaticResource MultilineInputText}"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding SummaryPrompt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                <Button x:Name="SummaryPromptResetBtn" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Click="OnSummaryPromptReset">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddySettings.Icon.Refresh.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_Sum_PromptReset}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Локальный STT (Docker) ====================== -->
            <TabItem Header="{DynamicResource L_Tab_LocalStt}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Stt}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <!-- Экспресс-проверка оборудования -->
                        <TextBlock Text="{DynamicResource L_SetStt_HwCheckTitle}" Style="{StaticResource SectionTitleText}"
                                   Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,10"
                                           Text="{DynamicResource L_SetStt_HwCheckHint}"/>
                                <Button x:Name="HwCheckBtn" Click="OnHwCheck" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddySettings.Icon.Refresh.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_SetStt_HwCheckBtn}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="HwVerdict" Text="" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" LineHeight="20"
                                           Margin="0,12,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="HwSpecs" Text="" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="HwRec" Text="" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" LineHeight="20" Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Встроенный движок (GigaAM ONNX) — без Docker -->
                        <TextBlock Text="{DynamicResource L_SetStt_EngineTitle}" Style="{StaticResource SectionTitleText}"
                                   Foreground="{DynamicResource TextDimBrush}" Margin="0,28,0,12"/>
                        <TextBlock Text="{DynamicResource L_SetStt_EngineLabel}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="SttEngineCombo" SelectedValuePath="Tag" Margin="0,8,0,8"
                                  SelectionChanged="OnSttEngineChanged">
                            <ComboBoxItem Content="{DynamicResource L_SetStt_EngNative3}" Tag="native3"/>
                            <ComboBoxItem Content="{DynamicResource L_SetStt_EngNative}" Tag="native"/>
                            <ComboBoxItem Content="{DynamicResource L_SetStt_EngWhisper}" Tag="whisper"/>
                            <ComboBoxItem Content="{DynamicResource L_SetStt_EngDocker}" Tag="docker"/>
                            <ComboBoxItem Content="{DynamicResource L_SetStt_EngRemote}" Tag="remote"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource L_SetStt_EngineApplyNote}"
                                   Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" TextWrapping="Wrap"/>

                        <!-- Настройки GigaAM — видны ТОЛЬКО когда движок = GigaAM -->
                        <StackPanel x:Name="GigaamSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource L_SetStt_GigaamTitle}" Style="{StaticResource SectionTitleText}"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,28,0,12"/>
                            <TextBlock Text="{DynamicResource L_SetStt_AccelLabel}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="SttAccelCombo" SelectedValuePath="Tag" Margin="0,8,0,0"
                                      SelectionChanged="OnSttAccelChanged">
                                <ComboBoxItem Content="{DynamicResource L_SetStt_AccelCpu}" Tag="cpu"/>
                                <ComboBoxItem Content="{DynamicResource L_SetStt_AccelDml}" Tag="directml"/>
                                <ComboBoxItem Content="{DynamicResource L_SetStt_AccelAuto}" Tag="auto"/>
                            </ComboBox>

                            <StackPanel x:Name="SttGpuPanel" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource L_SetStt_GpuLabel}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="SttGpuCombo" Margin="0,8,0,6" SelectionChanged="OnSttGpuChanged"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}"
                                       Text="{DynamicResource L_SetStt_GpuNote}"/>

                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="GigaamModelStatus" TextWrapping="Wrap" FontWeight="SemiBold"
                                               FontSize="13" LineHeight="20" Margin="0,0,0,8" Text=""/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button x:Name="SttDownloadBtn" Content="{DynamicResource L_SetStt_GigaamDownloadBtn}" Click="OnSttDownloadModel"
                                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
                                        <Button x:Name="GigaamDeleteBtn" Click="OnGigaamDeleteModel"
                                                Margin="0,0,8,0" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{DynamicResource BuddySettings.Icon.Delete.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource L_SetStt_DeleteModel}"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="SttDownloadStatus" Text="" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12"/>
                                    </WrapPanel>
                                    <ProgressBar x:Name="SttDownloadBar" Height="6" Minimum="0" Maximum="1" Value="0"
                                                 Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <TextBlock Text="{DynamicResource L_SetStt_GigaamModelNote}"
                                               Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Whisper: настройки видны ТОЛЬКО когда движок = Whisper (не путаем юзера) -->
                        <StackPanel x:Name="WhisperSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource L_SetStt_WhisperTitle}" Style="{StaticResource SectionTitleText}"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,28,0,12"/>
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,10"
                                               Text="{DynamicResource L_SetStt_WhisperDesc}"/>
                                    <StackPanel x:Name="WhisperAccelPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource L_SetStt_WhisperAccelLabel}" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="WhisperAccelCombo" SelectedValuePath="Tag" Margin="0,8,0,0"
                                                  SelectionChanged="OnWhisperAccelChanged">
                                            <ComboBoxItem Content="{DynamicResource L_SetStt_WAccelAuto}" Tag="auto"/>
                                            <ComboBoxItem Content="{DynamicResource L_SetStt_WAccelCpu}" Tag="cpu"/>
                                            <ComboBoxItem Content="{DynamicResource L_SetStt_WAccelGpu}" Tag="gpu"/>
                                        </ComboBox>
                                        <StackPanel x:Name="WhisperGpuPanel" Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource L_SetStt_GpuLabel}" Style="{StaticResource Label}"/>
                                            <ComboBox x:Name="WhisperGpuCombo" Margin="0,8,0,6" SelectionChanged="OnWhisperGpuChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Один статус: скачана ↔ не скачана (взаимоисключающе) — после параметров движка -->
                                    <TextBlock x:Name="WhisperModelStatus" TextWrapping="Wrap" FontWeight="SemiBold"
                                               FontSize="13" LineHeight="20" Margin="0,12,0,8" Text=""/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button x:Name="WhisperDownloadBtn" Content="{DynamicResource L_SetStt_WhisperDownloadBtn}" Click="OnWhisperDownloadModel"
                                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
                                        <Button x:Name="WhisperDeleteBtn" Click="OnWhisperDeleteModel"
                                                Margin="0,0,8,0" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{DynamicResource BuddySettings.Icon.Delete.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource L_SetStt_DeleteModel}"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="WhisperDownloadStatus" Text="" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12"/>
                                    </WrapPanel>
                                    <ProgressBar x:Name="WhisperDownloadBar" Height="6" Minimum="0" Maximum="1" Value="0"
                                                 Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <TextBlock Text="{DynamicResource L_SetStt_WhisperModelNote}"
                                               Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,28,0,0">
                            <StackPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button x:Name="SttSpeedTestBtn" Content="{DynamicResource L_SetStt_SpeedTestBtn}" Click="OnSttSpeedTest" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="SttSpeedResult" Text="—" VerticalAlignment="Center" Margin="0,0,8,0"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="12"/>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource L_SetStt_SpeedTestHint}"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Docker-сервер — виден ТОЛЬКО когда движок = Внешний сервер / Docker -->
                        <StackPanel x:Name="DockerSettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource L_SetStt_DockerTitle}" Style="{StaticResource SectionTitleText}"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   Margin="0,28,0,12"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8"
                                   Text="{DynamicResource L_SetStt_DockerDesc}"/>

                        <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"
                                   Text="{DynamicResource L_SetStt_DockerNote}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="LocalSttStatusDot" Width="10" Height="10" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LocalSttStatusText" Text="{DynamicResource L_SetStt_StatusStopped}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13" LineHeight="20"/>
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,16">
                            <Button x:Name="LocalSttStartBtn" Content="{DynamicResource L_SetStt_StartBtn}" Style="{StaticResource PrimaryButton}" Width="110" Click="OnLocalSttStart" Margin="0,0,8,0"/>
                            <Button x:Name="LocalSttStopBtn" Content="{DynamicResource L_SetStt_StopBtn}" Width="110" Click="OnLocalSttStop" Margin="0,0,8,0"/>
                            <Button x:Name="LocalSttRemoveBtn" Width="100" Click="OnLocalSttRemove" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{DynamicResource BuddySettings.Icon.Delete.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource L_SetStt_RemoveBtn}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LocalSttPingBtn" Width="80" Click="OnLocalSttPing" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{DynamicResource BuddySettings.Icon.Refresh.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource L_SetStt_PingBtn}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock Text="{DynamicResource L_SetStt_MetricsTitle}" Style="{StaticResource SectionTitleText}"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="LocalSttStatsText" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" Text="CPU: -   RAM: -   ping: -   uptime: -"/>

                        <TextBlock Text="{DynamicResource L_SetStt_BuildLogTitle}" Style="{StaticResource SectionTitleText}"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   Margin="0,16,0,8"/>
                        <TextBox x:Name="LocalSttLogBox" IsReadOnly="True" Height="180"
                                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                 Background="{DynamicResource BgDarkerBrush}" Foreground="{DynamicResource TextBrush}"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- Внешний сервер — виден ТОЛЬКО когда движок = Внешний сервер (свой адрес) -->
                        <StackPanel x:Name="RemoteUrlPanel" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource L_SetStt_RemoteTitle}" Style="{StaticResource SectionTitleText}"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,28,0,12"/>
                            <TextBlock Text="{DynamicResource L_SetStt_RemoteUrlLabel}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding SttBaseUrl, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,8,0,12"
                                     ToolTip="{DynamicResource L_SetStt_RemoteUrlHint}"/>
                            <TextBlock Text="{DynamicResource L_SetStt_RemoteModelLabel}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding SttModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8"
                                     ToolTip="{DynamicResource L_SetStt_RemoteModelHint}"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{DynamicResource L_SetStt_RemoteNote}"/>
                        </StackPanel>

                        <!-- Спикеры (диаризация) — отдельная группа внизу вкладки STT -->
                        <TextBlock Text="{DynamicResource L_SpeakerDiar_Group}" Style="{StaticResource SectionTitleText}"
                                   Foreground="{DynamicResource TextDimBrush}" Margin="0,28,0,12"/>
                        <CheckBox Content="{DynamicResource L_SpeakerDiar_Enabled}"
                                  IsChecked="{Binding SpeakerDiarizationEnabled}"
                                  Margin="0,0,0,8"/>

                        <!-- Бэкенд nemo-speech — показываем только при включённой диаризации -->
                        <StackPanel Visibility="{Binding SpeakerDiarizationEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource L_SpeakerDiar_Backend}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="SpeakerBackendCombo" SelectedValuePath="Tag"
                                      SelectedValue="{Binding SpeakerBackend, Mode=TwoWay}" Margin="0,8,0,6">
                                <ComboBoxItem Content="{DynamicResource L_SpeakerDiar_Backend_Auto}" Tag="auto"/>
                                <ComboBoxItem Content="CPU" Tag="cpu"/>
                                <ComboBoxItem Content="Vulkan (GPU)" Tag="vulkan"/>
                                <ComboBoxItem Content="CUDA (NVIDIA)" Tag="cuda"/>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource L_SpeakerDiar_Backend_Hint}"
                                       TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,8,0,6">
                            <Run Text="{DynamicResource L_SpeakerDiar_Status}"/>
                            <Run Text="{Binding SpeakerStatusText, Mode=OneWay}" Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource L_SpeakerDiar_Hint}"
                                   TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Оверлей ====================== -->
            <TabItem Header="{DynamicResource L_Tab_Overlay}">
                <ScrollViewer x:Name="OverlaySection" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Overlay}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource L_SetOvl_OpacityLabel}" Style="{StaticResource Label}"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1.0"
                                Value="{Binding WindowOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="0.05" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run x:Name="CurrentOpacityRun"
                                 Text="{Binding Value, ElementName=OpacitySlider, StringFormat=F2}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetOvl_PositionLabel}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <ComboBox x:Name="PositionCombo" SelectedValue="{Binding WindowPosition}" SelectedValuePath="Tag" Margin="0,8,0,0">
                            <ComboBoxItem Content="{DynamicResource L_Set_PosTopRight}" Tag="TopRight"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_PosTopLeft}" Tag="TopLeft"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_PosBottomRight}" Tag="BottomRight"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_PosBottomLeft}" Tag="BottomLeft"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_PosCenter}" Tag="Center"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_PosCustom}" Tag="Custom"/>
                        </ComboBox>
                        <CheckBox Content="{DynamicResource L_SetOvl_RememberGeometry}"
                                  IsChecked="{Binding RememberWindowGeometry}"
                                  Margin="0,12,0,0"/>

                        <CheckBox Content="{DynamicResource L_SetOvl_CompatBorder}"
                                  IsChecked="{Binding ShowCompatibilityBorder}"
                                  Margin="0,20,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetOvl_ClickThrough}"
                                  IsChecked="{Binding ClickThrough}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetOvl_TechLine}"
                                  IsChecked="{Binding ShowTimingLine}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetOvl_QTechLine}"
                                  IsChecked="{Binding ShowQuestionTimingLine}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetOvl_SessionStats}"
                                  IsChecked="{Binding ShowSessionStats}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetOvl_ShowMeetingSources}"
                                  IsChecked="{Binding ShowMeetingSources}"
                                  ToolTip="{DynamicResource L_SetOvl_ShowMeetingSourcesHint}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource L_SetOvl_ShowMeetingSourcesHint}"
                                   TextWrapping="Wrap" Style="{StaticResource HelperText}"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>

                        <CheckBox x:Name="EngineerModeCheck" Content="{DynamicResource L_SetOvl_EngineerMode}"
                                  IsChecked="{Binding EngineerMode}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource L_SetOvl_EngineerModeHint}"
                                   TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}"/>

                        <CheckBox Content="{DynamicResource L_HideTrayIcon}"
                                  IsChecked="{Binding HideTrayIcon}"
                                  Margin="0,12,0,6"/>
                        <TextBlock Text="{DynamicResource L_HideTrayIconHint}"
                                   TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}"/>

                        <TextBlock Text="{DynamicResource L_SetOvl_StealthLabel}"
                                   Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <TextBox Text="{Binding StealthProcessName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="60" Margin="0,8,0,6"
                                 ToolTip="{DynamicResource L_SetOvl_StealthHint}"/>
                        <TextBlock Text="{DynamicResource L_SetOvl_StealthNote}"
                                   TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{DynamicResource L_Ui_PauseMarkerLabel}"
                                   Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <TextBox Text="{Binding PauseResumeMarker, UpdateSourceTrigger=LostFocus}"
                                 MaxLength="80" Margin="0,8,0,6"
                                 ToolTip="{DynamicResource L_Ui_PauseMarkerHint}"/>
                        <TextBlock Text="{DynamicResource L_Ui_PauseMarkerNote}"
                                   TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{DynamicResource L_SetOvl_FontSizeLabel}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="22"
                                Value="{Binding FontSize, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=FontSizeSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                            <Run Text="pt"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource L_Ui_MaxAnswerChars}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <TextBox x:Name="MaxAnswerCharsBox" Width="90" HorizontalAlignment="Left"
                                 Margin="0,8,0,6"
                                 Text="{Binding MaxAnswerChars, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="{DynamicResource L_Ui_MaxAnswerCharsHint}"
                                   TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}"/>

                        <TextBlock Text="{DynamicResource L_Ui_BubblePadding}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="BubblePaddingSlider" Minimum="0" Maximum="40"
                                Value="{Binding BubblePadding, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=BubblePaddingSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                            <Run Text="px"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource L_Ui_BubblePaddingHint}"
                                   TextWrapping="Wrap" Style="{StaticResource HelperText}" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{DynamicResource L_Theme}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <!-- SelectedValuePath=Tag: Content — только локализованная подпись,
                             в конфиг и App.ApplyTheme уходит Tag («HackerTheme»). -->
                        <ComboBox x:Name="ThemeCombo" SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Margin="0,8,0,0">
                            <ComboBoxItem Content="{DynamicResource L_Set_ThemeDark}" Tag="HackerTheme"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_ThemeLight}" Tag="LightTheme"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource L_Language}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <ComboBox x:Name="LanguageCombo" SelectedValuePath="Tag" Margin="0,8,0,0" SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem Content="Русский" Tag="ru"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource L_Set_ExportFolderLabel}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource L_Set_ExportFolderHint}"/>
                            <Button x:Name="BrowseSavePathBtn" Grid.Column="1" Style="{StaticResource SettingsIconButton}" Click="OnBrowseSavePath"
                                    ToolTip="{DynamicResource L_Set_BrowseFolderHint}">
                                <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Караоке (телесуфлёр) ====================== -->
            <TabItem Header="{DynamicResource L_Tab_Karaoke}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Karaoke}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <CheckBox x:Name="KaraokeEnabledCheck" Content="{DynamicResource L_SetKar_Enable}"
                                  IsChecked="{Binding KaraokeEnabled}"
                                  Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource L_SetKar_Position}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="KaraokePositionCombo" SelectedValue="{Binding KaraokePosition}" SelectedValuePath="Tag" Margin="0,8,0,0">
                            <ComboBoxItem Content="{DynamicResource L_Set_PosBottom}" Tag="Bottom"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_PosTop}" Tag="Top"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_PosLeft}" Tag="Left"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_PosRight}" Tag="Right"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource L_SetKar_Align}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <ComboBox SelectedValue="{Binding KaraokeTextAlignment}" SelectedValuePath="Tag" Margin="0,8,0,0">
                            <ComboBoxItem Content="{DynamicResource L_Set_PosLeft}" Tag="Left"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_AlignCenter}" Tag="Center"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource L_SetKar_AnchorLabel}"
                                   Style="{StaticResource Label}" Margin="0,20,0,0"
                                   ToolTip="{DynamicResource L_SetKar_AnchorHint}"/>
                        <ComboBox SelectedValue="{Binding KaraokeContentAnchor}" SelectedValuePath="Tag" Margin="0,8,0,0">
                            <ComboBoxItem Content="{DynamicResource L_Set_PosBottom}" Tag="Bottom"/>
                            <ComboBoxItem Content="{DynamicResource L_Set_PosTop}" Tag="Top"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource L_SetKar_Width}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokeWidthSlider" Minimum="20" Maximum="100"
                                Value="{Binding KaraokeWidthPct, Mode=TwoWay}"
                                TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeWidthSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_Height}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokeHeightSlider" Minimum="0" Maximum="100"
                                Value="{Binding KaraokeHeightPct, Mode=TwoWay}"
                                TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeHeightSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_FontSize}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokeFontSizeSlider" Minimum="12" Maximum="64"
                                Value="{Binding KaraokeFontSize, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentM}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeFontSizeSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_Opacity}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokeOpacitySlider" Minimum="0.25" Maximum="1.0"
                                Value="{Binding KaraokeOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="0.05" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeOpacitySlider, Mode=OneWay, StringFormat=F2}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_BgOpacity}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokeBgOpacitySlider" Minimum="0" Maximum="1.0"
                                Value="{Binding KaraokeBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="0.05" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeBgOpacitySlider, Mode=OneWay, StringFormat=F2}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_MaxLines}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokeMaxLinesSlider" Minimum="1" Maximum="30"
                                Value="{Binding KaraokeMaxLines, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentN}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeMaxLinesSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_SlideMs}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokeSlideSlider" Minimum="100" Maximum="2000"
                                Value="{Binding KaraokeSlideDurationMs, Mode=TwoWay}"
                                TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeSlideSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_FadeMs}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokeFadeSlider" Minimum="100" Maximum="2000"
                                Value="{Binding KaraokeFadeDurationMs, Mode=TwoWay}"
                                TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeFadeSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_Padding}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokePaddingSlider" Minimum="0" Maximum="80"
                                Value="{Binding KaraokeInnerPadding, Mode=TwoWay}"
                                TickFrequency="4" IsSnapToTickEnabled="True" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentM}"/>
                            <Run Text="{Binding Value, ElementName=KaraokePaddingSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_Margin}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <Slider x:Name="KaraokeMarginSlider" Minimum="0" Maximum="200"
                                Value="{Binding KaraokeMarginPx, Mode=TwoWay}"
                                TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentM}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeMarginSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetKar_TextColor}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <TextBox Text="{Binding KaraokeTextColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                 FontFamily="{DynamicResource MonoFont}"/>

                        <TextBlock Text="{DynamicResource L_SetKar_MarkerColor}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <TextBox Text="{Binding KaraokeAccentColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                 FontFamily="{DynamicResource MonoFont}"/>

                        <TextBlock Text="{DynamicResource L_SetKar_FreshColor}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <TextBox Text="{Binding KaraokeFreshColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                 FontFamily="{DynamicResource MonoFont}"/>

                        <TextBlock Text="{DynamicResource L_KaraokeOldColor}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <TextBox Text="{Binding KaraokeOldLinesColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                 FontFamily="{DynamicResource MonoFont}"/>

                        <TextBlock Text="{DynamicResource L_KaraokeQuestionColor}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <TextBox Text="{Binding KaraokeQuestionColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                 FontFamily="{DynamicResource MonoFont}"/>

                        <TextBlock Text="{DynamicResource L_SetKar_BgColor}" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                        <TextBox Text="{Binding KaraokeBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                 FontFamily="{DynamicResource MonoFont}"/>

                        <CheckBox Content="{DynamicResource L_SetKar_ShowAi}"
                                  IsChecked="{Binding KaraokeShowAnswers}"
                                  Margin="0,20,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetKar_ShowQuestion}"
                                  IsChecked="{Binding KaraokeShowQuestions}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetKar_ShowMic}"
                                  IsChecked="{Binding KaraokeShowUserLines}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_KaraokeHistoryFade}"
                                  IsChecked="{Binding KaraokeHistoryFade}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="{DynamicResource L_KaraokeMinHistoryOpacity}" Style="{StaticResource Label}" Margin="0,12,0,0"/>
                        <Slider x:Name="KaraokeMinHistoryOpacitySlider" Minimum="0" Maximum="1.0"
                                Value="{Binding KaraokeMinHistoryOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding KaraokeHistoryFade}"
                                TickFrequency="0.05" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeMinHistoryOpacitySlider, Mode=OneWay, StringFormat=F2}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_KaraokeHistoryLineCount}" Style="{StaticResource Label}" Margin="0,12,0,0"/>
                        <Slider x:Name="KaraokeHistoryLineCountSlider" Minimum="1" Maximum="6"
                                Value="{Binding KaraokeHistoryLineCount, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,6"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}">
                            <Run Text="{DynamicResource L_Set_CurrentN}"/>
                            <Run Text="{Binding Value, ElementName=KaraokeHistoryLineCountSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <CheckBox Content="{DynamicResource L_SetKar_Gradient}"
                                  IsChecked="{Binding KaraokeAgeColorFade}"
                                  Margin="0,20,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetKar_Marker}"
                                  IsChecked="{Binding KaraokeShowMarker}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetKar_BgStrip}"
                                  IsChecked="{Binding KaraokeShowBackground}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetKar_TextShadow}"
                                  IsChecked="{Binding KaraokeTextShadow}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetKar_Wrap}"
                                  IsChecked="{Binding KaraokeWordWrap}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetKar_StealthCapture}"
                                  IsChecked="{Binding KaraokeHiddenFromCapture}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_SetKar_ClickThrough}"
                                  IsChecked="{Binding KaraokeClickThrough}"/>

                        <Button x:Name="KaraokePreviewButton"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnKaraokePreviewClick"
                                Width="160" HorizontalAlignment="Left" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{DynamicResource BuddySettings.Icon.Visibility.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource L_SetKar_Preview}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Горячие клавиши ====================== -->
            <TabItem Header="{DynamicResource L_Tab_Hotkeys}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Hotkeys}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource L_SetHK_ToggleOverlay}" Style="{StaticResource Label}" FontSize="14" LineHeight="20" Margin="0,0,0,6"/>
                        <TextBox x:Name="ToggleVisibilityHotkeyBox" Text="{Binding ToggleVisibilityHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>

                        <TextBlock Text="{DynamicResource L_SetHK_Opacity}" Style="{StaticResource Label}" FontSize="14" LineHeight="20" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ChangeOpacityHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>

                        <TextBlock Text="{DynamicResource L_SetHK_OpenSettings}" Style="{StaticResource Label}" FontSize="14" LineHeight="20" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding OpenSettingsHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>

                        <TextBlock Text="{DynamicResource L_SetHK_PauseAudio}" Style="{StaticResource Label}" FontSize="14" LineHeight="20" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding TogglePauseHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>

                        <TextBlock Text="{DynamicResource L_SetHK_Karaoke}" Style="{StaticResource Label}" FontSize="14" LineHeight="20" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ToggleKaraokeHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>

                        <TextBlock Text="{DynamicResource L_HK_ScreenOcr}" Style="{StaticResource Label}" FontSize="14" LineHeight="20" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ToggleScreenOcrHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>

                        <TextBlock Text="{DynamicResource L_HK_OcrNow}" Style="{StaticResource Label}" FontSize="14" LineHeight="20" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ScreenOcrRecognizeNowHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>
                        <TextBlock Text="{DynamicResource L_OcrAutoWatchHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDimBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>

                        <TextBlock Text="{DynamicResource L_HK_ShowTray}" Style="{StaticResource Label}" FontSize="14" LineHeight="20" Margin="0,0,0,6"/>
                        <TextBox x:Name="ShowTrayIconHotkeyBox" Text="{Binding ShowTrayIconHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>

                        <TextBlock Style="{StaticResource HelperText}" Margin="0,28,0,4"><Run Text="{DynamicResource L_Set_Version}" Foreground="{DynamicResource TextMutedBrush}"/><Run x:Name="VersionRun" Foreground="{DynamicResource TextBrightBrush}" FontFamily="{DynamicResource MonoFont}"/></TextBlock>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,8"><Run Text="{DynamicResource L_Set_Logs}" Foreground="{DynamicResource TextMutedBrush}"/><Run x:Name="LogPathRun" Text="" Foreground="{DynamicResource TextBrightBrush}" FontFamily="{DynamicResource MonoFont}"/></TextBlock>
                        <WrapPanel>
                            <Button x:Name="OpenLogsBtn" Margin="0,0,8,8" Click="OnOpenLogs">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource L_Set_OpenLogsFolder}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Style="{StaticResource HelperText}" Margin="0,16,0,0"
                                   Text="{DynamicResource L_SetHK_Modifiers}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Профиль ====================== -->
            <TabItem Header="{DynamicResource L_Tab_Profile}">
                <!-- Внешний ScrollViewer: при минимальном окне (460) два поля
                     (240+96 минимум) + заголовки не помещаются — страница
                     прокручивается (H07/C12). MinHeight=ViewportHeight держит
                     Grid в росте вьюпорта: в большом окне резюме по-прежнему
                     тянет свободную высоту, в малом — контент скроллится. -->
                <ScrollViewer x:Name="ProfileScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20" MinHeight="{Binding ViewportHeight, ElementName=ProfileScroll}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource L_SetPt_Profile}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource L_SetProf_SummaryLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="2" x:Name="ResumeSummaryBox" Text="{Binding UserProfileSummary, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultilineInputText}" MinHeight="240"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" Margin="0,2,0,8"/>
                    <WrapPanel Grid.Row="3" Margin="0,0,0,20">
                        <Button Content="{DynamicResource L_SetProf_Save}" Click="OnSaveProfile" Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButton}"/>
                        <TextBlock x:Name="ProfileFlash" Text="{DynamicResource L_Set_ProfileUpdated}"
                                   Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"
                                   TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="4" Text="{DynamicResource L_SetProf_AvoidLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="5" Text="{Binding UserProfileCannotDo, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultilineInputText}"
                             Margin="0,2,0,0" MinHeight="96" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Агенты ====================== -->
            <TabItem Header="{DynamicResource L_Tab_Agents}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Agents}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <CheckBox Content="{DynamicResource L_SetAg_Enable}" IsChecked="{Binding IsMultiAgentEnabled}" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource L_SetAg_Scenario}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ScenarioCombo" ItemsSource="{Binding Scenarios}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ActiveScenarioId}" Margin="0,2,0,20"/>
                        <ItemsControl ItemsSource="{Binding ActiveScenarioAgents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== MCP ====================== -->
            <TabItem x:Name="McpTab" Header="{DynamicResource L_Tab_Mcp}"
                     AutomationProperties.AutomationId="McpTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="{DynamicResource L_Mcp_Title}" Style="{StaticResource PageTitleText}"
                                   Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,20"/>

                        <CheckBox x:Name="McpEnabledCheck" Content="{DynamicResource L_Mcp_Enable}"
                                  IsChecked="{Binding McpEnabled}" Margin="0,0,0,16"/>

                        <!-- Две кнопки входа -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button x:Name="McpConnectAgentBtn" Content="{DynamicResource L_Mcp_ConnectAgent}"
                                    Style="{StaticResource PrimaryButton}" Padding="12,0" Height="36"
                                    Margin="0,0,12,0" AutomationProperties.AutomationId="McpConnectAgentBtn"/>
                            <Button x:Name="McpAddToolBtn" Content="{DynamicResource L_Mcp_AddTool}"
                                    Padding="12,0" Height="36"
                                    AutomationProperties.AutomationId="McpAddToolBtn"/>
                        </StackPanel>

                        <!-- Кто подключён к Buddy (входящие) -->
                        <TextBlock Text="{DynamicResource L_Mcp_InGroup}" Style="{StaticResource SectionTitleText}"
                                   Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="McpIncomingList" ItemsSource="{Binding McpIncomingConnections}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                           Foreground="{DynamicResource TextBrightBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource MetaText}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                                                    <Run Text="{DynamicResource L_Mcp_RightsLabel}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding RightsText}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource MetaText}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                                    <Run Text="{DynamicResource L_Mcp_ScopeLabel}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding ScopeSummary}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource MetaText}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                                    <Run Text="{DynamicResource L_Mcp_ChannelLabel}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding ChannelText}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource MetaText}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                                    <Run Text="{DynamicResource L_Mcp_TokenLabel}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding TokenText}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource MetaText}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                                    <Run Text="{DynamicResource L_Mcp_PathsLabel}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding PathsText}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{DynamicResource L_Mcp_Edit}" Padding="12,0" Height="36" Margin="0,0,8,0"
                                                        Click="OnMcpConnEdit" AutomationProperties.AutomationId="McpConnEditBtn"/>
                                                <Button Content="{DynamicResource L_Mcp_Revoke}" Padding="12,0" Height="36"
                                                        Click="OnMcpConnRevoke" AutomationProperties.AutomationId="McpConnRevokeBtn"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="McpIncomingEmpty" Text="{DynamicResource L_Mcp_EmptyAgents}"
                                   Style="{StaticResource MetaText}" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,16" Visibility="Collapsed"/>

                        <!-- Ожидающие разрешения OAuth-клиенты (облачное подключение).
                             Панель скрыта целиком, когда очереди нет. -->
                        <Border x:Name="McpPendingPanel" Style="{StaticResource CardBorder}"
                                Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Mcp_PendingTitle}"
                                           Style="{StaticResource LabelText}"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="McpPendingList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                                               Foreground="{DynamicResource TextBrightBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RedirectUri}" Style="{StaticResource MetaText}"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding RequestedText}" Style="{StaticResource MetaText}"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{DynamicResource L_Mcp_PendingAllow}" Tag="{Binding PendingId}"
                                                            Padding="12,0" Height="36" Margin="0,0,8,0" Click="OnMcpPendingAllow"/>
                                                    <Button Content="{DynamicResource L_Mcp_PendingDeny}" Tag="{Binding PendingId}"
                                                            Padding="12,0" Height="36" Click="OnMcpPendingDeny"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Чем пользуется чат (исходящие) -->
                        <TextBlock Text="{DynamicResource L_Mcp_OutGroup}" Style="{StaticResource SectionTitleText}"
                                   Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="McpOutgoingList" ItemsSource="{Binding McpOutgoingServers}" Margin="0,0,0,8"
                                      AutomationProperties.AutomationId="McpOutgoingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                               Foreground="{DynamicResource TextBrightBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MetaText}"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <!-- Правка подключения: URL/транспорт/токен. -->
                                                <Button Grid.Column="1" Content="{DynamicResource L_Mcp_Edit}" Tag="{Binding Id}"
                                                        Padding="12,0" Height="36" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Click="OnMcpOutEdit"
                                                        AutomationProperties.AutomationId="McpOutgoingEditBtn"/>
                                                <CheckBox Grid.Column="2" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                        Checked="OnMcpOutToggled" Unchecked="OnMcpOutToggled"/>
                                            </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="McpOutgoingEmpty" Text="{DynamicResource L_Mcp_EmptyTools}"
                                   Style="{StaticResource MetaText}" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,16" Visibility="Collapsed"/>

                        <!-- Незавершённые задачи -->
                        <TextBlock Text="{DynamicResource L_Mcp_PendingJobs}" Style="{StaticResource SectionTitleText}"
                                   Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="McpPendingJobsList" ItemsSource="{Binding McpPendingJobs}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource MetaText}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="McpJobsEmpty" Text="{DynamicResource L_Mcp_EmptyJobs}"
                                   Style="{StaticResource MetaText}" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,16" Visibility="Collapsed"/>

                        <!-- Облачный доступ -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="McpCloudStatusText" Style="{StaticResource BodyText}"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="McpCloudSetupBtn" Content="{DynamicResource L_Mcp_CloudSetup}"
                                        Padding="12,0" Height="36" Margin="0,12,0,0" HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="McpCloudSetupBtn"/>
                            </StackPanel>
                        </Border>

                        <!-- Проверка живости MCP: канал, токены, журнал, инструменты -->
                        <Border x:Name="McpCheckPanel" Style="{StaticResource CardBorder}" Margin="0,16,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Mcp_CheckTitle}" Style="{StaticResource LabelText}"
                                           Foreground="{DynamicResource TextBrightBrush}"/>
                                <TextBox x:Name="McpCheckReport" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         MaxHeight="260" Margin="0,8,0,0"
                                         FontFamily="Consolas" FontSize="12"
                                         Foreground="{DynamicResource TextBrush}"
                                         Background="{DynamicResource BgMediumBrush}"
                                         AutomationProperties.AutomationId="McpCheckReport"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="McpCheckBtn" Content="{DynamicResource L_Mcp_CheckBtn}"
                                    Style="{StaticResource PrimaryButton}" Padding="12,0" Height="36"
                                    Margin="0,0,12,0" Click="OnMcpCheck"
                                    AutomationProperties.AutomationId="McpCheckBtn"/>
                            <Button x:Name="McpCopyInstructionsBtn" Content="{DynamicResource L_Mcp_CopyInstructions}"
                                    Padding="12,0" Height="36" Margin="0,0,12,0"
                                    Click="OnMcpCopyInstructions"
                                    AutomationProperties.AutomationId="McpCopyInstructionsBtn"/>
                            <Button x:Name="McpJournalBtn" Content="{DynamicResource L_Mcp_JournalLink}"
                                    Padding="12,0" Height="36" HorizontalAlignment="Left"
                                    Click="OnMcpJournalOpen" AutomationProperties.AutomationId="McpJournalBtn"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Экран OCR ====================== -->
            <TabItem x:Name="ScreenOcrTab" Header="{DynamicResource L_Tab_ScreenOcr}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_ScreenOcr}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <CheckBox Content="{DynamicResource L_OcrEnabled}"
                                  IsChecked="{Binding ScreenOcrEnabled}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_OcrAutoWatch}"
                                  IsChecked="{Binding ScreenOcrAutoWatch}"
                                  IsEnabled="{Binding ScreenOcrEnabled}"
                                  Margin="16,0,0,2"/>
                        <TextBlock Text="{DynamicResource L_OcrAutoWatchHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDimBrush}" Style="{StaticResource HelperText}" Margin="16,0,0,8"/>

                        <CheckBox Content="{DynamicResource L_OcrShowIndicator}"
                                  IsChecked="{Binding ScreenOcrShowIndicator}"
                                  IsEnabled="{Binding ScreenOcrEnabled}"
                                  Margin="0,0,0,2"/>
                        <TextBlock Text="{DynamicResource L_OcrStatusLegend}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDimBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>

                        <TextBlock Text="{DynamicResource L_SetOcr_Monitor}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ScreenOcrMonitorCombo"
                                  SelectedValue="{Binding ScreenOcrMonitorIndex, Mode=TwoWay}"
                                  SelectedValuePath="Tag" Margin="0,2,0,8"/>

                        <TextBlock Text="{DynamicResource L_SetOcr_Engine}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ScreenOcrEngineCombo" SelectedValue="{Binding ScreenOcrEngine, Mode=TwoWay}"
                                  SelectedValuePath="Tag" Margin="0,2,0,6">
                            <ComboBoxItem Content="Tesseract" Tag="tesseract"/>
                            <ComboBoxItem Content="Windows OCR (WinRT)" Tag="windows"/>
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8"
                                   Text="{DynamicResource L_SetOcr_EngineHint}"/>

                        <TextBlock Text="{DynamicResource L_SetOcr_Interval}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Slider x:Name="ScreenOcrPollSlider" Minimum="0.5" Maximum="10"
                                Value="{Binding ScreenOcrPollIntervalSeconds, Mode=TwoWay}"
                                TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,2,0,4"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8">
                            <Run Text="{DynamicResource L_Set_CurrentM}"/>
                            <Run Text="{Binding Value, ElementName=ScreenOcrPollSlider, Mode=OneWay, StringFormat=F1}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                            <Run Text="{DynamicResource L_Set_UnitS}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetOcr_Threshold}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Slider x:Name="ScreenOcrThresholdSlider" Minimum="0.1" Maximum="0.95"
                                Value="{Binding ScreenOcrChangeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="0.05" Margin="0,2,0,4"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8">
                            <Run Text="{DynamicResource L_Set_CurrentM}"/>
                            <Run Text="{Binding Value, ElementName=ScreenOcrThresholdSlider, Mode=OneWay, StringFormat=F2}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetOcr_Pause}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Slider x:Name="ScreenOcrCooldownSlider" Minimum="0.3" Maximum="30"
                                Value="{Binding ScreenOcrCooldownSec, Mode=TwoWay}"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,2,0,4"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=ScreenOcrCooldownSlider, Mode=OneWay, StringFormat=F1}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                            <Run Text="{DynamicResource L_Set_UnitS}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource L_SetOcr_MinLen}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Slider x:Name="ScreenOcrMinLenSlider" Minimum="4" Maximum="64"
                                Value="{Binding ScreenOcrMinTextLength, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,4"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8">
                            <Run Text="{DynamicResource L_Set_CurrentF}"/>
                            <Run Text="{Binding Value, ElementName=ScreenOcrMinLenSlider, Mode=OneWay, StringFormat=F0}"
                                 Foreground="{DynamicResource TextBrightBrush}"/>
                            <Run Text="{DynamicResource L_Set_UnitChars}"/>
                        </TextBlock>

                        <CheckBox x:Name="ScreenOcrAutoAnswerCheck" Content="{DynamicResource L_SetOcr_AutoAnswer}"
                                  IsChecked="{Binding ScreenOcrAutoAnswer}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="{DynamicResource L_SetOcr_OnceLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button x:Name="ScreenOcrOnceBtn" MinWidth="180"
                                    Click="OnScreenOcrRecognizeNow" Margin="0,0,8,8"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource L_SetOcr_OnceBtn}"/>
                        </WrapPanel>
                        <TextBox x:Name="ScreenOcrPreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="140" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrightBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Style="{StaticResource HelperText}" Margin="0,16,0,0"
                                   Text="{DynamicResource L_SetOcr_HotkeyNote}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Диагностика ====================== -->
            <TabItem Header="{DynamicResource L_Tab_LlmLogs}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource L_SetPt_Diagnostics}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

                    <!-- Сбор логов для поддержки -->
                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L_SetLog_Title}" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,12"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                       Text="{DynamicResource L_SetLog_Desc}"/>
                            <WrapPanel>
                                <Button x:Name="CollectLogsBtn" Content="{DynamicResource L_SetLog_Collect}" Style="{StaticResource PrimaryButton}"
                                        Click="OnCollectSupportLogs" Margin="0,0,8,8"/>
                                <Button x:Name="OpenLogsFolderBtn" Margin="0,0,0,8" Click="OnOpenLogsFolder">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource L_SetLog_OpenFolder}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Настройки логирования -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <CheckBox Content="{DynamicResource L_SetLog_File}" IsChecked="{Binding EnableFileLogging}" Margin="0,0,0,8"
                                  ToolTip="{DynamicResource L_SetLog_FileHint}"/>
                        <CheckBox Content="{DynamicResource L_SetLog_Verbose}" IsChecked="{Binding VerboseLogging}" Margin="0,0,0,8"
                                  ToolTip="{DynamicResource L_SetLog_VerboseHint}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource L_SetLog_Rotation}" Style="{StaticResource LabelText}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Width="64" Height="36" Padding="8,8" Margin="8,0,0,0"
                                     Text="{Binding LogMaxFiles, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource L_SetLog_RotationHint}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- LLM-лог (сессионный). Двухпанельная строка: в узком окне
                         кнопки переносятся под заголовок, в широком — справа от него
                         (Grid-оверлей давал наложение заголовка и кнопок). -->
                    <b:TwoPanePanel Grid.Row="3" Margin="0,0,0,12" Breakpoint="560" Gap="8">
                        <TextBlock Text="{DynamicResource L_SetLog_SessionTitle}" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource TextBrightBrush}" VerticalAlignment="Center"/>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button x:Name="ClearLlmLogsBtn" Click="OnClearLlmLogs" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{DynamicResource BuddySettings.Icon.Delete.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource L_SetLog_Clear}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyLlmLogsBtn" Click="OnCopyLlmLogs">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{DynamicResource BuddySettings.Icon.Copy.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource L_SetLog_Copy}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </b:TwoPanePanel>
                    <TextBox Grid.Row="4" Text="{Binding LlmLogText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MonoInputText}"
                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrightBrush}"
                             VerticalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                </Grid>
            </TabItem>

            <!-- ====================== История ====================== -->
            <TabItem x:Name="HistoryTab" Header="{DynamicResource L_Tab_History}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource L_SetPt_History}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="{DynamicResource L_History_Explainer}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="HistoryStatsText" Style="{StaticResource HelperText}"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12">
                        <Grid>
                            <TextBlock x:Name="HistoryEmptyText" Text="{DynamicResource L_History_Empty}"
                                       Foreground="{DynamicResource TextDimBrush}" Style="{StaticResource MetaText}"
                                       Margin="10" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <!-- Extended: выбор нескольких встреч для пакетного удаления. -->
                            <ListBox x:Name="MeetingHistoryList" Background="Transparent" BorderThickness="0"
                                     MinHeight="220"
                                     SelectionMode="Extended"
                                     SelectionChanged="OnHistoryMeetingSelect" MouseDoubleClick="OnOpenMeetingHistory">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ListTitle}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
                                                <!-- Волна 08: selected = SelectedRowBrush — текст остаётся
                                                     светлым (основной TextBrightBrush, вторичный TextBrush). -->
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                         Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Бейдж прикреплённых файлов встречи: векторная скрепка
                                                 (GeoPaperclip из Icons*.xaml) + AttachmentCount из
                                                 AttachmentStore.CountByMeeting через RefreshMeetingList. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AttachmentCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Path Data="{DynamicResource GeoPaperclip}" Width="12" Height="12"
                                                      Stretch="Uniform" StrokeThickness="1.8" Margin="0,0,3,0"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextDimBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                             Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Text="{Binding AttachmentCount, Mode=OneWay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Margin="0,1,0,0"
                                                       Text="{Binding ListSubtitle, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                         Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="{DynamicResource L_History_Open}" Click="OnOpenMeetingHistory"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                        <Button Content="{DynamicResource L_Hist_SelectAll}" Margin="0,0,8,8"
                                Click="OnHistorySelectAll"/>
                        <Button x:Name="HistoryDeleteBtn"
                                IsEnabled="False" Margin="0,0,8,8" Click="OnDeleteSelectedMeeting">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{DynamicResource BuddySettings.Icon.Delete.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource L_Hist_DeleteSelected}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenMeetingsFolderBtn" Margin="0,0,8,8" Click="OnOpenMeetingsFolder">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource L_OpenFolder}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- ====================== Память (Buddy Memory) ====================== -->
            <TabItem x:Name="MemoryTab" Header="{DynamicResource L_Tab_Memory}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Memory}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource L_Mem_Explainer}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource L_Mem_WhenWritesHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDimBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,20"/>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="MemoryEnabledCheck" Content="{DynamicResource L_Mem_Enabled}"
                                          IsChecked="{Binding MemoryEnabled}"
                                          ToolTip="{DynamicResource L_Mem_EnabledHint}" Margin="0,0,0,8"/>
                                <CheckBox Content="{DynamicResource L_Mem_DefaultUse}"
                                          IsChecked="{Binding MemoryDefaultUse}"
                                          ToolTip="{DynamicResource L_Mem_DefaultUseHint}" Margin="0,0,0,8"/>
                                <CheckBox Content="{DynamicResource L_Mem_DefaultWrite}"
                                          IsChecked="{Binding MemoryDefaultWrite}"
                                          ToolTip="{DynamicResource L_Mem_DefaultWriteHint}" Margin="0,0,0,2"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Mem_SaveMode}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ComboBox SelectedValue="{Binding MemorySaveMode}" SelectedValuePath="Tag" Margin="0,2,0,8">
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Save_Off}" Tag="off"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Save_Summary}" Tag="summary"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Save_Smart}" Tag="smart"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Save_Full}" Tag="full"/>
                                </ComboBox>

                                <TextBlock Text="{DynamicResource L_Mem_ReviewMode}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ComboBox SelectedValue="{Binding MemoryReviewMode}" SelectedValuePath="Tag" Margin="0,2,0,8">
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Review_Auto}" Tag="automatic"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Review_Review}" Tag="review"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Review_Manual}" Tag="manual"/>
                                </ComboBox>

                                <TextBlock Text="{DynamicResource L_Mem_ModelMode}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="MemoryModelModeCombo" SelectedValue="{Binding MemoryModelMode}"
                                          SelectedValuePath="Tag" Margin="0,2,0,8"
                                          SelectionChanged="OnMemoryModelModeChanged">
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Model_Same}" Tag="same"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Model_Separate}" Tag="separate"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Model_Disabled}" Tag="disabled"/>
                                </ComboBox>

                                <StackPanel x:Name="MemorySeparatePanel" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource L_Mem_Provider}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="MemoryProviderCombo" Margin="0,2,0,8"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding MemoryProviderId}"
                                              SelectionChanged="OnMemoryProviderChanged"/>
                                    <TextBlock Text="{DynamicResource L_Mem_Model}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="MemoryModelCombo" IsEditable="True" IsTextSearchEnabled="False"
                                              Text="{Binding MemoryModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                                    <!-- Editable-combo без нативного placeholder'а — пояснение под ним -->
                                    <TextBlock Text="{DynamicResource L_Mem_ModelHint}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Mem_EmbeddingsMode}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="MemoryEmbeddingsModeCombo" SelectedValue="{Binding MemoryEmbeddingsMode}"
                                          SelectedValuePath="Tag" Margin="0,2,0,8"
                                          SelectionChanged="OnMemoryEmbeddingsModeChanged">
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Emb_Disabled}" Tag="disabled"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Emb_Local}" Tag="local"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Emb_OpenAi}" Tag="openai"/>
                                </ComboBox>
                                <StackPanel x:Name="MemoryEmbeddingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource L_Mem_Emb_Model}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding MemoryEmbeddingsModel, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,2,0,8" FontFamily="{DynamicResource MonoFont}"/>
                                </StackPanel>
                                <!-- Локальная E5: управление RAM/lifetime модели (спека memory2 §10-§21) -->
                                <StackPanel x:Name="MemoryLocalPanel" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource L_Mem_E5_Mode}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="MemoryE5ModeCombo"
                                              SelectedValue="{Binding MemoryLocalRuntimeMode}"
                                              SelectedValuePath="Tag" Margin="0,2,0,8"
                                              SelectionChanged="OnMemoryLocalRuntimeChanged">
                                        <ComboBoxItem Content="{DynamicResource L_Mem_E5_AlwaysLoaded}" Tag="alwaysloaded"/>
                                        <ComboBoxItem Content="{DynamicResource L_Mem_E5_Balanced}" Tag="balanced"/>
                                        <ComboBoxItem Content="{DynamicResource L_Mem_E5_MemorySaver}" Tag="memorysaver"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource L_Mem_E5_UnloadAfter}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="MemoryE5UnloadCombo"
                                              SelectedValue="{Binding MemoryLocalUnloadMinutes}"
                                              SelectedValuePath="Tag" Margin="0,2,0,8"
                                              SelectionChanged="OnMemoryLocalRuntimeChanged">
                                        <ComboBoxItem Content="{DynamicResource L_Mem_E5_Unload1}" Tag="1"/>
                                        <ComboBoxItem Content="{DynamicResource L_Mem_E5_Unload5}" Tag="5"/>
                                        <ComboBoxItem Content="{DynamicResource L_Mem_E5_Unload10}" Tag="10"/>
                                        <ComboBoxItem Content="{DynamicResource L_Mem_E5_Unload30}" Tag="30"/>
                                        <ComboBoxItem Content="{DynamicResource L_Mem_E5_Unload60}" Tag="60"/>
                                    </ComboBox>
                                    <TextBlock x:Name="MemoryE5StatusText" Margin="0,0,0,8" Style="{StaticResource HelperText}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>
                                    <WrapPanel>
                                        <Button x:Name="MemoryE5DownloadBtn" Content="{DynamicResource L_Mem_E5_Download}"
                                                Click="OnMemoryE5Download" Margin="0,0,8,8"/>
                                        <Button x:Name="MemoryE5CheckBtn"
                                                Click="OnMemoryE5Check" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{DynamicResource BuddySettings.Icon.Refresh.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource L_Mem_E5_Check}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="MemoryE5UnloadBtn"
                                                Click="OnMemoryE5Unload" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{DynamicResource BuddySettings.Icon.Remove.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource L_Mem_E5_Unload}"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource L_Mem_AutoRecall}"
                                          IsChecked="{Binding MemoryAutoRecall}"
                                          ToolTip="{DynamicResource L_Mem_AutoRecallHint}" Margin="0,0,0,8"/>

                                <TextBlock Text="{DynamicResource L_Mem_AutoBudget}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <Slider x:Name="MemoryAutoBudgetSlider" Minimum="2000" Maximum="16000"
                                        Value="{Binding MemoryAutoRecallBudget, Mode=TwoWay}"
                                        TickFrequency="500" IsSnapToTickEnabled="True" Margin="0,2,0,4"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,4">
                                    <Run Text="{DynamicResource L_Mem_Current}"/>
                                    <Run Text="{Binding Value, ElementName=MemoryAutoBudgetSlider, Mode=OneWay, StringFormat=F0}"
                                         Foreground="{DynamicResource TextBrightBrush}"/>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource L_Mem_AutoBudgetHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource L_Mem_ExtraSearchBudget}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <Slider x:Name="MemoryExtraBudgetSlider" Minimum="4000" Maximum="64000"
                                        Value="{Binding MemoryExtraSearchBudget, Mode=TwoWay}"
                                        TickFrequency="2000" IsSnapToTickEnabled="True" Margin="0,2,0,4"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,4">
                                    <Run Text="{DynamicResource L_Mem_Current}"/>
                                    <Run Text="{Binding Value, ElementName=MemoryExtraBudgetSlider, Mode=OneWay, StringFormat=F0}"
                                         Foreground="{DynamicResource TextBrightBrush}"/>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource L_Mem_ExtraSearchBudgetHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="MemoryBuiltinToolsCheck" Content="{DynamicResource L_Mem_BuiltinTools}"
                                          IsChecked="{Binding MemoryBuiltinSearchTools}"
                                          ToolTip="{DynamicResource L_Mem_BuiltinToolsHint}" Margin="0,0,0,6"/>
                                <TextBlock Text="{DynamicResource L_Mem_BuiltinToolsHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource L_Mem_RecallMaxItems}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <Slider x:Name="MemoryRecallItemsSlider" Minimum="1" Maximum="51"
                                        Value="{Binding MemoryRecallMaxItemsUi, Mode=TwoWay}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,4"
                                        ToolTip="{DynamicResource L_Mem_RecallMaxItemsAllHint}"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,4">
                                    <Run Text="{DynamicResource L_Mem_Current}"/>
                                    <Run Text="{Binding MemoryRecallMaxItemsText, Mode=OneWay}"
                                         Foreground="{DynamicResource TextBrightBrush}"/>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource L_Mem_RecallMaxItemsHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,2"/>

                                <!-- §6.4: интенсивность извлечения фактов (low/medium/high). -->
                                <TextBlock Text="{DynamicResource L_Mem_ExtractIntensity}" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                                <ComboBox x:Name="MemoryIntensityCombo" SelectedIndex="{Binding MemoryExtractionIntensityIndex}"
                                          HorizontalAlignment="Left" MinWidth="200" Margin="0,0,0,6"
                                          ToolTip="{DynamicResource L_Mem_ExtractIntensityHint}">
                                    <ComboBoxItem Content="{DynamicResource L_Mem_IntensityLow}"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_IntensityMedium}"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_IntensityHigh}"/>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource L_Mem_ExtractIntensityHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,2"/>
                                <!-- R5: пользовательский лимит извлечения фактов из одного документа -->
                                <TextBlock Text="{DynamicResource L_Att_FactExtractMaxChars}" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                                <Slider x:Name="FactExtractMaxCharsSlider" Minimum="10000" Maximum="5000000"
                                        Value="{Binding FactExtractMaxChars, Mode=TwoWay}"
                                        TickFrequency="10000" IsSnapToTickEnabled="True" Margin="0,2,0,4"
                                        ToolTip="{DynamicResource L_Att_FactExtractMaxCharsHint}"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,4">
                                    <Run Text="{DynamicResource L_Mem_Current}"/>
                                    <Run Text="{Binding FactExtractMaxCharsText, Mode=OneWay}"
                                         Foreground="{DynamicResource TextBrightBrush}"/>
                                    <Run Text="{DynamicResource L_Att_CharsSuffix}"/>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource L_Att_FactExtractMaxCharsHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,2"/>
                            </StackPanel>
                        </Border>

                        <!-- 2.33.0: поиск по журналам прошлых встреч — вкл/выкл и таймаут.
                             Таймаут ограничен, чтобы ответ не ждал неразумно долго. -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource L_Mem_MeetingSearch}"
                                          IsChecked="{Binding MeetingSearchEnabled}"
                                          ToolTip="{DynamicResource L_Mem_MeetingSearchHint}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource L_Mem_MeetingSearchHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,10"/>
                                <TextBlock Text="{DynamicResource L_Mem_MeetingSearchTimeout}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <Slider x:Name="MeetingSearchTimeoutSlider" Minimum="500" Maximum="10000"
                                        Value="{Binding MeetingSearchTimeoutMs, Mode=TwoWay}"
                                        TickFrequency="250" IsSnapToTickEnabled="True" Margin="0,2,0,4"
                                        IsEnabled="{Binding MeetingSearchEnabled}"
                                        ToolTip="{DynamicResource L_Mem_MeetingSearchTimeoutHint}"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,4">
                                    <Run Text="{DynamicResource L_Mem_Current}"/>
                                    <Run Text="{Binding MeetingSearchTimeoutMsText, Mode=OneWay}"
                                         Foreground="{DynamicResource TextBrightBrush}"/>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource L_Mem_MeetingSearchTimeoutHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,2"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Mem_TranscriptRetention}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ComboBox SelectedValue="{Binding MemoryTranscriptRetention}" SelectedValuePath="Tag" Margin="0,2,0,8">
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Ret_Never}" Tag="never"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Ret_7d}" Tag="days7"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Ret_30d}" Tag="days30"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Ret_90d}" Tag="days90"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Ret_Forever}" Tag="forever"/>
                                </ComboBox>

                                <TextBlock Text="{DynamicResource L_Mem_Retention}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="MemoryRetentionCombo" SelectedValue="{Binding MemoryRetention}"
                                          SelectedValuePath="Tag" Margin="0,2,0,8"
                                          SelectionChanged="OnMemoryRetentionChanged">
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Ret_Forever}" Tag="forever"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Ret_30d}" Tag="days30"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Ret_90d}" Tag="days90"/>
                                    <ComboBoxItem Content="{DynamicResource L_Mem_Ret_Custom}" Tag="custom"/>
                                </ComboBox>
                                <StackPanel x:Name="MemoryRetentionDaysPanel" Visibility="Collapsed" Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource L_Mem_RetentionDays}" Style="{StaticResource LabelText}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBox Width="60" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                             Text="{Binding MemoryRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource L_Mem_RetentionDaysHint}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Mem_Project}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="MemoryProjectCombo"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="OnMemoryProjectChanged"/>
                                    <Button x:Name="MemoryProjectAddBtn" Grid.Column="1" Style="{StaticResource SettingsIconButton}" Margin="8,0,0,0"
                                            Click="OnMemoryProjectAdd"
                                            ToolTip="{DynamicResource L_Mem_ProjectAddHint}">
                                        <Image Source="{DynamicResource BuddySettings.Icon.Add.Default}" Width="20" Height="20"/>
                                    </Button>
                                    <Button x:Name="MemoryProjectEditBtn" Grid.Column="2" Style="{StaticResource SettingsIconButton}" Margin="8,0,0,0"
                                            Click="OnMemoryProjectEdit"
                                            ToolTip="{DynamicResource L_Mem_ProjectEditHint}">
                                        <Image Source="{DynamicResource BuddySettings.Icon.Edit.Default}" Width="20" Height="20"/>
                                    </Button>
                                    <Button x:Name="MemoryProjectDeleteBtn" Grid.Column="3" Style="{StaticResource SettingsIconButton}" Margin="8,0,0,0"
                                            Click="OnMemoryProjectDelete"
                                            ToolTip="{DynamicResource L_Mem_ProjectDeleteHint}">
                                        <Image Source="{DynamicResource BuddySettings.Icon.Delete.Default}" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="MemoryNoStoreText" Text="{DynamicResource L_Mem_NoStore}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"
                                           Style="{StaticResource HelperText}" Margin="0,0,0,6" Visibility="Collapsed"/>
                                <TextBlock x:Name="MemoryStatsText" Style="{StaticResource HelperText}"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Content="{DynamicResource L_Mem_CenterBtn}"
                                            Click="OnOpenMemoryCenter" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Резервная копия и перенос ====================== -->
            <TabItem x:Name="BackupTab" Header="{DynamicResource L_Tab_Backup}"
                     AutomationProperties.AutomationId="BackupTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- BackupSection: якорь поиска настроек (индексируется только сама карточка,
                         парольные поля в поиск не попадают). -->
                    <StackPanel x:Name="BackupSection" Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_Backup}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Bak_CreateTitle}" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource L_Bak_CreateDesc}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource L_Bak_Password}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <PasswordBox x:Name="BackupPasswordBox" Margin="0,0,0,8"
                                             AutomationProperties.AutomationId="BackupPasswordBox"/>
                                <TextBlock Text="{DynamicResource L_Bak_PasswordConfirm}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <PasswordBox x:Name="BackupPasswordConfirmBox" Margin="0,0,0,8"
                                             AutomationProperties.AutomationId="BackupPasswordConfirmBox"/>
                                <TextBlock Text="{DynamicResource L_Bak_PasswordNote}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="BackupExcludeModelsCheck" IsChecked="True" Margin="0,0,0,8"
                                          AutomationProperties.AutomationId="BackupExcludeModelsCheck"
                                          Content="{DynamicResource L_Bak_ExcludeModels}"
                                          ToolTip="{DynamicResource L_Bak_ExcludeModelsHint}"/>
                                <CheckBox x:Name="BackupIncludeLogsCheck" IsChecked="False" Margin="0,0,0,12"
                                          AutomationProperties.AutomationId="BackupIncludeLogsCheck"
                                          Content="{DynamicResource L_Bak_IncludeLogs}"/>
                                <WrapPanel>
                                    <Button x:Name="BackupCreateBtn" Style="{StaticResource PrimaryButton}"
                                            AutomationProperties.AutomationId="BackupCreateBtn"
                                            Click="OnCreateBackup" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{DynamicResource BuddySettings.Icon.Add.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource L_Bak_CreateBtn}"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L_Bak_RestoreTitle}" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource L_Bak_RestoreDesc}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource L_Bak_PasswordRestore}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <PasswordBox x:Name="BackupRestorePasswordBox" Margin="0,0,0,12"
                                             AutomationProperties.AutomationId="BackupRestorePasswordBox"/>
                                <WrapPanel>
                                    <Button x:Name="BackupValidateBtn" AutomationProperties.AutomationId="BackupValidateBtn"
                                            Click="OnValidateBackup" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{DynamicResource BuddySettings.Icon.Refresh.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource L_Bak_ValidateBtn}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BackupRestoreBtn" AutomationProperties.AutomationId="BackupRestoreBtn"
                                            Click="OnRestoreBackup" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource L_Bak_RestoreBtn}"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="BackupProgressRow" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="BackupProgressBar" Minimum="0" Maximum="1" Height="8"
                                         VerticalAlignment="Center"/>
                            <Button x:Name="BackupCancelBtn" Grid.Column="1" Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="BackupCancelBtn"
                                    Click="OnBackupCancel" Content="{DynamicResource L_Bak_Cancel}"/>
                        </Grid>
                        <TextBlock x:Name="BackupStageText" Foreground="{DynamicResource TextMutedBrush}"
                                   AutomationProperties.AutomationId="BackupStageText"
                                   Style="{StaticResource HelperText}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BackupStatusText" Foreground="{DynamicResource TextMutedBrush}"
                                   AutomationProperties.AutomationId="BackupStatusText"
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== О приложении ====================== -->
            <TabItem Header="{DynamicResource L_Tab_About}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{DynamicResource L_SetPt_About}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>
                        <TextBlock x:Name="TitleVersionRun" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" LineHeight="30" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource L_SetAbout_Desc}" Margin="0,0,0,20" Foreground="{DynamicResource TextMutedBrush}"
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,8,8"><Run Text="{DynamicResource L_Set_AboutAuthor}" Foreground="{DynamicResource TextMutedBrush}"/><Run Text=" liveinno" Foreground="{DynamicResource AccentBrush}" FontWeight="Medium"/></TextBlock>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"><Run Text="{DynamicResource L_About_Site}" Foreground="{DynamicResource TextMutedBrush}"/><Hyperlink NavigateUri="https://aigens.ru" RequestNavigate="OnSiteLinkNavigate" Foreground="{DynamicResource AccentBrush}" FontWeight="Medium">https://aigens.ru</Hyperlink></TextBlock>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="20,12">
            <b:TwoPanePanel Breakpoint="560" Gap="8">
                <Button Content="{DynamicResource L_Set_OnboardingBtn}" Click="OnShowOnboarding"
                        Margin="0"
                        HorizontalAlignment="Left"
                        ToolTip="{DynamicResource L_Set_OnboardingHint}"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="OpenConfigFolderBtn" Margin="0,0,8,8" Click="OnOpenConfigFolder">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{DynamicResource BuddySettings.Icon.BrowseFolder.Default}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource L_OpenFolder}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveBtn" Content="{DynamicResource L_Save}" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="0,0,8,8" Click="OnSave"/>
                    <!-- Локальный статус сохранения: «Сохранено» — 3 с; ошибка — персистентна. -->
                    <TextBlock x:Name="SaveFlash" Text="{DynamicResource L_Set_SavedFlash}"
                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"
                               TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <Button Content="{DynamicResource L_CloseBtn}" MinWidth="90" Margin="0,0,0,8" Click="OnClose"/>
                </WrapPanel>
            </b:TwoPanePanel>
        </Border>
    </Grid>
</Window>
